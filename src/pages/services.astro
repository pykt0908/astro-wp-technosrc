---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    title: 'Headless CMS & Static Site Generation',
    desc: 'ผสาน WordPress Backend เข้ากับ Astro Frontend ส่งมอบเว็บไซต์องค์กรที่โหลดเร็วระดับสายฟ้า ปลอดภัยจากแฮกเกอร์ 100% และไม่ต้องใช้ Node.js บน Production Server',
    features: ['Build อัตโนมัติผ่าน GitHub Actions', 'Static HTML/CSS/JS สำหรับ Shared Hosting', 'SEO Optimization & Sitemap อัตโนมัติ', 'Sanitized WordPress Content'],
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  },
  {
    title: 'Custom Web Application Development',
    desc: 'พัฒนาเว็บแอปพลิเคชันตามความต้องการเฉพาะทางของธุรกิจด้วยสถาปัตยกรรมที่ยืดหยุ่น รองรับการเชื่อมต่อกับระบบ ERP, CRM หรือฐานข้อมูลภายในองค์กร',
    features: ['TypeScript Strict & Clean Code', 'Responsive UI & Modern Aesthetics', 'API Architecture & Microservices', 'High Test Coverage & CI/CD'],
    icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  },
  {
    title: 'Cloud & DevOps Infrastructure',
    desc: 'ออกแบบและติดตั้งระบบคลาวด์ Pipeline การส่งมอบงานอัตโนมัติ (CI/CD) และการรักษาความปลอดภัยของระบบโครงสร้างพื้นฐาน',
    features: ['Zero Trust Security Architecture', 'SFTP / FTPS Atomic Deployment', 'Webhook Relays & Debouncing', 'Performance Monitoring & Caching'],
    icon: 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z',
  },
];
---

<BaseLayout
  title="บริการของเรา"
  description="บริการพัฒนาเว็บไซต์ Astro Headless WordPress, Web Application และสถาปัตยกรรมคลาวด์ครบวงจร"
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-semibold text-sky-400 tracking-wider uppercase">บริการของเรา</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-3 tracking-tight">
        โซลูชันเทคโนโลยีที่สร้างมาเพื่อผลลัพธ์ที่แท้จริง
      </h1>
      <p class="mt-4 text-lg text-slate-300">
        เราตอบโจทย์ทุกมิติของงานไอที ตั้งแต่การพัฒนาซอฟต์แวร์ สถาปัตยกรรมคลาวด์ จนถึงระบบจัดการเนื้อหาประสิทธิภาพสูง
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((srv) => (
        <div class="glass-panel p-8 rounded-2xl border border-slate-800 flex flex-col justify-between hover:border-sky-500/30 transition-all duration-300">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-sky-500/20 to-indigo-500/20 text-sky-400 flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={srv.icon} />
              </svg>
            </div>
            <h2 class="text-xl font-bold text-white mb-3">{srv.title}</h2>
            <p class="text-sm text-slate-400 leading-relaxed mb-6">{srv.desc}</p>
            <ul class="space-y-2.5 text-xs text-slate-300">
              {srv.features.map((feat) => (
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-sky-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="mt-8 pt-6 border-t border-slate-800/80">
            <a
              href="/contact/"
              class="inline-flex items-center gap-2 text-sm font-semibold text-sky-400 hover:text-sky-300 transition-colors"
            >
              <span>ปรึกษาโครงการนี้</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
