---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ติดต่อเรา"
  description="ติดต่อทีมงาน Technosrc เพื่อปรึกษาโครงการ พัฒนาเว็บไซต์ หรือโซลูชันระบบไอทีสำหรับองค์กร"
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-semibold text-sky-400 tracking-wider uppercase">ติดต่อเรา</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-3 tracking-tight">
        เริ่มต้นพูดคุยกับทีมผู้เชี่ยวชาญ
      </h1>
      <p class="mt-4 text-lg text-slate-300">
        ไม่ว่าคุณจะมีโจทย์โครงการใหม่ หรือต้องการยกระดับระบบเดิม เราพร้อมให้คำปรึกษาและออกแบบแนวทางที่เหมาะสมที่สุด
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div class="glass-panel p-8 rounded-2xl border border-slate-800 space-y-6">
          <h2 class="text-xl font-bold text-white">ช่องทางการติดต่อ</h2>

          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-sky-500/10 text-sky-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-medium text-slate-400 uppercase">อีเมล</p>
              <p class="text-base font-semibold text-white mt-0.5">contact@technosrc.com</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-indigo-500/10 text-indigo-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-medium text-slate-400 uppercase">โทรศัพท์</p>
              <p class="text-base font-semibold text-white mt-0.5">02-123-4567 (จันทร์ - ศุกร์ 09:00 - 18:00 น.)</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-emerald-500/10 text-emerald-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-medium text-slate-400 uppercase">ที่อยู่สำนักงาน</p>
              <p class="text-base font-semibold text-white mt-0.5">กรุงเทพมหานคร, ประเทศไทย</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="glass-panel p-8 sm:p-10 rounded-2xl border border-slate-800">
        <h2 class="text-xl font-bold text-white mb-6">ส่งข้อความถึงเรา</h2>
        <form id="contact-form" class="space-y-4">
          <div>
            <label for="name" class="block text-xs font-medium text-slate-300 uppercase mb-1">ชื่อ - นามสกุล *</label>
            <input
              type="text"
              id="name"
              required
              class="w-full px-4 py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-400 text-sm"
              placeholder="คุณสมชาย ใจดี"
            />
          </div>
          <div>
            <label for="email" class="block text-xs font-medium text-slate-300 uppercase mb-1">อีเมลติดต่อ *</label>
            <input
              type="email"
              id="email"
              required
              class="w-full px-4 py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-400 text-sm"
              placeholder="somchai@example.com"
            />
          </div>
          <div>
            <label for="subject" class="block text-xs font-medium text-slate-300 uppercase mb-1">หัวข้อที่สนใจ</label>
            <select
              id="subject"
              class="w-full px-4 py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-white focus:outline-none focus:ring-2 focus:ring-sky-400 text-sm"
            >
              <option value="headless-wordpress">Astro + Headless WordPress</option>
              <option value="custom-app">Custom Web Application</option>
              <option value="cloud-consulting">Cloud & DevOps Consulting</option>
              <option value="other">อื่น ๆ</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-xs font-medium text-slate-300 uppercase mb-1">รายละเอียดข้อความ *</label>
            <textarea
              id="message"
              rows="4"
              required
              class="w-full px-4 py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-400 text-sm resize-none"
              placeholder="ระบุความต้องการหรือข้อมูลเบื้องต้นเกี่ยวกับโครงการ..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full py-3 px-6 text-sm font-semibold text-white bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 rounded-lg shadow-lg shadow-sky-500/25 transition-all duration-200 hover:shadow-sky-500/40"
          >
            ส่งข้อความ
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('ขอบคุณสำหรับข้อความ ทีมงานจะติดต่อกลับโดยเร็วที่สุด');
      contactForm.reset();
    });
  }
</script>
