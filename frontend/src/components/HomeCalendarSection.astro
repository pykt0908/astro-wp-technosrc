---
// HomeCalendarSection.astro - College Event & Academic Calendar Section
import type { CollegeEvent, CollegeEventCategory } from '../types/wordpress';

interface Props {
  events?: CollegeEvent[];
  categories?: CollegeEventCategory[];
}

const { events = [], categories = [] } = Astro.props;

// Month names in Thai
const THAI_MONTHS_FULL = [
  'มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
  'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'
];

const THAI_MONTHS_SHORT = [
  'ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.',
  'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'
];

// Helper to format date display in Thai
function getThaiDateParts(startDateStr: string, endDateStr?: string) {
  if (!startDateStr) {
    return { dayText: '-', monthText: '-', yearText: '-' };
  }

  const sParts = startDateStr.split('-');
  const sYear = parseInt(sParts[0], 10);
  const sMonth = parseInt(sParts[1], 10) - 1;
  const sDay = parseInt(sParts[2], 10);

  const thaiYear = sYear + 543;
  const monthShort = THAI_MONTHS_SHORT[sMonth] || '';

  if (endDateStr && endDateStr !== startDateStr) {
    const eParts = endDateStr.split('-');
    const eMonth = parseInt(eParts[1], 10) - 1;
    const eDay = parseInt(eParts[2], 10);

    if (sMonth === eMonth) {
      return {
        dayText: `${sDay} - ${eDay}`,
        monthText: monthShort,
        yearText: `${thaiYear}`,
      };
    } else {
      const eMonthShort = THAI_MONTHS_SHORT[eMonth] || '';
      return {
        dayText: `${sDay} ${monthShort} - ${eDay} ${eMonthShort}`,
        monthText: '',
        yearText: `${thaiYear}`,
      };
    }
  }

  return {
    dayText: `${sDay}`,
    monthText: monthShort,
    yearText: `${thaiYear}`,
  };
}

// Color badges configuration
const COLOR_CONFIG: Record<string, { bg: string; text: string; border: string; dot: string; bar: string }> = {
  blue: {
    bg: 'bg-blue-50',
    text: 'text-blue-700',
    border: 'border-blue-200/70',
    dot: 'bg-blue-600',
    bar: 'bg-blue-600',
  },
  emerald: {
    bg: 'bg-emerald-50',
    text: 'text-emerald-700',
    border: 'border-emerald-200/70',
    dot: 'bg-emerald-600',
    bar: 'bg-emerald-600',
  },
  amber: {
    bg: 'bg-amber-50',
    text: 'text-amber-800',
    border: 'border-amber-200/70',
    dot: 'bg-amber-500',
    bar: 'bg-amber-500',
  },
  rose: {
    bg: 'bg-rose-50',
    text: 'text-rose-700',
    border: 'border-rose-200/70',
    dot: 'bg-rose-600',
    bar: 'bg-rose-600',
  },
  purple: {
    bg: 'bg-purple-50',
    text: 'text-purple-700',
    border: 'border-purple-200/70',
    dot: 'bg-purple-600',
    bar: 'bg-purple-600',
  },
};

// Clean categories
const displayCategories = categories.length > 0 ? categories : [
  { id: 7, name: 'กำหนดการศึกษา', slug: 'academic-schedule' },
  { id: 8, name: 'กิจกรรมนักศึกษา', slug: 'student-activities' },
  { id: 9, name: 'วิชาการและอบรม', slug: 'academic-training' },
  { id: 10, name: 'วันสำคัญและวันหยุด', slug: 'holidays' },
];

// Serialize events for client-side calendar filtering
const serializedEvents = events.map((ev) => {
  const parts = getThaiDateParts(ev.startDate, ev.endDate);
  const colorKey = ev.color && COLOR_CONFIG[ev.color] ? ev.color : 'blue';
  return {
    id: ev.id,
    title: ev.title,
    slug: ev.slug,
    content: ev.content,
    excerpt: ev.excerpt,
    startDate: ev.startDate,
    endDate: ev.endDate,
    time: ev.time,
    location: ev.location,
    organizer: ev.organizer,
    link: ev.link,
    attachmentUrl: ev.attachmentUrl,
    color: colorKey,
    isFeatured: ev.isFeatured,
    thumbnail: ev.thumbnail,
    categories: ev.categories || [],
    categorySlugs: (ev.categories || []).map((c) => c.slug),
    dateParts: parts,
  };
});
---

<section id="college-calendar-section" class="py-6 sm:py-8 bg-white border-t border-slate-200/80 select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with title & action -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 sm:mb-5">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2.5">
          ปฏิทินกิจกรรมวิทยาลัย
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm mt-0.5 max-w-2xl">
          ติดตามกำหนดการสำคัญ วันเปิด-ปิดภาคเรียน การสอบวัดผล และกิจกรรมส่งเสริมการเรียนรู้
        </p>
      </div>

      <!-- Action: PDF Download Button -->
      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/academic-calendar-2569.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-slate-900 hover:bg-blue-600 text-white text-xs font-semibold shadow-xs hover:shadow-sm transition-all duration-200 group"
        >
          <svg class="w-3.5 h-3.5 text-blue-300 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>ปฏิทินการศึกษา (PDF)</span>
        </a>
      </div>
    </div>

    <!-- Category Filter Chips -->
    <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 mb-4 sm:mb-5" id="calendar-category-filter">
      <button
        type="button"
        class="calendar-category-btn active px-3 py-1 rounded-full text-xs font-medium transition-all duration-200 cursor-pointer focus:outline-none"
        data-cat-slug="all"
      >
        ทั้งหมด
      </button>

      {displayCategories.map((cat) => (
        <button
          type="button"
          class="calendar-category-btn px-3 py-1 rounded-full text-xs font-medium transition-all duration-200 cursor-pointer focus:outline-none"
          data-cat-slug={cat.slug}
        >
          {cat.name}
        </button>
      ))}

      <!-- Reset Filter indicator if date selected -->
      <button
        type="button"
        id="calendar-reset-date-btn"
        class="hidden items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100 transition-colors cursor-pointer"
      >
        <span id="calendar-selected-date-label">กรองตามวันที่</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- 2-Column Bento Layout: Left = Interactive Calendar, Right = Events Timeline -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6 items-start">
      
      <!-- Left Column: Mini Month Calendar Widget -->
      <div class="lg:col-span-5 xl:col-span-4 flex flex-col gap-4">
        
        <!-- Interactive Month Calendar Card -->
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-2xs p-4 sm:p-4.5">
          
          <!-- Month & Year Selector -->
          <div class="flex items-center justify-between mb-3 pb-2.5 border-b border-slate-100">
            <div>
              <h3 id="cal-month-title" class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-1.5">
                ตุลาคม 2569
              </h3>
              <p class="text-[10px] text-slate-400 font-medium">กดวันที่เพื่อดูกิจกรรม</p>
            </div>
            
            <div class="flex items-center gap-1">
              <button
                type="button"
                id="cal-prev-month"
                class="w-7 h-7 rounded-lg flex items-center justify-center text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors focus:outline-none"
                aria-label="เดือนก่อนหน้า"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
              </button>

              <button
                type="button"
                id="cal-today-btn"
                class="px-2 py-0.5 text-[10px] font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 rounded transition-colors"
              >
                วันนี้
              </button>

              <button
                type="button"
                id="cal-next-month"
                class="w-7 h-7 rounded-lg flex items-center justify-center text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors focus:outline-none"
                aria-label="เดือนถัดไป"
              >
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Weekday Headers -->
          <div class="grid grid-cols-7 gap-1 text-center mb-1.5">
            <span class="text-[10px] font-bold text-rose-500">อา.</span>
            <span class="text-[10px] font-bold text-slate-400">จ.</span>
            <span class="text-[10px] font-bold text-slate-400">อ.</span>
            <span class="text-[10px] font-bold text-slate-400">พ.</span>
            <span class="text-[10px] font-bold text-slate-400">พฤ.</span>
            <span class="text-[10px] font-bold text-slate-400">ศ.</span>
            <span class="text-[10px] font-bold text-blue-500">ส.</span>
          </div>

          <!-- Calendar Days Grid (Populated dynamically) -->
          <div id="cal-days-grid" class="grid grid-cols-7 gap-1 text-center min-h-[190px]">
            <!-- Dynamic days will be injected via JS -->
          </div>

          <!-- Color Legend -->
          <div class="mt-3 pt-2.5 border-t border-slate-100 flex flex-wrap items-center gap-x-3 gap-y-1 text-[10px] text-slate-500 font-medium">
            <span class="flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span> กิจกรรมนักศึกษา
            </span>
            <span class="flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> กำหนดการศึกษา
            </span>
            <span class="flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-600"></span> วิชาการ/อบรม
            </span>
            <span class="flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> วันหยุด/สำคัญ
            </span>
          </div>
        </div>

      </div>

      <!-- Right Column: Events List / Timeline -->
      <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-2">

        <!-- Empty state when no events match category or date -->
        <div
          id="calendar-empty-state"
          class="hidden py-10 px-4 text-center bg-slate-50/80 rounded-xl border border-dashed border-slate-300"
        >
          <div class="w-10 h-10 mx-auto rounded-full bg-slate-200/70 flex items-center justify-center text-slate-400 mb-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xs font-bold text-slate-800">ไม่มีกิจกรรมในช่วงเวลานี้</h3>
          <p class="text-[11px] text-slate-500 mt-0.5">
            สามารถกดดูวันที่อื่นๆ หรือกดปุ่มด้านล่างเพื่อแสดงทั้งหมด
          </p>
          <button
            type="button"
            id="cal-empty-reset-btn"
            class="mt-3 px-3.5 py-1 rounded-full text-xs font-semibold bg-blue-600 text-white hover:bg-blue-700 transition-colors cursor-pointer"
          >
            แสดงกิจกรรมทั้งหมด
          </button>
        </div>

        <!-- Events Cards Container (Compact & Scrollable to match left height) -->
        <div id="calendar-events-list" class="flex flex-col gap-2 max-h-[380px] sm:max-h-[395px] overflow-y-auto pr-1 custom-calendar-scroll">
          {serializedEvents.map((ev) => {
            const conf = COLOR_CONFIG[ev.color] || COLOR_CONFIG.blue;
            return (
              <article
                class="calendar-event-card bg-white rounded-xl border border-slate-200/80 shadow-2xs hover:shadow-xs hover:border-blue-300 transition-all duration-150 overflow-hidden flex flex-row items-stretch group cursor-pointer"
                data-event-id={ev.id}
                data-start-date={ev.startDate}
                data-end-date={ev.endDate}
                data-category-slugs={ev.categorySlugs.join(',')}
              >
                <!-- Date Box (Left compact) -->
                <div class="w-16 sm:w-20 min-w-[64px] sm:min-w-[80px] bg-slate-50/90 py-2 px-1 sm:py-2.5 sm:px-2 border-r border-slate-100 flex flex-col items-center justify-center text-center relative shrink-0">
                  <!-- Colored Accent Bar -->
                  <div class={`absolute top-0 left-0 right-0 h-1 ${conf.bar}`}></div>
                  
                  <span class="text-[10px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-tight">
                    {ev.dateParts.monthText}
                  </span>
                  <span class="text-lg sm:text-xl font-black text-slate-900 leading-none my-0.5">
                    {ev.dateParts.dayText}
                  </span>
                  <span class="text-[10px] font-semibold text-slate-400">
                    {ev.dateParts.yearText}
                  </span>
                </div>

                <!-- Event Details (Right compact) -->
                <div class="flex-1 py-2 px-3 sm:py-2.5 sm:px-3.5 flex flex-col justify-center min-w-0">
                  <!-- Top Category, Featured Tag & Time -->
                  <div class="flex items-center gap-1.5 mb-0.5">
                    {ev.categories.length > 0 && (
                      <span class={`inline-block px-1.5 py-0.2 rounded text-[10px] font-bold ${conf.bg} ${conf.text} border ${conf.border}`}>
                        {ev.categories[0].name}
                      </span>
                    )}

                    {ev.isFeatured && (
                      <span class="inline-flex items-center gap-0.5 px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200/80">
                        <svg class="w-2.5 h-2.5 text-amber-500 fill-amber-500" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                        สำคัญ
                      </span>
                    )}

                    {ev.time && (
                      <span class="text-[11px] text-slate-400 flex items-center gap-1 ml-auto">
                        <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="truncate">{ev.time}</span>
                      </span>
                    )}
                  </div>

                  <!-- Title -->
                  <h3 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-snug line-clamp-1">
                    {ev.title}
                  </h3>

                  <!-- Metadata Row: Location, Organizer & Link -->
                  <div class="mt-1 flex items-center justify-between gap-2 text-[11px] text-slate-500">
                    <div class="flex items-center gap-3 overflow-hidden">
                      {ev.location && (
                        <span class="flex items-center gap-1 truncate text-slate-500">
                          <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                          </svg>
                          <span class="truncate">{ev.location}</span>
                        </span>
                      )}

                      {ev.organizer && (
                        <span class="hidden md:flex items-center gap-1 truncate text-slate-400">
                          <svg class="w-3 h-3 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                          </svg>
                          <span class="truncate">{ev.organizer}</span>
                        </span>
                      )}
                    </div>

                    <span class="inline-flex items-center gap-0.5 text-[11px] font-semibold text-blue-600 group-hover:translate-x-0.5 transition-transform shrink-0 ml-auto">
                      <span>ดูรายละเอียด</span>
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

      </div>

    </div>

  </div>

  <!-- Event Detail Modal Overlay -->
  <div id="event-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs hidden transition-opacity duration-200">
    <div id="event-modal-dialog" class="bg-white rounded-3xl max-w-xl w-full max-h-[90vh] overflow-hidden shadow-2xl border border-slate-100 flex flex-col transform scale-95 transition-transform duration-200">
      
      <!-- Modal Header -->
      <div class="px-6 py-4.5 border-b border-slate-100 flex items-center justify-between bg-slate-50/70">
        <span id="modal-category-badge" class="px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
          กิจกรรมวิทยาลัย
        </span>
        <button
          type="button"
          id="event-modal-close"
          class="w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:text-slate-800 hover:bg-slate-200/60 transition-colors focus:outline-none"
          aria-label="ปิด"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 overflow-y-auto space-y-4">
        <h3 id="modal-title" class="text-xl sm:text-2xl font-bold text-slate-900 leading-snug">
          ชื่อกิจกรรม
        </h3>

        <!-- Meta Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-100 text-xs text-slate-600">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-blue-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <div>
              <div class="text-[10px] text-slate-400 font-medium">วันที่</div>
              <div id="modal-date-text" class="font-bold text-slate-800">-</div>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <div class="text-[10px] text-slate-400 font-medium">เวลา</div>
              <div id="modal-time-text" class="font-bold text-slate-800">-</div>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            </svg>
            <div>
              <div class="text-[10px] text-slate-400 font-medium">สถานที่</div>
              <div id="modal-location-text" class="font-bold text-slate-800">-</div>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-purple-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <div>
              <div class="text-[10px] text-slate-400 font-medium">ผู้รับผิดชอบ</div>
              <div id="modal-organizer-text" class="font-bold text-slate-800">-</div>
            </div>
          </div>
        </div>

        <!-- Content -->
        <div id="modal-content" class="text-sm text-slate-700 leading-relaxed prose prose-slate max-w-none">
          รายละเอียดกิจกรรม
        </div>

        <!-- Attachment Link if available -->
        <div id="modal-attachment-container" class="hidden pt-3 border-t border-slate-100">
          <a
            id="modal-attachment-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-100 hover:bg-blue-50 text-slate-800 hover:text-blue-700 text-xs font-semibold transition-colors"
          >
            <svg class="w-4 h-4 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>ดาวน์โหลดเอกสารประกอบ</span>
          </a>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-100 flex justify-end">
        <button
          type="button"
          id="event-modal-footer-close"
          class="px-4 py-2 rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-bold transition-colors cursor-pointer"
        >
          ปิดหน้าต่าง
        </button>
      </div>

    </div>
  </div>
</section>

<!-- Scoped Styles for Calendar & Filter Chips -->
<style>
  /* Filter chips styling consistent with HomePostsSection */
  .calendar-category-btn {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid rgba(226, 232, 240, 0.8);
  }

  .calendar-category-btn:hover:not(.active) {
    background-color: #e2e8f0;
    color: #0f172a;
  }

  .calendar-category-btn.active {
    background-color: #1e293b !important;
    color: #ffffff !important;
    border-color: #1e293b !important;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }

  .calendar-category-btn.active:hover {
    background-color: #0f172a !important;
    color: #ffffff !important;
  }

  /* Calendar day cell styles */
  .cal-day-cell {
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
    position: relative;
    user-select: none;
  }

  .cal-day-cell.other-month {
    color: #cbd5e1;
    cursor: default;
  }

  .cal-day-cell:not(.other-month):hover {
    background-color: #f1f5f9;
    color: #0047BA;
  }

  .cal-day-cell.today {
    border: 1.5px solid #0047BA;
    color: #0047BA;
  }

  .cal-day-cell.selected {
    background-color: #0047BA !important;
    color: #ffffff !important;
    box-shadow: 0 4px 10px rgba(0, 71, 186, 0.3);
  }

  .cal-day-cell.has-event::after {
    content: '';
    position: absolute;
    bottom: 3px;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background-color: #0047BA;
  }

  .cal-day-cell.selected.has-event::after {
    background-color: #ffffff;
  }

  /* Custom sleek scrollbar for events list */
  .custom-calendar-scroll::-webkit-scrollbar {
    width: 4px;
  }
  .custom-calendar-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-calendar-scroll::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 9999px;
  }
  .custom-calendar-scroll::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }
</style>

<!-- Client Script for Interactive Month Calendar & Filtering -->
<script define:vars={{ serializedEvents, THAI_MONTHS_FULL }}>
  let currentYear = 2026;
  let currentMonth = 9; // October (0-indexed: 9 = October)
  let selectedCategory = 'all';
  let selectedDate = null; // YYYY-MM-DD or null

  const daysGrid = document.getElementById('cal-days-grid');
  const monthTitle = document.getElementById('cal-month-title');
  const prevMonthBtn = document.getElementById('cal-prev-month');
  const nextMonthBtn = document.getElementById('cal-next-month');
  const todayBtn = document.getElementById('cal-today-btn');
  const resetDateBtn = document.getElementById('calendar-reset-date-btn');
  const selectedDateLabel = document.getElementById('calendar-selected-date-label');
  const countLabel = document.getElementById('calendar-count-label');
  const emptyState = document.getElementById('calendar-empty-state');
  const emptyResetBtn = document.getElementById('cal-empty-reset-btn');
  const categoryButtons = document.querySelectorAll('.calendar-category-btn');
  const eventCards = document.querySelectorAll('.calendar-event-card');

  // Modal elements
  const modal = document.getElementById('event-modal');
  const modalDialog = document.getElementById('event-modal-dialog');
  const modalClose = document.getElementById('event-modal-close');
  const modalFooterClose = document.getElementById('event-modal-footer-close');
  const modalCategoryBadge = document.getElementById('modal-category-badge');
  const modalTitle = document.getElementById('modal-title');
  const modalDateText = document.getElementById('modal-date-text');
  const modalTimeText = document.getElementById('modal-time-text');
  const modalLocationText = document.getElementById('modal-location-text');
  const modalOrganizerText = document.getElementById('modal-organizer-text');
  const modalContent = document.getElementById('modal-content');
  const modalAttachmentContainer = document.getElementById('modal-attachment-container');
  const modalAttachmentLink = document.getElementById('modal-attachment-link');

  // Check if a date string falls on YYYY-MM-DD
  function dateMatches(eventStartDate, eventEndDate, targetDateStr) {
    if (!eventStartDate) return false;
    if (eventStartDate === targetDateStr) return true;
    if (eventEndDate && eventEndDate >= targetDateStr && eventStartDate <= targetDateStr) {
      return true;
    }
    return false;
  }

  // Get set of dates in current month that have events
  function getEventDatesInMonth(year, month) {
    const datesWithEvents = new Set();
    const prefix = `${year}-${String(month + 1).padStart(2, '0')}`;

    serializedEvents.forEach((ev) => {
      // Category filter check
      if (selectedCategory !== 'all' && !ev.categorySlugs.includes(selectedCategory)) {
        return;
      }

      if (ev.startDate && ev.startDate.startsWith(prefix)) {
        datesWithEvents.add(ev.startDate);
      }
      if (ev.endDate && ev.endDate.startsWith(prefix)) {
        datesWithEvents.add(ev.endDate);
      }
    });

    return datesWithEvents;
  }

  // Render Month Calendar
  function renderCalendar() {
    if (!daysGrid || !monthTitle) return;

    // Title: e.g. "ตุลาคม 2569"
    const thaiYear = currentYear + 543;
    const monthName = THAI_MONTHS_FULL[currentMonth];
    monthTitle.textContent = `${monthName} ${thaiYear}`;

    daysGrid.innerHTML = '';

    const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay(); // 0 = Sun
    const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();
    const prevMonthDays = new Date(currentYear, currentMonth, 0).getDate();

    const eventDates = getEventDatesInMonth(currentYear, currentMonth);

    // Prev month padding
    for (let i = firstDayIndex - 1; i >= 0; i--) {
      const cell = document.createElement('div');
      cell.className = 'cal-day-cell other-month';
      cell.textContent = prevMonthDays - i;
      daysGrid.appendChild(cell);
    }

    // Current month days
    for (let day = 1; day <= totalDays; day++) {
      const cell = document.createElement('div');
      const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
      
      let classes = 'cal-day-cell';
      if (eventDates.has(dateStr)) {
        classes += ' has-event';
      }
      if (selectedDate === dateStr) {
        classes += ' selected';
      }

      // Today check (October 16, 2026)
      if (currentYear === 2026 && currentMonth === 9 && day === 16) {
        classes += ' today';
      }

      cell.className = classes;
      cell.textContent = day;
      cell.dataset.date = dateStr;

      cell.addEventListener('click', () => {
        if (selectedDate === dateStr) {
          // Unselect
          selectedDate = null;
        } else {
          selectedDate = dateStr;
        }
        applyFilters();
        renderCalendar();
      });

      daysGrid.appendChild(cell);
    }
  }

  // Apply filters on event cards
  function applyFilters() {
    let visibleCount = 0;

    eventCards.forEach((card) => {
      const catSlugs = (card.dataset.categorySlugs || '').split(',');
      const startDate = card.dataset.startDate;
      const endDate = card.dataset.endDate;

      const matchesCat = selectedCategory === 'all' || catSlugs.includes(selectedCategory);
      const matchesDate = !selectedDate || dateMatches(startDate, endDate, selectedDate);

      if (matchesCat && matchesDate) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    // Update count label
    if (countLabel) {
      if (selectedDate) {
        const parts = selectedDate.split('-');
        const d = parseInt(parts[2], 10);
        const m = THAI_MONTHS_FULL[parseInt(parts[1], 10) - 1];
        const y = parseInt(parts[0], 10) + 543;
        countLabel.textContent = `แสดง ${visibleCount} กิจกรรม ประจำวันที่ ${d} ${m} ${y}`;
      } else {
        countLabel.textContent = `แสดงทั้งหมด ${visibleCount} กิจกรรม`;
      }
    }

    // Toggle Empty state
    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }

    // Reset date button visibility
    if (resetDateBtn && selectedDateLabel) {
      if (selectedDate) {
        resetDateBtn.classList.remove('hidden');
        resetDateBtn.classList.add('inline-flex');
        const parts = selectedDate.split('-');
        selectedDateLabel.textContent = `วันที่ ${parts[2]}/${parts[1]}`;
      } else {
        resetDateBtn.classList.add('hidden');
        resetDateBtn.classList.remove('inline-flex');
      }
    }
  }

  // Prev / Next / Today Month navigation
  if (prevMonthBtn) {
    prevMonthBtn.addEventListener('click', () => {
      if (currentMonth === 0) {
        currentMonth = 11;
        currentYear--;
      } else {
        currentMonth--;
      }
      renderCalendar();
    });
  }

  if (nextMonthBtn) {
    nextMonthBtn.addEventListener('click', () => {
      if (currentMonth === 11) {
        currentMonth = 0;
        currentYear++;
      } else {
        currentMonth++;
      }
      renderCalendar();
    });
  }

  if (todayBtn) {
    todayBtn.addEventListener('click', () => {
      currentYear = 2026;
      currentMonth = 9; // October 2026
      renderCalendar();
    });
  }

  if (resetDateBtn) {
    resetDateBtn.addEventListener('click', () => {
      selectedDate = null;
      applyFilters();
      renderCalendar();
    });
  }

  if (emptyResetBtn) {
    emptyResetBtn.addEventListener('click', () => {
      selectedDate = null;
      selectedCategory = 'all';
      categoryButtons.forEach((b) => {
        b.classList.toggle('active', b.dataset.catSlug === 'all');
      });
      applyFilters();
      renderCalendar();
    });
  }

  // Category buttons click
  categoryButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      categoryButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      selectedCategory = btn.dataset.catSlug || 'all';
      applyFilters();
      renderCalendar();
    });
  });

  // Modal open / close handlers
  function openModal(ev) {
    if (!modal) return;
    
    if (modalTitle) modalTitle.textContent = ev.title;
    if (modalCategoryBadge) {
      const catName = ev.categories && ev.categories.length > 0 ? ev.categories[0].name : 'กิจกรรมวิทยาลัย';
      modalCategoryBadge.textContent = catName;
    }

    if (modalDateText) {
      modalDateText.textContent = `${ev.dateParts.dayText} ${ev.dateParts.monthText} ${ev.dateParts.yearText}`;
    }
    if (modalTimeText) modalTimeText.textContent = ev.time || 'ตลอดวัน';
    if (modalLocationText) modalLocationText.textContent = ev.location || 'วิทยาลัยเทคโนโลยีศรีราชา';
    if (modalOrganizerText) modalOrganizerText.textContent = ev.organizer || 'วิทยาลัยเทคโนโลยีศรีราชา';

    if (modalContent) {
      modalContent.innerHTML = ev.content || ev.excerpt || '<p>ไม่มีรายละเอียดเพิ่มเติม</p>';
    }

    if (modalAttachmentContainer && modalAttachmentLink) {
      if (ev.attachmentUrl) {
        modalAttachmentLink.href = ev.attachmentUrl;
        modalAttachmentContainer.classList.remove('hidden');
      } else {
        modalAttachmentContainer.classList.add('hidden');
      }
    }

    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      if (modalDialog) {
        modalDialog.classList.remove('scale-95');
        modalDialog.classList.add('scale-100');
      }
    }, 10);
  }

  function closeModal() {
    if (!modal) return;
    if (modalDialog) {
      modalDialog.classList.remove('scale-100');
      modalDialog.classList.add('scale-95');
    }
    modal.classList.add('opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 150);
  }

  if (modalClose) modalClose.addEventListener('click', closeModal);
  if (modalFooterClose) modalFooterClose.addEventListener('click', closeModal);
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  // Bind clicks on event cards to open modal
  eventCards.forEach((card) => {
    card.addEventListener('click', () => {
      const id = parseInt(card.dataset.eventId, 10);
      const ev = serializedEvents.find((item) => item.id === id);
      if (ev) {
        openModal(ev);
      }
    });
  });

  // Initial render
  renderCalendar();
  applyFilters();
</script>
