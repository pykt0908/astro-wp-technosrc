// HomeCalendarSection.astro - College Event & Academic Calendar Section
import type { CollegeEvent, CollegeEventCategory } from '../types/wordpress';

interface Props {
  events?: CollegeEvent[];
  categories?: CollegeEventCategory[];
  academicYears?: string[];
}

const { events = [], categories = [], academicYears = [] } = Astro.props;

// Helper to sort academic year / semester terms naturally (e.g. 2/2569 > 1/2569 > 2/2568 > 1/2568 > 2569)
function compareAcademicTerms(a: string, b: string): number {
  const parseTerm = (str: string) => {
    if (str.includes('/')) {
      const parts = str.split('/');
      return { sem: parseInt(parts[0], 10) || 0, yr: parseInt(parts[1], 10) || 0 };
    }
    return { sem: 0, yr: parseInt(str, 10) || 0 };
  };
  const termA = parseTerm(a);
  const termB = parseTerm(b);
  if (termB.yr !== termA.yr) return termB.yr - termA.yr;
  return termB.sem - termA.sem;
}

// Helper to format academic term display label
function formatAcademicTermDisplay(term: string): string {
  if (!term) return '';
  if (term.includes('/')) {
    return `ภาคเรียนที่ ${term}`;
  }
  return `ปีการศึกษา ${term}`;
}

// Compute available academic years
const availableAcademicYears = Array.from(
  new Set([
    ...academicYears,
    ...events.map((e) => e.academicYear).filter((y): y is string => Boolean(y)),
    '1/2569',
    '2/2569',
  ])
).sort(compareAcademicTerms);

// Default to current term based on month (May-Oct = 1, Nov-Apr = 2) or availableAcademicYears[0]
const todayDate = new Date();
const currentMonthNum = todayDate.getMonth() + 1;
const currentThaiYear = todayDate.getFullYear() + 543;
const autoDetectedTerm = (currentMonthNum >= 5 && currentMonthNum <= 10)
  ? `1/${currentThaiYear}`
  : `2/${currentThaiYear}`;

const currentAcademicYear = availableAcademicYears.includes(autoDetectedTerm)
  ? autoDetectedTerm
  : (availableAcademicYears[0] || '1/2569');

// Month names in Thai
const THAI_MONTHS_FULL = [
  'มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
  'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'
];

const THAI_MONTHS_SHORT = [
  'ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.',
  'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'
];

// Helper to format date display in Thai
function getThaiDateParts(startDateStr: string, endDateStr?: string) {
  if (!startDateStr) {
    return { dayText: '-', monthText: '-', yearText: '-' };
  }

  const sParts = startDateStr.split('-');
  const sYear = parseInt(sParts[0], 10);
  const sMonth = parseInt(sParts[1], 10) - 1;
  const sDay = parseInt(sParts[2], 10);

  const thaiYear = sYear + 543;
  const monthShort = THAI_MONTHS_SHORT[sMonth] || '';

  if (endDateStr && endDateStr !== startDateStr) {
    const eParts = endDateStr.split('-');
    const eMonth = parseInt(eParts[1], 10) - 1;
    const eDay = parseInt(eParts[2], 10);

    if (sMonth === eMonth) {
      return {
        dayText: `${sDay} - ${eDay}`,
        monthText: monthShort,
        yearText: `${thaiYear}`,
      };
    } else {
      const eMonthShort = THAI_MONTHS_SHORT[eMonth] || '';
      return {
        dayText: `${sDay} ${monthShort} - ${eDay} ${eMonthShort}`,
        monthText: '',
        yearText: `${thaiYear}`,
      };
    }
  }

  return {
    dayText: `${sDay}`,
    monthText: monthShort,
    yearText: `${thaiYear}`,
  };
}



const COLOR_NAME_TO_HEX: Record<string, string> = {
  blue: '#0047BA',
  emerald: '#059669',
  green: '#059669',
  amber: '#d97706',
  yellow: '#d97706',
  orange: '#d97706',
  rose: '#e11d48',
  red: '#e11d48',
  purple: '#7c3aed',
};

function resolveColorHex(color?: string): string {
  if (!color) return '#0047BA';
  const c = color.trim().toLowerCase();
  if (COLOR_NAME_TO_HEX[c]) return COLOR_NAME_TO_HEX[c];
  if (/^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(c)) return c;
  return '#0047BA';
}

function hexToPresetName(hexOrName?: string): 'blue' | 'emerald' | 'amber' | 'rose' | 'purple' {
  if (!hexOrName) return 'blue';
  const c = hexOrName.trim().toLowerCase();
  if (c === 'emerald' || c === 'green' || c === '#059669' || c === '#10b981' || c === '#16a34a') return 'emerald';
  if (c === 'amber' || c === 'yellow' || c === 'orange' || c === '#d97706' || c === '#f59e0b' || c === '#ea580c') return 'amber';
  if (c === 'rose' || c === 'red' || c === '#e11d48' || c === '#f43f5e' || c === '#ef4444' || c === '#dc2626') return 'rose';
  if (c === 'purple' || c === '#7c3aed' || c === '#8b5cf6' || c === '#9333ea') return 'purple';
  return 'blue';
}

function hexToSoftBg(hex: string): string {
  const clean = hex.replace('#', '');
  if (clean.length === 6) {
    const r = parseInt(clean.substring(0, 2), 16);
    const g = parseInt(clean.substring(2, 4), 16);
    const b = parseInt(clean.substring(4, 6), 16);
    return `rgba(${r}, ${g}, ${b}, 0.08)`;
  }
  return 'rgba(0, 71, 186, 0.08)';
}

function hexToBorder(hex: string): string {
  const clean = hex.replace('#', '');
  if (clean.length === 6) {
    const r = parseInt(clean.substring(0, 2), 16);
    const g = parseInt(clean.substring(2, 4), 16);
    const b = parseInt(clean.substring(4, 6), 16);
    return `rgba(${r}, ${g}, ${b}, 0.28)`;
  }
  return 'rgba(0, 71, 186, 0.28)';
}

// Clean categories
const displayCategories = categories.length > 0 ? categories : [
  { id: 7, name: 'กำหนดการศึกษา', slug: 'academic-schedule', color: 'amber' },
  { id: 8, name: 'กิจกรรมนักศึกษา', slug: 'student-activities', color: 'blue' },
  { id: 9, name: 'วิชาการและอบรม', slug: 'academic-training', color: 'purple' },
  { id: 10, name: 'วันสำคัญและวันหยุด', slug: 'holidays', color: 'rose' },
];

// Serialize events for client-side calendar filtering
const serializedEvents = events.map((ev) => {
  const parts = getThaiDateParts(ev.startDate, ev.endDate);
  const primaryCatColor = ev.categories && ev.categories[0]?.color;
  const rawColor = (ev.color && ev.color !== 'auto' ? ev.color : null) || primaryCatColor || ev.color || 'blue';
  const hex = resolveColorHex(rawColor);
  const presetKey = hexToPresetName(hex);
  return {
    id: ev.id,
    title: ev.title,
    slug: ev.slug,
    content: ev.content,
    excerpt: ev.excerpt,
    academicYear: ev.academicYear || '2569',
    startDate: ev.startDate,
    endDate: ev.endDate,
    time: ev.time,
    location: ev.location,
    note: ev.note || '',
    organizer: ev.organizer,
    link: ev.link,
    attachmentUrl: ev.attachmentUrl,
    color: hex,
    presetColor: presetKey,
    isFeatured: ev.isFeatured,
    thumbnail: ev.thumbnail,
    categories: ev.categories || [],
    categorySlugs: (ev.categories || []).map((c) => c.slug),
    dateParts: parts,
  };
});

// Helper to check if event overlaps with a given month (0-indexed month)
function eventMatchesMonth(startDate?: string, endDate?: string, year = 2026, month = 9) {
  if (!startDate) return false;
  const monthStartStr = `${year}-${String(month + 1).padStart(2, '0')}-01`;
  const lastDay = new Date(year, month + 1, 0).getDate();
  const monthEndStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(lastDay).padStart(2, '0')}`;
  const sDate = startDate;
  const eDate = endDate || startDate;
  return sDate <= monthEndStr && eDate >= monthStartStr;
}

const initialDate = new Date();
let initialYear = initialDate.getFullYear();
let initialMonth = initialDate.getMonth();

const hasEventsInInitialMonth = events.some((ev) =>
  eventMatchesMonth(ev.startDate, ev.endDate, initialYear, initialMonth)
);
if (!hasEventsInInitialMonth && events.length > 0 && events[0].startDate) {
  const parts = events[0].startDate.split('-');
  if (parts.length >= 2) {
    initialYear = parseInt(parts[0], 10);
    initialMonth = parseInt(parts[1], 10) - 1;
  }
}
---

<section id="college-calendar-section" class="py-12 sm:py-16 bg-white border-t border-slate-200/80 select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with badge and title -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 sm:mb-10">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
          ปฏิทินกิจกรรมวิทยาลัย
        </h2>
        <p class="text-slate-500 text-sm sm:text-base mt-1.5 max-w-2xl leading-relaxed">
          ติดตามกำหนดการสำคัญ วันเปิด-ปิดภาคเรียน การสอบวัดผล และกิจกรรมส่งเสริมการเรียนรู้ของวิทยาลัยเทคโนโลยีศรีราชา
        </p>
      </div>

      <!-- Action: Academic Year Dropdown & PDF Download Button -->
      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 shrink-0">
        <!-- Academic Year Dropdown -->
        <div class="relative flex items-center">
          <label for="calendar-academic-year-select" class="sr-only">เลือกภาคเรียน / ปีการศึกษา</label>
          <div class="absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none text-blue-600">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <select
            id="calendar-academic-year-select"
            class="pl-8 pr-7 py-2 rounded-xl bg-blue-50/80 hover:bg-blue-100/70 text-blue-900 border border-blue-200/90 font-bold text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer transition-colors appearance-none"
            title="เลือกภาคเรียน / ปีการศึกษาเพื่อดูและดาวน์โหลดปฏิทิน"
          >
            {availableAcademicYears.map((yr) => (
              <option value={yr} selected={yr === currentAcademicYear}>
                {formatAcademicTermDisplay(yr)}
              </option>
            ))}
          </select>
          <div class="absolute inset-y-0 right-0 pr-2 flex items-center pointer-events-none text-blue-500">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>

        <!-- Action: PDF Download Button -->
        <a
          id="calendar-download-pdf-btn"
          href={`/calendar/print?year=${currentAcademicYear}&auto=1`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-blue-600 text-white text-xs sm:text-sm font-semibold shadow-xs hover:shadow-md transition-all duration-200 group"
          title="ดาวน์โหลดหรือสั่งพิมพ์ปฏิทินการศึกษาทางการแบบ PDF"
        >
          <svg class="w-4 h-4 text-blue-300 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span id="calendar-download-pdf-text">ดาวน์โหลดปฏิทิน (PDF)</span>
        </a>
      </div>
    </div>

    <!-- Filter and Search Bar -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3.5 mb-8">
      
      <!-- Category Filter Chips (Left) -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-2.5" id="calendar-category-filter">
        <button
          type="button"
          class="calendar-category-btn active px-3.5 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer focus:outline-none"
          data-cat-slug="all"
        >
          ทั้งหมด
        </button>

        {displayCategories.map((cat) => {
          const hex = resolveColorHex(cat.color);
          return (
            <button
              type="button"
              class="calendar-category-btn px-3.5 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer focus:outline-none inline-flex items-center gap-1.5"
              data-cat-slug={cat.slug}
            >
              <span class="w-2 h-2 rounded-full inline-block shrink-0" style={`background-color: ${hex};`}></span>
              <span>{cat.name}</span>
            </button>
          );
        })}

        <!-- Reset Filter indicator if date selected -->
        <button
          type="button"
          id="calendar-reset-date-btn"
          class="hidden items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100 transition-colors cursor-pointer"
        >
          <span id="calendar-selected-date-label">กรองตามวันที่</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Search Input Box (Right) -->
      <div class="relative w-full sm:w-72 lg:w-80 shrink-0">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="calendar-search-input"
          placeholder="ค้นหากิจกรรม, กำหนดการ..."
          autocomplete="off"
          class="w-full pl-9.5 pr-8 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 hover:bg-slate-100/70 focus:bg-white border border-slate-200/90 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition-all placeholder:text-slate-400 font-medium text-slate-800"
        />
        <button
          type="button"
          id="calendar-search-clear-btn"
          class="hidden absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none cursor-pointer"
          aria-label="ล้างการค้นหา"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>

    <!-- 2-Column Bento Layout: Left = Interactive Calendar, Right = Events Timeline -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Mini Month Calendar Widget & Quick Info -->
      <div class="lg:col-span-5 xl:col-span-4 flex flex-col gap-6">
        
        <!-- Interactive Month Calendar Card -->
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 sm:p-6">
          
          <!-- Month & Year Selector -->
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
            <div>
              <h3 id="cal-month-title" class="text-base sm:text-lg font-bold text-slate-900 flex items-center gap-2">
                ตุลาคม 2569
              </h3>
              <p class="text-[11px] text-slate-500 font-medium">กดเลือกวันที่เพื่อดูกิจกรรม</p>
            </div>
            
            <div class="flex items-center gap-1">
              <button
                type="button"
                id="cal-prev-month"
                class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors focus:outline-none"
                aria-label="เดือนก่อนหน้า"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
              </button>

              <button
                type="button"
                id="cal-today-btn"
                class="px-2 py-1 text-[11px] font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 rounded-md transition-colors"
              >
                วันนี้
              </button>

              <button
                type="button"
                id="cal-next-month"
                class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors focus:outline-none"
                aria-label="เดือนถัดไป"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Weekday Headers -->
          <div class="grid grid-cols-7 gap-1 text-center mb-2">
            <span class="text-[11px] font-bold text-rose-500">อา.</span>
            <span class="text-[11px] font-bold text-slate-500">จ.</span>
            <span class="text-[11px] font-bold text-slate-500">อ.</span>
            <span class="text-[11px] font-bold text-slate-500">พ.</span>
            <span class="text-[11px] font-bold text-slate-500">พฤ.</span>
            <span class="text-[11px] font-bold text-slate-500">ศ.</span>
            <span class="text-[11px] font-bold text-blue-500">ส.</span>
          </div>

          <!-- Calendar Days Grid (Populated dynamically) -->
          <div id="cal-days-grid" class="grid grid-cols-7 gap-1 text-center min-h-[220px]">
            <!-- Dynamic days will be injected via JS -->
          </div>

          <!-- Color Legend (Dynamic from categories) -->
          <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] text-slate-600 font-medium">
            {displayCategories.map((cat) => {
              const hex = resolveColorHex(cat.color);
              return (
                <span class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full inline-block shrink-0 shadow-xs" style={`background-color: ${hex};`}></span>
                  <span class="text-slate-700 font-medium">{cat.name}</span>
                </span>
              );
            })}
          </div>
        </div>

      </div>

      <!-- Right Column: Events List / Timeline -->
      <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-4">

        <!-- Empty state when no events match category or date -->
        <div
          id="calendar-empty-state"
          class="hidden py-16 px-6 text-center  rounded-2xl border border-dashed border-slate-300"
        >
          <div class="w-12 h-12 mx-auto rounded-full bg-slate-200/70 flex items-center justify-center text-slate-400 mb-3">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-800">-- ไม่พบกิจกรรม--</h3>
          <button
            type="button"
            id="cal-empty-reset-btn"
            class="mt-4 px-4 py-1.5 rounded-full text-xs font-semibold bg-blue-600 text-white hover:bg-blue-700 transition-colors cursor-pointer"
          >
            แสดงกิจกรรมทั้งหมด
          </button>
        </div>

        <!-- Events Cards Container -->
        <div id="calendar-events-list" class="flex flex-col gap-3.5">
          {serializedEvents.map((ev) => {
            const hex = ev.color;
            const softBg = hexToSoftBg(hex);
            const borderHex = hexToBorder(hex);
            const matchesInitialMonth = eventMatchesMonth(ev.startDate, ev.endDate, initialYear, initialMonth);
            return (
              <article
                class:list={[
                  'calendar-event-card bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:shadow-md hover:border-blue-200 transition-all duration-200 overflow-hidden flex flex-col sm:flex-row items-stretch group cursor-pointer',
                  (!matchesInitialMonth || ev.academicYear !== currentAcademicYear) ? 'hidden' : ''
                ]}
                data-event-id={ev.id}
                data-academic-year={ev.academicYear}
                data-start-date={ev.startDate}
                data-end-date={ev.endDate}
                data-category-slugs={ev.categorySlugs.join(',')}
                data-title={ev.title}
                data-excerpt={ev.excerpt}
                data-location={ev.location}
                data-note={ev.note || ''}
              >
                <!-- Date Box (Left on tablet/desktop) -->
                <div class="w-full sm:w-32 sm:min-w-[128px] bg-slate-50/80 p-3.5 sm:p-4 border-b sm:border-b-0 sm:border-r border-slate-100 flex sm:flex-col items-center justify-between sm:justify-center text-center relative">
                  <!-- Colored Accent Bar with real event/category color -->
                  <div class="absolute top-0 left-0 right-0 h-1 sm:h-1.5" style={`background-color: ${hex};`}></div>
                  
                  <span class="text-xs sm:text-xs font-bold text-slate-500 uppercase tracking-wide">
                    {ev.dateParts.monthText}
                  </span>
                  <span class="text-2xl sm:text-3xl font-black text-slate-900 leading-tight tracking-tight my-0.5">
                    {ev.dateParts.dayText}
                  </span>
                  <span class="text-[11px] font-semibold text-slate-400">
                    {ev.dateParts.yearText}
                  </span>
                </div>

                <!-- Event Details (Right) -->
