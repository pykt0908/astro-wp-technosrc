---
// HomePostsSection.astro - Post grid with category filter tabs maintaining consistent bento layout
import type { Post, Category } from '../types/wordpress';

interface Props {
  posts: Post[];
  categories: Category[];
}

const { posts = [], categories = [] } = Astro.props;

// Filter out Uncategorized
const cleanCategories = categories.filter(
  (c) => c && c.slug !== 'uncategorized' && c.name !== 'Uncategorized'
);

// Format Thai Date e.g. "24 ก.ย. 2569"
function formatThaiDate(dateStr: string) {
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  const thaiMonths = [
    'ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.',
    'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.',
  ];
  const day = d.getDate();
  const month = thaiMonths[d.getMonth()];
  const year = d.getFullYear() + 543;
  return `${day} ${month} ${year}`;
}

// Decode HTML entities
function decodeHtmlEntities(str: string) {
  if (!str) return '';
  return str
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/&#(\d+);/g, (_, code) => {
      try {
        return String.fromCodePoint(parseInt(code, 10));
      } catch {
        return '';
      }
    })
    .replace(/&#x([0-9a-fA-F]+);/g, (_, code) => {
      try {
        return String.fromCodePoint(parseInt(code, 16));
      } catch {
        return '';
      }
    });
}

const fallbackImage =
  'https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=800&auto=format&fit=crop';
const defaultAvatar =
  'https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=120&auto=format&fit=crop';

const serializedPosts = posts.map((p) => ({
  id: p.id,
  slug: p.slug,
  title: decodeHtmlEntities(p.titlePlain),
  excerpt: decodeHtmlEntities(p.excerptPlain),
  coverUrl: p.coverUrl || fallbackImage,
  coverAlt: p.coverAlt || decodeHtmlEntities(p.titlePlain),
  categoryIds: p.categoryIds || [],
  categoryName: p.categoryNames && p.categoryNames.length > 0 ? p.categoryNames[0] : '',
  publishedAt: formatThaiDate(p.publishedAt),
  views: p.views ?? 11,
  authorName: p.authorName || 'Admin',
  authorAvatar: p.authorAvatar || defaultAvatar,
}));

// Pre-fill initial 6 slots for SSR
const post0 = serializedPosts[0] || null;
const post1 = serializedPosts[1] || null;
const post2 = serializedPosts[2] || null;
const post3 = serializedPosts[3] || null;
const post4 = serializedPosts[4] || null;
const post5 = serializedPosts[5] || null;
---

<section class="py-8 sm:py-10 lg:py-12 bg-slate-50/60 border-t border-slate-100 select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 mb-6 sm:mb-7" id="category-filter-nav">
      <button
        type="button"
        class="category-filter-btn active px-3.5 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-bold transition-all duration-200 bg-[#0f172a] text-white shadow-xs cursor-pointer focus:outline-none"
        data-category="all"
      >
        ทั้งหมด
      </button>

      {cleanCategories.map((cat) => (
        <button
          type="button"
          class="category-filter-btn px-3.5 sm:px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 bg-white text-slate-700 border border-slate-200 hover:border-slate-300 hover:bg-slate-50 cursor-pointer focus:outline-none"
          data-category={cat.id}
          data-slug={cat.slug}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Empty state notice when filter matches 0 posts -->
    <div
      id="posts-empty-notice"
      class:list={['py-12 text-center bg-white rounded-2xl border border-slate-200/80 p-6', serializedPosts.length === 0 ? '' : 'hidden']}
    >
      <div class="w-10 h-10 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-2.5">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
