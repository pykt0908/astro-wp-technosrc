<!-- Raw JSON data for client-side category filtering while maintaining Bento structure -->
<script id="bento-posts-data" type="application/json" set:html={JSON.stringify(serializedPosts)} />

<script>
  interface BentoPost {
    id: number;
    slug: string;
    title: string;
    excerpt: string;
    coverUrl: string;
    coverAlt: string;
    categoryIds: number[];
    categoryName: string;
    publishedAt: string;
    views: number;
    authorName: string;
    authorAvatar: string;
  }

  function setupCategoryFiltering() {
    const filterNav = document.getElementById('category-filter-nav');
    const postsDataEl = document.getElementById('bento-posts-data');
    if (!filterNav || !postsDataEl) return;

    // Avoid double-binding if Astro page-load fires multiple times
    if (filterNav.hasAttribute('data-bento-initialized')) return;
    filterNav.setAttribute('data-bento-initialized', 'true');

    let allPosts: BentoPost[] = [];
    try {
      allPosts = JSON.parse(postsDataEl.textContent || '[]');
    } catch (e) {
      console.error('Failed to parse bento posts data', e);
      return;
    }

    const filterBtns = filterNav.querySelectorAll<HTMLButtonElement>('.category-filter-btn');
    const emptyNotice = document.getElementById('posts-empty-notice');
    const postsContainer = document.getElementById('posts-main-container');

    const slot0 = document.getElementById('bento-slot-0');
    const rightStack = document.getElementById('bento-right-stack');
    const slot1 = document.getElementById('bento-slot-1');
    const slot2 = document.getElementById('bento-slot-2');
    const bottomRow = document.getElementById('bento-bottom-row');
    const slot3 = document.getElementById('bento-slot-3');
    const slot4 = document.getElementById('bento-slot-4');
    const slot5 = document.getElementById('bento-slot-5');

    function updateSlot(slotEl: HTMLElement, post: BentoPost) {
      // Links
      const links = slotEl.querySelectorAll<HTMLAnchorElement>('.bento-link');
      links.forEach((l) => l.setAttribute('href', `/news/${post.slug}/`));

      // Thumbnail
      const img = slotEl.querySelector<HTMLImageElement>('.bento-img');
      if (img) {
        img.setAttribute('src', post.coverUrl);
        img.setAttribute('alt', post.coverAlt || post.title);
      }

      // Category badge
      const badge = slotEl.querySelector<HTMLElement>('.bento-badge');
      if (badge) {
        if (post.categoryName) {
          badge.textContent = post.categoryName;
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }

      // Date
      const dateEl = slotEl.querySelector<HTMLElement>('.bento-date');
      if (dateEl) dateEl.textContent = post.publishedAt;

      // Views
      const viewsEl = slotEl.querySelector<HTMLElement>('.bento-views');
      if (viewsEl) viewsEl.textContent = String(post.views ?? 0);

      // Title
      const titleEl = slotEl.querySelector<HTMLElement>('.bento-title');
      if (titleEl) titleEl.textContent = post.title;

      // Excerpt
      const excerptEl = slotEl.querySelector<HTMLElement>('.bento-excerpt');
      if (excerptEl) excerptEl.textContent = post.excerpt;

      // Author avatar
      const authorAvatar = slotEl.querySelector<HTMLImageElement>('.bento-author-avatar');
      if (authorAvatar) {
        authorAvatar.setAttribute('src', post.authorAvatar);
        authorAvatar.setAttribute('alt', post.authorName);
      }

      // Author name
      const authorName = slotEl.querySelector<HTMLElement>('.bento-author-name');
      if (authorName) authorName.textContent = post.authorName;
    }

    function applyFilter(selectedCat: string | null) {
      let filtered: BentoPost[] = [];
      if (!selectedCat || selectedCat === 'all') {
        filtered = allPosts;
      } else {
        const targetId = parseInt(selectedCat, 10);
        filtered = allPosts.filter(
          (p) => Array.isArray(p.categoryIds) && p.categoryIds.includes(targetId)
        );
      }

      if (filtered.length === 0) {
        emptyNotice?.classList.remove('hidden');
        postsContainer?.classList.add('hidden');
        return;
      }

      emptyNotice?.classList.add('hidden');
      postsContainer?.classList.remove('hidden');

      // Slot 0 (Main Featured Card)
      if (filtered[0] && slot0) {
        updateSlot(slot0, filtered[0]);
        slot0.classList.remove('hidden');
      } else if (slot0) {
        slot0.classList.add('hidden');
      }

      // Slots 1 & 2 (Right Stack)
      let hasRightPosts = false;
      if (filtered[1] && slot1) {
        updateSlot(slot1, filtered[1]);
        slot1.classList.remove('hidden');
        hasRightPosts = true;
      } else if (slot1) {
        slot1.classList.add('hidden');
      }

      if (filtered[2] && slot2) {
        updateSlot(slot2, filtered[2]);
        slot2.classList.remove('hidden');
        hasRightPosts = true;
      } else if (slot2) {
        slot2.classList.add('hidden');
      }

      if (rightStack) {
        if (hasRightPosts) {
          rightStack.classList.remove('hidden');
        } else {
          rightStack.classList.add('hidden');
        }
      }

      // Slots 3, 4, 5 (Bottom Row)
      if (bottomRow) {
        if (filtered.length <= 3) {
          bottomRow.classList.add('hidden');
        } else {
          bottomRow.classList.remove('hidden');

          if (filtered[3] && slot3) {
            updateSlot(slot3, filtered[3]);
            slot3.classList.remove('hidden');
          } else if (slot3) {
            slot3.classList.add('hidden');
          }

          if (filtered[4] && slot4) {
            updateSlot(slot4, filtered[4]);
            slot4.classList.remove('hidden');
          } else if (slot4) {
            slot4.classList.add('hidden');
          }

          if (filtered[5] && slot5) {
            updateSlot(slot5, filtered[5]);
            slot5.classList.remove('hidden');
          } else if (slot5) {
            slot5.classList.add('hidden');
          }
        }
      }
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        // Toggle button active state
        filterBtns.forEach((b) => {
          b.classList.remove('bg-[#0f172a]', 'text-white', 'border-transparent', 'shadow-xs', 'active');
          b.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
        });

        btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
        btn.classList.add('bg-[#0f172a]', 'text-white', 'border-transparent', 'shadow-xs', 'active');

        const selectedCat = btn.getAttribute('data-category');

        if (postsContainer) {
          postsContainer.classList.add('opacity-30');
          setTimeout(() => {
            applyFilter(selectedCat);
            postsContainer.classList.remove('opacity-30');
          }, 120);
        } else {
          applyFilter(selectedCat);
        }
      });
    });
  }

  setupCategoryFiltering();
  document.addEventListener('astro:page-load', () => {
    // Reset initialization flag so it works on client-side navigation
    const filterNav = document.getElementById('category-filter-nav');
    if (filterNav) filterNav.removeAttribute('data-bento-initialized');
    setupCategoryFiltering();
  });
</script>

