---
// HomeIntroSection.astro - Institutional Hero Intro Section below banner
---

<section class="relative bg-white dark:bg-slate-900 py-8 sm:py-12 lg:py-14 overflow-hidden select-none transition-colors duration-200">
  <!-- Subtle Giant Background Watermark with Smooth Horizontal Scroll -->
  <div
    class="absolute inset-0 flex items-center pointer-events-none overflow-hidden z-0 select-none"
    aria-hidden="true"
  >
    <div class="marquee-wrapper">
      <div class="marquee-track">
        <span class="marquee-text">
          SRIRACHA TECHNOLOGICAL COLLEGE &bull;
        </span>
        <span class="marquee-text">
          SRIRACHA TECHNOLOGICAL COLLEGE &bull;
        </span>
        <span class="marquee-text">
          SRIRACHA TECHNOLOGICAL COLLEGE &bull;
        </span>
        <span class="marquee-text">
          SRIRACHA TECHNOLOGICAL COLLEGE &bull;
        </span>
      </div>
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 items-center">
      <!-- Left Column: Typography Headline -->
      <div class="lg:col-span-7 xl:col-span-8 flex flex-col items-start">
        <!-- Top Subtitle -->
        <p class="text-[#0047BA] dark:text-blue-400 font-bold text-xs sm:text-sm md:text-base tracking-wider mb-2 sm:mb-3">
          เปิดโอกาสใหม่ ๆ ในการเรียนรู้และพัฒนาทักษะของคุณ
        </p>

        <!-- Big Bold Title -->
        <h2 class="flex flex-col font-black tracking-tight leading-[0.95]">
          <span class="text-slate-900 dark:text-white text-6xl sm:text-7xl md:text-8xl lg:text-[105px] xl:text-[124px] font-black uppercase">
            THE
          </span>
          <span class="text-slate-900 dark:text-white text-6xl sm:text-7xl md:text-8xl lg:text-[105px] xl:text-[124px] font-black uppercase mt-1 sm:mt-2">
            FUTURE
          </span>
          <span class="stroke-text-blue text-5xl sm:text-6xl md:text-7xl lg:text-[90px] xl:text-[110px] font-black mt-2 sm:mt-3">
            เริ่มต้นที่นี่
          </span>
        </h2>
      </div>

      <!-- Right Column: Logo, Tagline & Action Button -->
      <div class="lg:col-span-5 xl:col-span-4 flex flex-col items-center justify-center text-center">
        <!-- Circular College Emblem Logo -->
        <div class="relative w-28 h-28 sm:w-36 sm:h-36 rounded-full bg-white dark:bg-slate-800 p-1.5 shadow-xl shadow-blue-900/10 dark:shadow-black/40 border border-blue-50 dark:border-slate-700 flex items-center justify-center mb-4 sm:mb-5 group transition-transform duration-300 hover:scale-105">
          <img
            src="/logo/LOGO_SERIRACHA_COLOR_FULL.png"
            alt="ตราสัญลักษณ์ วิทยาลัยเทคโนโลยีศรีราชา"
            class="w-full h-full object-contain rounded-full"
            loading="lazy"
            width="160"
            height="160"
          />
        </div>

        <!-- Description Paragraph -->
        <p class="text-slate-600 dark:text-slate-300 font-medium text-sm sm:text-base leading-relaxed max-w-xs sm:max-w-sm mb-4 sm:mb-5">
          มุ่งเน้นความเป็นเลิศทางนวัตกรรมและเทคโนโลยี<br />
          สร้างความพร้อมให้นักศึกษาสู่ตลาดแรงงาน<br />
          ระดับสากล
        </p>

        <!-- Circular Action Button with Down Arrow -->
        <div class="flex flex-col items-center gap-2.5">
          <a
            href="/contact/"
            class="w-12 h-12 rounded-full bg-black dark:bg-blue-600 text-white hover:bg-slate-800 dark:hover:bg-blue-500 flex items-center justify-center shadow-lg transition-all duration-300 hover:scale-110 active:scale-95 group focus:outline-none focus:ring-4 focus:ring-black/20 dark:focus:ring-blue-500/30"
            aria-label="ไปยังหน้าติดต่อสมัครเรียน"
          >
            <svg
              class="w-5 h-5 transition-transform duration-300 group-hover:translate-y-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
          <a
            href="/contact/"
            class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors"
          >
            สนใจสมัครเรียนกับเรา
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Floating Scroll-to-Top Button -->
<button
  type="button"
  id="scroll-to-top-btn"
  class="fixed bottom-6 right-6 z-40 w-10 h-10 sm:w-11 sm:h-11 rounded-md bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-md text-slate-700 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 hover:border-blue-300 dark:hover:border-blue-500 hover:bg-blue-50/50 dark:hover:bg-slate-700 flex items-center justify-center transition-all duration-300 opacity-0 pointer-events-none hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
  aria-label="เลื่อนขึ้นด้านบน"
>
  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
  </svg>
</button>

<style>
  .stroke-text-blue {
    color: transparent;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 2px #0047BA;
    text-stroke: 2px #0047BA;
    display: inline-block;
  }
  @media (min-width: 1024px) {
    .stroke-text-blue {
      -webkit-text-stroke: 2.5px #0047BA;
      text-stroke: 2.5px #0047BA;
    }
  }

  :global(.dark) .stroke-text-blue {
    -webkit-text-stroke: 2px #3b82f6;
    text-stroke: 2px #3b82f6;
  }
  @media (min-width: 1024px) {
    :global(.dark) .stroke-text-blue {
      -webkit-text-stroke: 2.5px #3b82f6;
      text-stroke: 2.5px #3b82f6;
    }
  }

  /* Horizontal Scrolling Background Watermark */
  .marquee-wrapper {
    width: 100%;
    overflow: hidden;
    display: flex;
    user-select: none;
    pointer-events: none;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: marquee-horizontal 38s linear infinite;
  }

  .marquee-text {
    font-size: clamp(72px, 12.5vw, 180px);
    font-weight: 900;
    color: rgba(241, 245, 249, 0.95);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1;
    padding-right: 3rem;
    user-select: none;
  }

  :global(.dark) .marquee-text {
    color: rgba(255, 255, 255, 0.04);
  }

  @keyframes marquee-horizontal {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>

<script>
  function initScrollToTop() {
    const btn = document.getElementById('scroll-to-top-btn');
    if (!btn) return;

    function handleScroll() {
      if (window.scrollY > 300) {
        btn?.classList.remove('opacity-0', 'pointer-events-none');
        btn?.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        btn?.classList.add('opacity-0', 'pointer-events-none');
        btn?.classList.remove('opacity-100', 'pointer-events-auto');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  initScrollToTop();
  document.addEventListener('astro:page-load', initScrollToTop);
</script>
