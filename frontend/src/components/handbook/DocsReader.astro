<!-- Client-side Interactive Scripts -->
<script>
  function initCollegeDocs() {
    // 1. Search Modal (⌘K)
    const searchModal = document.getElementById('docs-search-modal');
    const topSearchBtn = document.getElementById('docs-top-search-btn');
    const searchInput = document.getElementById('docs-modal-search-input') as HTMLInputElement | null;
    const searchItems = document.querySelectorAll<HTMLElement>('.search-item');

    function openSearch() {
      if (searchModal) {
        searchModal.classList.remove('hidden');
        searchModal.classList.add('flex');
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        searchItems.forEach((it) => it.classList.remove('hidden'));
      }
    }

    function closeSearch() {
      if (searchModal) {
        searchModal.classList.add('hidden');
        searchModal.classList.remove('flex');
      }
    }

    if (topSearchBtn) topSearchBtn.addEventListener('click', openSearch);

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openSearch();
      }
      if (e.key === 'Escape' && searchModal && !searchModal.classList.contains('hidden')) {
        closeSearch();
      }
    });

    if (searchModal) {
      searchModal.addEventListener('click', (e) => {
        if (e.target === searchModal) closeSearch();
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.trim().toLowerCase();
        searchItems.forEach((it) => {
          const title = it.dataset.title || '';
          it.classList.toggle('hidden', Boolean(query && !title.includes(query)));
        });
      });
    }

    // 2. Mobile Drawer
    const mobileDrawer = document.getElementById('docs-mobile-drawer');
    const openDrawerBtn = document.getElementById('docs-mobile-menu-btn');
    const closeDrawerBtn = document.getElementById('docs-close-drawer-btn');

    if (openDrawerBtn && mobileDrawer) {
      openDrawerBtn.addEventListener('click', () => mobileDrawer.classList.remove('hidden'));
    }
    if (closeDrawerBtn && mobileDrawer) {
      closeDrawerBtn.addEventListener('click', () => mobileDrawer.classList.add('hidden'));
    }
    if (mobileDrawer) {
      mobileDrawer.addEventListener('click', (e) => {
        if (e.target === mobileDrawer) mobileDrawer.classList.add('hidden');
      });
    }

    // 3. Print & Copy Link
    const printBtn = document.getElementById('btn-print-doc');
    if (printBtn) printBtn.addEventListener('click', () => window.print());

    const copyBtn = document.getElementById('btn-copy-doc-link');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href).then(() => {
          const original = copyBtn.innerHTML;
          copyBtn.innerHTML = '<span class="text-emerald-500 font-semibold text-xs">✓ คัดลอกแล้ว</span>';
          setTimeout(() => (copyBtn.innerHTML = original), 2000);
        });
      });
    }

    // 4. ScrollSpy & Interactive Subheadings (Right & Left Sidebars)
    const onPageLinks = document.querySelectorAll<HTMLElement>('.on-page-link');
    const sidebarSubLinks = document.querySelectorAll<HTMLElement>('.sidebar-subheading-link');
    const mobileSubLinks = document.querySelectorAll<HTMLElement>('.mobile-subheading-link');

    // Collect all heading DOM elements in document order
    const headingElements: HTMLElement[] = [];
    document.querySelectorAll<HTMLElement>('article h2[id], article h3[id], article h4[id]').forEach((el) => {
      headingElements.push(el);
    });

    if (headingElements.length > 0) {
      function applyActiveHeading(activeId: string) {
        // A. Right Sidebar
        onPageLinks.forEach((link) => {
          const id = link.dataset.headingId;
          if (id === activeId) {
            link.classList.add('border-[#0047BA]', 'dark:border-sky-400', 'text-[#0047BA]', 'dark:text-sky-300', 'font-semibold');
            link.classList.remove('border-transparent', 'text-slate-500', 'dark:text-slate-400');
          } else {
            link.classList.remove('border-[#0047BA]', 'dark:border-sky-400', 'text-[#0047BA]', 'dark:text-sky-300', 'font-semibold');
            link.classList.add('border-transparent', 'text-slate-500', 'dark:text-slate-400');
          }
        });

        // B. Left Sidebar Subheadings
        sidebarSubLinks.forEach((link) => {
          const id = link.dataset.sidebarSubheadingId;
          if (id === activeId) {
            link.classList.add('border-[#0047BA]', 'dark:border-sky-400', 'text-[#0047BA]', 'dark:text-sky-300', 'font-bold');
            link.classList.remove('border-transparent', 'text-slate-600', 'text-slate-500', 'dark:text-slate-300', 'dark:text-slate-400');
          } else {
            link.classList.remove('border-[#0047BA]', 'dark:border-sky-400', 'text-[#0047BA]', 'dark:text-sky-300', 'font-bold');
            link.classList.add('border-transparent');
          }
        });

        // C. Mobile Drawer Subheadings
        mobileSubLinks.forEach((link) => {
          const id = link.dataset.mobileSubheadingId;
          if (id === activeId) {
            link.classList.add('text-[#0047BA]', 'dark:text-sky-300', 'font-bold');
            link.classList.remove('text-slate-500', 'dark:text-slate-400');
          } else {
            link.classList.remove('text-[#0047BA]', 'dark:text-sky-300', 'font-bold');
            link.classList.add('text-slate-500', 'dark:text-slate-400');
          }
        });
      }

      function updateOnPageActive() {
        // If at bottom of page, activate the last heading
        const scrollBottom = window.innerHeight + window.scrollY;
        const totalHeight = document.documentElement.scrollHeight;
        if (scrollBottom >= totalHeight - 50) {
          applyActiveHeading(headingElements[headingElements.length - 1].id);
          return;
        }

        // Find the current heading via getBoundingClientRect (reliable in flex/grid layouts)
        // Header is h-16 (64px) + margin, so threshold of 140px aligns with sticky header
        let currentActiveId = headingElements[0].id;
        for (let i = 0; i < headingElements.length; i++) {
          const el = headingElements[i];
          const rect = el.getBoundingClientRect();
          if (rect.top <= 140) {
            currentActiveId = el.id;
          } else {
            break;
          }
        }

        applyActiveHeading(currentActiveId);
      }

      // Smooth scroll click handler for all heading links
      const allSubheadingLinks = document.querySelectorAll<HTMLAnchorElement>('.on-page-link, .sidebar-subheading-link, .mobile-subheading-link');
      allSubheadingLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          if (href && href.startsWith('#')) {
            const targetId = href.substring(1);
            const targetEl = document.getElementById(targetId);
            if (targetEl) {
              e.preventDefault();
              history.pushState(null, '', `#${targetId}`);
              targetEl.scrollIntoView({ behavior: 'smooth' });
              applyActiveHeading(targetId);

              // Close mobile drawer if open
              if (mobileDrawer && !mobileDrawer.classList.contains('hidden')) {
                mobileDrawer.classList.add('hidden');
              }
            }
          }
        });
      });

      window.addEventListener('scroll', updateOnPageActive, { passive: true });
      window.addEventListener('hashchange', () => {
        if (window.location.hash) {
          applyActiveHeading(window.location.hash.substring(1));
        }
      });

      // Initial check (respect URL hash or run scrollspy)
      if (window.location.hash) {
        const hashId = window.location.hash.substring(1);
        if (document.getElementById(hashId)) {
          applyActiveHeading(hashId);
          setTimeout(() => {
            const el = document.getElementById(hashId);
            if (el) el.scrollIntoView({ behavior: 'smooth' });
          }, 100);
        } else {
          updateOnPageActive();
        }
      } else {
        updateOnPageActive();
      }
    }
  }

  document.addEventListener('astro:page-load', initCollegeDocs);
  if (document.readyState !== 'loading') {
    initCollegeDocs();
  } else {
    document.addEventListener('DOMContentLoaded', initCollegeDocs);
  }
</script>

