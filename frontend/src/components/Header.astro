---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { href: '/', label: 'หน้าแรก' },
  { href: '/about/', label: 'เกี่ยวกับวิทยาลัย' },
  { href: '/services/', label: 'หลักสูตร & บริการ' },
  { href: '/news/', label: 'ข่าวสารและกิจกรรม' },
  { href: '/contact/', label: 'ติดต่อเรา' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-blue-100 shadow-sm transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo & Brand -->
      <a href="/" class="flex items-center gap-3.5 group focus:outline-none focus:ring-2 focus:ring-blue-600 rounded-lg p-1">
        <div class="w-12 h-12 rounded-full overflow-hidden group-hover:scale-105 transition-transform duration-300 flex items-center justify-center shrink-0">
          <img
            src="/logo/LOGO_SERIRACHA_COLOR_FULL.png"
            alt="ตราสัญลักษณ์ วิทยาลัยเทคโนโลยีศรีราชา"
            class="w-full h-full object-contain"
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-bold tracking-tight text-[#003893] group-hover:text-[#0047ba] transition-colors leading-snug">
            วิทยาลัยเทคโนโลยีศรีราชา
          </span>
          <span class="text-[10px] uppercase tracking-wider text-blue-600 font-semibold">
            SERIRACHA TECHNOLOGY COLLEGE
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
                active
                  ? 'text-[#0047ba] bg-blue-50 font-bold border border-blue-200/80 shadow-xs'
                  : 'text-slate-700 hover:text-[#0047ba] hover:bg-blue-50/60'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- CTA Button -->
      <div class="hidden md:flex items-center gap-4">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-[#0047ba] hover:bg-[#003893] rounded-lg shadow-md shadow-blue-600/25 transition-all duration-200 hover:shadow-blue-600/40 hover:-translate-y-0.5"
        >
          ติดต่อสอบถาม
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-lg text-slate-700 hover:text-[#0047ba] hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-600"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg id="menu-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-6 space-y-2 border-t border-blue-100 bg-white shadow-lg">
    {navLinks.map((link) => {
      const active = isActive(link.href);
      return (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-lg text-base font-medium transition-colors ${
            active
              ? 'text-[#0047ba] bg-blue-50 font-bold border border-blue-200'
              : 'text-slate-700 hover:text-[#0047ba] hover:bg-blue-50/60'
          }`}
        >
          {link.label}
        </a>
      );
    })}
    <div class="pt-4">
      <a
        href="/contact/"
        class="block w-full text-center px-4 py-3 text-base font-semibold text-white bg-[#0047ba] hover:bg-[#003893] rounded-lg shadow-md"
      >
        ติดต่อสอบถาม
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (btn && menu && menuIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        menu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        menu.classList.remove('hidden');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  }
</script>
