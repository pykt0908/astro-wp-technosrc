---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

interface SubItem {
  label: string;
  href: string;
}

interface MegaColumn {
  title: string;
  icon: string;
  items: SubItem[];
}

interface NavItem {
  label: string;
  href: string;
  children?: SubItem[];
  megaColumns?: MegaColumn[];
}

const navItems: NavItem[] = [
  {
    label: "เกี่ยวกับเรา",
    href: "/about/",
    megaColumns: [
      {
        title: "แนะนำวิทยาลัย",
        icon: `<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M4.5 2.25a.75.75 0 00-.75.75v18c0 .414.336.75.75.75h15a.75.75 0 00.75-.75V3a.75.75 0 00-.75-.75H4.5ZM6 6.75A.75.75 0 016.75 6h1.5A.75.75 0 019 6.75v1.5A.75.75 0 018.25 9h-1.5A.75.75 0 016 8.25v-1.5Zm4.5 0A.75.75 0 0111.25 6h1.5a.75.75 0 01.75.75v1.5a.75.75 0 01-.75.75h-1.5a.75.75 0 01-.75-.75v-1.5Zm4.5 0A.75.75 0 0115.75 6h1.5a.75.75 0 01.75.75v1.5a.75.75 0 01-.75.75h-1.5a.75.75 0 01-.75-.75v-1.5ZM6 12.75a.75.75 0 01.75-.75h1.5a.75.75 0 01.75.75v1.5a.75.75 0 01-.75.75h-1.5a.75.75 0 01-.75-.75v-1.5Zm4.5 0a.75.75 0 01.75-.75h1.5a.75.75 0 01.75.75v1.5a.75.75 0 01-.75.75h-1.5a.75.75 0 01-.75-.75v-1.5Zm4.5 0a.75.75 0 01.75-.75h1.5a.75.75 0 01.75.75v1.5a.75.75 0 01-.75.75h-1.5a.75.75 0 01-.75-.75v-1.5ZM9.75 18a.75.75 0 00-.75.75v2.25h6v-2.25a.75.75 0 00-.75-.75h-4.5Z" clip-rule="evenodd" /></svg>`,
        items: [
          { label: "ประวัติความเป็นมา", href: "/about/history/" },
          { label: "ปรัชญาและอัตลักษณ์", href: "/about/philosophy/" },
          { label: "โครงสร้างการบริหาร", href: "/about/#structure" },
          { label: "แผนที่และการเดินทาง", href: "/contact/" },
        ],
      },
      {
        title: "ข้อมูลสารสนเทศวิทยาลัย",
        icon: `<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M3 13.25C3 12.56 3.56 12 4.25 12h2.5c.69 0 1.25.56 1.25 1.25v6.5c0 .69-.56 1.25-1.25 1.25h-2.5C3.56 21 3 20.44 3 19.75v-6.5Zm7-6.5C10 6.06 10.56 5.5 11.25 5.5h2.5c.69 0 1.25.56 1.25 1.25v13c0 .69-.56 1.25-1.25 1.25h-2.5c-.69 0-1.25-.56-1.25-1.25v-13Zm7 3.5c0-.69.56-1.25 1.25-1.25h2.5c.69 0 1.25.56 1.25 1.25v9.5c0 .69-.56 1.25-1.25 1.25h-2.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" /></svg>`,
        items: [
          { label: "ข้อมูลพื้นฐานสถานศึกษา", href: "/about/" },
          { label: "สารสนเทศทางการศึกษา", href: "/about/" },
          { label: "รายงานประเมินตนเอง (SAR)", href: "/downloads/" },
          { label: "กฎระเบียบและข้อบังคับ", href: "/downloads/" },
        ],
      },
      {
        title: "อัตลักษณ์และสัญลักษณ์",
        icon: `<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M8.603 3.799A4.49 4.49 0 0112 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 013.498 1.307 4.491 4.491 0 011.307 3.497A4.49 4.49 0 0121.75 12a4.49 4.49 0 01-1.549 3.397 4.491 4.491 0 01-1.307 3.497 4.491 4.491 0 01-3.497 1.307A4.49 4.49 0 0112 21.75a4.49 4.49 0 01-3.397-1.549 4.49 4.49 0 01-3.498-1.306 4.491 4.491 0 01-1.307-3.498A4.49 4.49 0 012.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 011.307-3.497 4.49 4.49 0 013.497-1.307Zm7.007 6.387a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25Z" clip-rule="evenodd" /></svg>`,
        items: [
          { label: "ตราสัญลักษณ์และสีประจำวิทยาลัย", href: "/about/" },
          { label: "ปรัชญา ค่านิยม และเอกลักษณ์", href: "/about/philosophy/" },
          { label: "ต้นไม้และดอกไม้ประจำวิทยาลัย", href: "/about/" },
          { label: "เพลงมาร์ชประจำวิทยาลัย", href: "/about/" },
        ],
      },
    ],
  },
  {
    label: "หลักสูตร",
    href: "/services/",
  },
  {
    label: "บุคลากร",
    href: "/about/#staff",
    children: [
      { label: "คณะผู้บริหาร", href: "/about/#executive" },
      { label: "คณาจารย์ประจำสาขา", href: "/about/#teachers" },
      { label: "บุคลากรฝ่ายสนับสนุน", href: "/about/#officers" },
    ],
  },
  {
    label: "นักศึกษา",
    href: "/students/",
    children: [
      { label: "ปฏิทินการศึกษา", href: "/calendar/" },
      { label: "กิจกรรมนักศึกษา", href: "/news/" },
      { label: "คู่มือนักศึกษา & ระเบียบการ", href: "/downloads/" },
    ],
  },
  {
    label: "ดาวน์โหลด",
    href: "/downloads/",
  },
  {
    label: "ติดต่อเรา",
    href: "/contact/",
  },
];

function isItemActive(item: NavItem) {
  if (item.href === "/") return currentPath === "/";
  if (currentPath.startsWith(item.href)) return true;
  if (item.children && item.children.length > 0) {
    return item.children.some(
      (sub) => sub.href !== "#" && (currentPath === sub.href || (sub.href !== "/" && currentPath.startsWith(sub.href)))
    );
  }
  if (item.megaColumns && item.megaColumns.length > 0) {
    return item.megaColumns.some((col) =>
      col.items.some(
        (sub) => sub.href !== "#" && (currentPath === sub.href || (sub.href !== "/" && currentPath.startsWith(sub.href)))
      )
    );
  }
  return false;
}
---

<!-- 1. Top Bar: Website Institutional Deep Navy Bar (#002D72) --><!-- Placed OUTSIDE the sticky <header> so it naturally scrolls away and disappears when scrolling down! -->
<div
  class="top-bar-nav bg-[#002D72] text-white text-xs border-b border-blue-900/80"
>
  <div
    class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-2 md:py-0 md:h-10 flex flex-col md:flex-row md:items-center md:justify-between gap-2 md:gap-4"
  >
    <!-- Row 1 (Mobile) / Left (Desktop): Phone Contact (No 'ชำระเงิน' as requested) -->
    <div class="flex items-center justify-between md:justify-start gap-3">
      <a
        href="tel:038123456"
        class="flex items-center gap-1.5 text-blue-100 hover:text-white transition-colors"
      >
        <svg
          class="w-3.5 h-3.5 text-sky-300 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
          ></path>
        </svg>
        <span class="text-blue-200">โทร: </span>
        <strong class="font-bold text-white tracking-wide">038-123-456</strong>
      </a>
    </div>

    <!-- Row 2 (Mobile) / Right (Desktop): Search Input + Line Badge + Operating Hours -->
    <div
      class="flex items-center justify-between md:justify-end gap-2.5 sm:gap-4 lg:gap-6"
    >
      <!-- Search Box (Visible on mobile as shown in reference image, and on desktop) -->
      <div class="relative flex-1 md:flex-initial">
        <input
          id="top-search-input"
          type="text"
          placeholder="ค้นหาผลงาน, บริการ, บทความ..."
          class="w-full md:w-56 lg:w-64 xl:w-72 bg-white text-slate-800 placeholder-slate-400 text-xs rounded-md pl-3 pr-8 py-1.5 focus:outline-none focus:ring-1 focus:ring-blue-400 shadow-xs"
        />
        <button
          type="button"
          aria-label="Search"
          class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-[#0047BA]"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>
      </div>

      <!-- Operating Hours (Desktop only) -->
      <div
        class="hidden lg:flex items-center gap-1.5 text-blue-100 text-xs shrink-0"
      >
        <svg
          class="w-3.5 h-3.5 text-sky-300"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>ทุกวัน 8:30-16:30 น.</span>
      </div>

      <!-- Line Official Button -->
      <a
        href="https://line.me"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 bg-[#06C755] hover:bg-[#05b34c] text-white text-[11px] font-bold px-3 py-1 rounded-full shadow-xs transition-colors shrink-0"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path
            d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.477.254l2.484 3.374V8.108c0-.345.282-.63.628-.63.349 0 .628.285.628.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"
          ></path>
        </svg>
        <span>@sriracha</span>
      </a>
    </div>
  </div>
</div>

<!-- 2. Sticky Header: ONLY the clean white navbar sticks when scrolling down -->
<header class="sticky top-0 z-50 w-full bg-white dark:bg-slate-900 shadow-xs dark:shadow-slate-950/40 transition-colors duration-200">
  <div class="border-b border-slate-200 dark:border-slate-800">
    <div
      class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-2 sm:gap-4"
    >
      <!-- Brand Logo & Title -->
      <!-- No hover color change on name, Logo does NOT move or scale! -->
      <a
        href="/"
        class="flex items-center gap-2 sm:gap-3 focus:outline-none min-w-0 flex-1 xl:flex-initial"
        title="หน้าแรก - วิทยาลัยเทคโนโลยีศรีราชา"
        aria-label="หน้าแรก - วิทยาลัยเทคโนโลยีศรีราชา"
      >
        <div
          class="w-9 h-9 sm:w-11 sm:h-11 rounded-full overflow-hidden flex items-center justify-center shrink-0 bg-white p-0.5"
        >
          <img
            src="/logo/LOGO_SERIRACHA_COLOR_FULL.png"
            alt="วิทยาลัยเทคโนโลยีศรีราชา"
            class="w-full h-full object-contain"
            loading="eager"
          />
        </div>
        <div class="flex flex-col min-w-0">
          <span
            class="text-sm sm:text-base lg:text-lg font-bold text-slate-900 dark:text-white leading-tight truncate"
          >
            วิทยาลัยเทคโนโลยีศรีราชา
          </span>
          <span
            class="text-[10px] sm:text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 font-medium leading-tight mt-0.5 hidden sm:block truncate"
          >
            SRIRACHA TECHNOLOGICAL COLLEGE
          </span>
        </div>
      </a>

      <!-- Desktop Nav Items: Displayed on >= xl (1280px) -->
      <nav
        class="hidden xl:flex items-center gap-5 2xl:gap-7 text-sm font-semibold text-slate-800 dark:text-slate-200"
      >
        {
          navItems.map((item) => {
            const active = isItemActive(item);
            const hasChildren = (item.children && item.children.length > 0) || (item.megaColumns && item.megaColumns.length > 0);
            const isMega = item.megaColumns && item.megaColumns.length > 0;

            return (
              <div class="relative nav-item-dropdown group/menu py-2">
                <a
                  href={item.href}
                  class={`inline-flex items-center gap-1 transition-colors ${
                    active
                      ? "text-[#0047BA] dark:text-blue-400 font-bold"
                      : "text-slate-800 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400"
                  }`}
                >
                  <span>{item.label}</span>
                  {hasChildren && (
                    <svg
                      class="nav-chevron-icon w-3.5 h-3.5 text-slate-400 dark:text-slate-500 group-hover/menu:text-[#0047BA] dark:group-hover/menu:text-blue-400 transition-transform duration-200 group-hover/menu:rotate-180"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  )}
                </a>

                {/* Regular Submenu */}
                {!isMega && item.children && item.children.length > 0 && (
                  <div class="nav-dropdown-panel absolute left-0 top-full pt-1 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible transition-all duration-200 pointer-events-none group-hover/menu:pointer-events-auto z-50">
                    <div class="w-60 bg-white dark:bg-slate-900 rounded-xl shadow-xl border border-slate-100 dark:border-slate-800 p-2 space-y-1">
                      {item.children.map((sub) => (
                        <a
                          href={sub.href}
                          class="block px-4 py-2.5 text-sm font-semibold text-slate-700 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 hover:bg-blue-50/80 dark:hover:bg-slate-800 rounded-lg transition-colors"
                        >
                          {sub.label}
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {/* 3-Column Mega Menu */}
                {isMega && item.megaColumns && (
                  <div class="nav-dropdown-panel absolute left-0 top-full pt-1 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible transition-all duration-200 pointer-events-none group-hover/menu:pointer-events-auto z-50">
                    <div class="w-[820px] max-w-[calc(100vw-2rem)] bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-100 dark:border-slate-800 p-6 overflow-hidden ring-1 ring-slate-900/5 dark:ring-white/10">
                      <div class="grid grid-cols-3 gap-6">
                        {item.megaColumns.map((col) => (
                          <div class="space-y-3">
                            <!-- Column Title with Icon -->
                            <div class="flex items-center gap-2 pb-2.5 border-b border-slate-100 dark:border-slate-800">
                              <span class="text-slate-900 dark:text-white flex items-center justify-center shrink-0">
                                <Fragment set:html={col.icon} />
                              </span>
                              <h4 class="text-sm font-bold text-slate-900 dark:text-white leading-tight">
                                {col.title}
                              </h4>
                            </div>

                            <!-- Column Sub-items -->
                            <ul class="space-y-1">
                              {col.items.map((sub) => (
                                <li>
                                  <a
                                    href={sub.href}
                                    class="group/item flex items-center gap-2.5 py-2 px-2.5 rounded-lg text-sm font-semibold text-slate-700 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 hover:bg-blue-50/80 dark:hover:bg-slate-800 transition-colors"
                                  >
                                    <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-slate-600 group-hover/item:bg-[#0047BA] dark:group-hover/item:bg-blue-400 transition-colors shrink-0" />
                                    <span>{sub.label}</span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                )}
              </div>
            );
          })
        }
      </nav>

      <!-- Right Controls: Exactly as in user's mobile screenshot: [🔍] [🌙] [🌐 TH ⌵] [☰] -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <!-- 1. Search Icon Button -->
        <button
          id="navbar-search-btn"
          type="button"
          aria-label="Search"
          class="w-8.5 h-8.5 sm:w-9 sm:h-9 lg:w-10 lg:h-10 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-300 hover:text-[#0047BA] dark:hover:text-blue-400 hover:border-slate-300 dark:hover:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors shadow-2xs"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>

        <!-- 2. Moon / Sun Theme Toggle Button -->
        <button
          id="theme-toggle-btn"
          type="button"
          aria-label="Toggle Theme"
          title="สลับโหมดมืด/สว่าง (Light/Dark Mode)"
          class="w-8.5 h-8.5 sm:w-9 sm:h-9 lg:w-10 lg:h-10 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-amber-400 hover:text-[#0047BA] dark:hover:text-amber-300 hover:border-slate-300 dark:hover:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors shadow-2xs cursor-pointer"
        >
          <!-- Moon Icon (Visible in Light mode) -->
          <svg
            id="theme-moon-icon"
            class="w-4 h-4 block dark:hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
          <!-- Sun Icon (Visible in Dark mode) -->
          <svg
            id="theme-sun-icon"
            class="w-4 h-4 hidden dark:block"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
        </button>

        <!-- 3. Language Selector Button (🌐 TH ⌵) -->
        <div class="relative group/lang">
          <button
            type="button"
            class="h-8.5 sm:h-9 lg:h-10 px-2 sm:px-2.5 lg:px-3 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 flex items-center gap-1 sm:gap-1.5 text-xs font-bold text-slate-700 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 hover:border-slate-300 dark:hover:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors shadow-2xs"
          >
            <svg
              class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-slate-500 dark:text-slate-400 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
              ></path>
            </svg>
            <span>TH</span>
            <svg
              class="w-3 h-3 text-slate-400 dark:text-slate-500 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
        </div>

        <!-- Desktop CTA Button: 'สมัครเรียน' (On >= xl desktop screen) -->
        <a
          href="/contact/"
          class="hidden xl:inline-flex h-9 sm:h-10 px-4 xl:px-5 rounded-md bg-[#EA580C] hover:bg-[#C2410C] active:bg-[#9A3412] text-white text-xs sm:text-sm font-bold shadow-md shadow-orange-600/25 transition-all duration-200 hover:-translate-y-0.5 items-center justify-center whitespace-nowrap ml-1"
        >
          สมัครเรียน
        </a>

        <!-- 4. Mobile / Tablet Hamburger Toggle Button (☰) -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="xl:hidden w-8.5 h-8.5 sm:w-9 sm:h-9 rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-700 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-[#0047BA]/30 transition-colors shadow-2xs"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg
            id="menu-icon"
            class="w-4 h-4 sm:w-5 sm:h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="close-icon"
            class="w-4 h-4 sm:w-5 sm:h-5 hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- 3. Mobile / Tablet Dropdown Menu Drawer (Visible on < xl when opened) -->
  <div
    id="mobile-menu"
    class="hidden xl:hidden bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-4 py-4 space-y-3 shadow-2xl max-h-[calc(100dvh-4.5rem)] overflow-y-auto overscroll-contain transition-all"
    style="display: none;"
  >
    <!-- Top Action in Drawer: Prominent CTA Button on Mobile -->
    <a
      href="/contact/"
      class="xl:hidden w-full flex items-center justify-center gap-2 py-3 px-4 rounded-md bg-[#EA580C] hover:bg-[#C2410C] text-white text-sm font-bold shadow-md shadow-orange-600/25 transition-colors mb-2"
    >
      <span>สมัครเรียน / ติดต่อสอบถาม</span>
      <svg
        class="w-4 h-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </a>

    <!-- Mobile Quick Search -->
    <div class="relative mb-2">
      <input
        type="text"
        placeholder="ค้นหาหลักสูตร, ข่าวสาร, บทความ..."
        class="w-full bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 placeholder-slate-400 text-xs rounded-md pl-3.5 pr-9 py-2.5 border border-slate-200 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-[#0047BA]/20 focus:border-[#0047BA]"
      />
      <button
        type="button"
        aria-label="Search"
        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-[#0047BA]"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </button>
    </div>

    <!-- Navigation List with Native Collapsible Accordions -->
    <nav class="space-y-1" aria-label="Mobile Navigation">
      {
        navItems.map((item) => {
          const active = isItemActive(item);
          const hasChildren = (item.children && item.children.length > 0) || (item.megaColumns && item.megaColumns.length > 0);
          const isMega = item.megaColumns && item.megaColumns.length > 0;

          if (hasChildren) {
            return (
              <details class="group/acc rounded-md overflow-hidden border border-slate-100 dark:border-slate-800">
                <summary
                  class={`flex items-center justify-between px-3.5 py-2.5 rounded-md text-sm font-semibold transition-colors cursor-pointer select-none list-none ${
                    active
                      ? "text-[#0047BA] dark:text-blue-400 bg-blue-50/70 dark:bg-blue-950/40 font-bold"
                      : "text-slate-800 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800"
                  }`}
                >
                  <span>{item.label}</span>
                  <svg
                    class="w-4 h-4 text-slate-400 dark:text-slate-500 transition-transform duration-200 group-open/acc:rotate-180"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>

                {isMega && item.megaColumns ? (
                  <div class="px-3 py-2 space-y-3 bg-slate-50/60 dark:bg-slate-800/60 rounded-b-md border-t border-slate-100 dark:border-slate-700">
                    {item.megaColumns.map((col) => (
                      <div class="space-y-1.5 pb-2.5 border-b border-slate-200/50 dark:border-slate-700/50 last:border-b-0 last:pb-0">
                        <div class="flex items-center gap-2 text-xs font-bold text-slate-900 dark:text-white">
                          <span class="text-slate-900 dark:text-white flex items-center justify-center shrink-0">
                            <Fragment set:html={col.icon} />
                          </span>
                          <span>{col.title}</span>
                        </div>
                        <div class="pl-4 space-y-1">
                          {col.items.map((sub) => (
                            <a
                              href={sub.href}
                              class="block px-3 py-1.5 text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-[#0047BA] dark:hover:text-blue-400 hover:bg-blue-50/80 dark:hover:bg-slate-700/80 rounded-md transition-colors"
                            >
                              • {sub.label}
                            </a>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                ) : (
                  <div class="pl-4 pr-2 py-1.5 space-y-1 bg-slate-50/60 dark:bg-slate-800/60 rounded-b-md border-t border-slate-100 dark:border-slate-700">
                    {item.children?.map((sub) => (
                      <a
                        href={sub.href}
                        class="block px-3 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-[#0047BA] dark:hover:text-blue-400 hover:bg-blue-50/80 dark:hover:bg-slate-700/80 rounded-md transition-colors"
                      >
                        • {sub.label}
                      </a>
                    ))}
                  </div>
                )}
              </details>
            );
          }

          return (
            <a
              href={item.href}
              class={`block px-3.5 py-2.5 rounded-md text-sm font-semibold transition-colors ${
                active
                  ? "text-[#0047BA] dark:text-blue-400 bg-blue-50/70 dark:bg-blue-950/40 font-bold"
                  : "text-slate-800 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Mobile Contact & Hours Info -->
    <div
      class="pt-3 border-t border-slate-100 dark:border-slate-800 flex flex-col gap-2 text-xs text-slate-600 dark:text-slate-400"
    >
      <div class="flex items-center gap-2">
        <span class="text-slate-500 dark:text-slate-400">โทรติดต่อ:</span>
        <strong class="text-slate-800 dark:text-slate-200 font-bold">038-123-456</strong>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-slate-500 dark:text-slate-400">เวลาทำการ:</span>
        <span>จ.-ศ. 8:30-16:30 น.</span>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById(
      "mobile-menu-btn",
    ) as HTMLElement | null;
    const menu = document.getElementById("mobile-menu") as HTMLElement | null;
    const menuIcon = document.getElementById("menu-icon") as HTMLElement | null;
    const closeIcon = document.getElementById(
      "close-icon",
    ) as HTMLElement | null;
    const searchBtn = document.getElementById(
      "navbar-search-btn",
    ) as HTMLElement | null;

    if (!btn || !menu || !menuIcon || !closeIcon) return;

    const navMenu = menu;
    const navBtn = btn;
    const navMenuIcon = menuIcon;
    const navCloseIcon = closeIcon;

    function openMenu() {
      navMenu.style.display = "block";
      navMenu.classList.remove("hidden");
      navMenuIcon.classList.add("hidden");
      navCloseIcon.classList.remove("hidden");
      navBtn.setAttribute("aria-expanded", "true");
      document.body.classList.add("overflow-hidden", "xl:overflow-auto");
    }

    function closeMenu() {
      navMenu.style.display = "none";
      navMenu.classList.add("hidden");
      navMenuIcon.classList.remove("hidden");
      navCloseIcon.classList.add("hidden");
      navBtn.setAttribute("aria-expanded", "false");
      document.body.classList.remove("overflow-hidden", "xl:overflow-auto");
    }

    // Always reset to closed state on initial load or route transition
    closeMenu();

    // Toggle click handler
    navBtn.onclick = (e) => {
      e.stopPropagation();
      const isClosed =
        navMenu.classList.contains("hidden") ||
        navMenu.style.display === "none";
      if (isClosed) {
        openMenu();
      } else {
        closeMenu();
      }
    };

    // Clicking Search button in navbar focuses search
    if (searchBtn) {
      searchBtn.onclick = (e) => {
        e.stopPropagation();
        if (window.innerWidth < 1280) {
          openMenu();
          const searchInput = navMenu.querySelector(
            "input",
          ) as HTMLInputElement | null;
          if (searchInput) {
            setTimeout(() => searchInput.focus(), 100);
          }
        } else {
          const topSearch = document.getElementById(
            "top-search-input",
          ) as HTMLInputElement | null;
          if (topSearch) {
            topSearch.focus();
          }
        }
      };
    }

    // Close when clicking any link inside the menu
    navMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    // Close on click outside
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!navBtn.contains(target) && !navMenu.contains(target)) {
        closeMenu();
      }
    });

    // Close on ESC key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeMenu();
      }
    });
  }

  function setupThemeToggle() {
    const toggleBtn = document.getElementById("theme-toggle-btn");
    if (!toggleBtn) return;

    toggleBtn.onclick = (e) => {
      e.stopPropagation();
      const isDark = document.documentElement.classList.toggle("dark");
      if (isDark) {
        document.documentElement.setAttribute("data-theme", "dark");
        localStorage.setItem("theme", "dark");
      } else {
        document.documentElement.setAttribute("data-theme", "light");
        localStorage.setItem("theme", "light");
      }
    };
  }

  // Initial runs
  setupMobileMenu();
  setupThemeToggle();

  // Astro View Transitions hooks
  document.addEventListener("astro:page-load", () => {
    setupMobileMenu();
    setupThemeToggle();
  });

  document.addEventListener("astro:after-swap", () => {
    try {
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (stored === "dark" || (!stored && prefersDark)) {
        document.documentElement.classList.add("dark");
        document.documentElement.setAttribute("data-theme", "dark");
      } else {
        document.documentElement.classList.remove("dark");
        document.documentElement.setAttribute("data-theme", "light");
      }
    } catch (_) {}
  });
</script>
