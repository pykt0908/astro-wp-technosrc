---
import SeoHead from '../components/SeoHead.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'ศูนย์คู่มือและระเบียบการนักศึกษา วิทยาลัยเทคโนโลยีศรีราชา',
  canonical,
  image,
  type = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="th" class="scroll-smooth">
  <head>
    <!-- Prevent Theme Flash (FOUC) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (_) {}
      })();
    </script>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
    />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white dark:bg-[#0b0f19] text-slate-800 dark:text-slate-100 flex flex-col min-h-screen selection:bg-[#0047BA] selection:text-white font-sans antialiased">
    
    <!-- ================= COLLEGE DOCS APP HEADER (MODERN 3-SECTION NAVBAR) ================= -->
    <header class="sticky top-0 z-40 w-full h-16 bg-white/95 dark:bg-[#0b0f19]/95 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800">
      <div class="w-full max-w-[1600px] mx-auto h-full px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
        
        <!-- Left: College Logo, Title & Mobile Trigger -->
        <div class="flex items-center gap-3 shrink-0">
          <!-- Mobile Sidebar Toggle -->
          <button
            type="button"
            id="docs-mobile-menu-btn"
            class="lg:hidden p-2 -ml-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            aria-label="เปิดสารบัญคู่มือ"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>

          <!-- College Identity Brand -->
          <a href="/students/handbook/" class="flex items-center gap-2.5 sm:gap-3 group">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full overflow-hidden flex items-center justify-center shrink-0 bg-white p-0.5 border border-slate-200 dark:border-slate-700 shadow-2xs">
              <img
                src="/logo/LOGO_SERIRACHA_COLOR_FULL.png"
                alt="วิทยาลัยเทคโนโลยีศรีราชา"
                class="w-full h-full object-contain"
                loading="eager"
              />
            </div>
            <div class="flex flex-col">
              <span class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-tight group-hover:text-[#0047BA] dark:group-hover:text-sky-400 transition-colors">
                วิทยาลัยเทคโนโลยีศรีราชา
              </span>
              <span class="text-[11px] sm:text-xs font-semibold text-[#0047BA] dark:text-sky-400 leading-tight">
                คู่มือและระเบียบการนักศึกษา
              </span>
            </div>
          </a>
        </div>

        <!-- Center: Clean Centered Search Pill (⌘K) -->
        <div class="flex-1 max-w-md mx-auto hidden sm:block">
          <button
            type="button"
            id="docs-top-search-btn"
            class="w-full flex items-center justify-between px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200/70 dark:bg-slate-800/80 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 text-xs sm:text-sm transition-all cursor-pointer border border-slate-200/60 dark:border-slate-700/60 shadow-2xs group"
          >
            <div class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-slate-400 group-hover:text-[#0047BA] dark:group-hover:text-sky-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <span>ค้นหาข้อบังคับ ระเบียบการ...</span>
            </div>
            <kbd class="inline-flex items-center gap-0.5 px-1.5 py-0.5 text-[10px] font-mono font-semibold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded text-slate-400 shadow-2xs">
              ⌘K
            </kbd>
          </button>
        </div>

        <!-- Right: Academic Year Selector, Theme Toggle, Main Website Link -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          

          <!-- Dark/Light Theme Toggle -->
          <button
            type="button"
            id="docs-theme-toggle"
            onclick="window.toggleDocsTheme && window.toggleDocsTheme()"
            class="h-9 px-2.5 sm:px-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/90 hover:bg-slate-50 dark:hover:bg-slate-700/80 text-slate-700 dark:text-amber-400 hover:border-slate-300 dark:hover:border-slate-600 transition-all flex items-center gap-1.5 sm:gap-2 text-xs font-semibold shadow-2xs cursor-pointer select-none"
            title="สลับโหมดมืด/สว่าง (Light / Dark Mode)"
            aria-label="สลับโหมดมืด/สว่าง"
          >
            <!-- Moon icon (shown in light mode) -->
            <svg class="w-4 h-4 block dark:hidden text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
            <!-- Sun icon (shown in dark mode) -->
            <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            <span class="inline dark:hidden text-slate-700 font-medium">สว่าง</span>
            <span class="hidden dark:inline text-amber-300 font-medium">มืด</span>
          </button>

          <!-- Back to Main College Site -->
          <a
            href="/"
            class="h-9 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 hover:text-[#0047BA] dark:text-slate-300 dark:hover:text-sky-400 bg-slate-100 hover:bg-blue-50 dark:bg-slate-800 dark:hover:bg-slate-700/80 transition-colors"
            title="กลับสู่หน้าหลักวิทยาลัย"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
            <span class="hidden sm:inline">หน้าหลักวิทยาลัย</span>
          </a>

        </div>

      </div>
    </header>

    <!-- Main Docs Content Slot -->
    <main class="flex-grow w-full">
      <slot />
    </main>

    <!-- Client-side Global Scripts for Docs Layout Theme Toggle -->
    <script is:inline>
      (function() {
        function applyTheme(theme) {
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
            localStorage.setItem('theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
            localStorage.setItem('theme', 'light');
          }
        }

        window.toggleDocsTheme = function() {
          const isDark = document.documentElement.classList.contains('dark');
          applyTheme(isDark ? 'light' : 'dark');
        };

        function syncThemeFromStorage() {
          try {
            const stored = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (stored === 'dark' || (!stored && prefersDark)) {
              document.documentElement.classList.add('dark');
              document.documentElement.setAttribute('data-theme', 'dark');
            } else {
              document.documentElement.classList.remove('dark');
              document.documentElement.setAttribute('data-theme', 'light');
            }
          } catch (_) {}
        }

        // Astro View Transitions sync
        document.addEventListener('astro:after-swap', syncThemeFromStorage);
        document.addEventListener('astro:page-load', function() {
          const btn = document.getElementById('docs-theme-toggle');
          if (btn) {
            btn.onclick = function(e) {
              e.preventDefault();
              window.toggleDocsTheme();
            };
          }
          const mobileBtn = document.getElementById('docs-mobile-theme-toggle');
          if (mobileBtn) {
            mobileBtn.onclick = function(e) {
              e.preventDefault();
              window.toggleDocsTheme();
            };
          }
        });
      })();
    </script>
  </body>
</html>
