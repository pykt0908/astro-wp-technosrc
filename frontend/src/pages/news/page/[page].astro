---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsCard from '../../../components/NewsCard.astro';
import { getAllPublishedPosts, getCategories } from '../../../lib/wordpress';
import type { Post } from '../../../types/wordpress';

export const getStaticPaths = (async () => {
  const POSTS_PER_PAGE = 6;
  const allPosts = await getAllPublishedPosts();
  const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);

  // Generate routes only for page 2 and beyond (/news/ is page 1)
  if (totalPages <= 1) {
    return [];
  }

  const paths = [];
  for (let p = 2; p <= totalPages; p++) {
    const startIndex = (p - 1) * POSTS_PER_PAGE;
    const pagePosts = allPosts.slice(startIndex, startIndex + POSTS_PER_PAGE);
    paths.push({
      params: { page: String(p) },
      props: {
        posts: pagePosts,
        currentPage: p,
        totalPages,
        totalPosts: allPosts.length,
      },
    });
  }

  return paths;
}) satisfies GetStaticPaths;

interface Props {
  posts: Post[];
  currentPage: number;
  totalPages: number;
  totalPosts: number;
}

const { posts, currentPage, totalPages, totalPosts } = Astro.props;
const categories = await getCategories();

const prevUrl = currentPage === 2 ? '/news/' : `/news/page/${currentPage - 1}/`;
const nextUrl = currentPage < totalPages ? `/news/page/${currentPage + 1}/` : null;
---

<BaseLayout
  title={`ข่าวสารและกิจกรรม - หน้า ${currentPage} | วิทยาลัยเทคโนโลยีศรีราชา`}
  description={`ติดตามข่าวสารและกิจกรรมจากวิทยาลัยเทคโนโลยีศรีราชา หน้าที่ ${currentPage}`}
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-3 py-1 rounded-full bg-blue-100 text-[#003893] text-xs font-semibold tracking-wider uppercase mb-3">
        ข่าวสาร & ประกาศ
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 mt-2 tracking-tight">
        ข่าวสารและกิจกรรมล่าสุด (หน้า {currentPage})
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        ติดตามความเคลื่อนไหว กิจกรรมวิชาการ และข่าวประชาสัมพันธ์ของวิทยาลัยเทคโนโลยีศรีราชา
      </p>

      {categories.length > 0 && (
        <div class="mt-8 flex flex-wrap justify-center gap-2">
          <a href="/news/" class="px-4 py-1.5 rounded-full text-xs font-bold bg-[#0047BA] text-white shadow-sm">
            ทั้งหมด ({totalPosts})
          </a>
          {categories.map((cat) => (
            <span class="px-4 py-1.5 rounded-full text-xs font-medium bg-white text-slate-700 border border-slate-200 shadow-xs">
              {cat.name} ({cat.count})
            </span>
          ))}
        </div>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => (
        <NewsCard post={post} />
      ))}
    </div>

    <!-- Pagination Controls -->
    <nav class="mt-16 flex items-center justify-center gap-2" aria-label="Pagination">
      <a
        href={prevUrl}
        class="px-4 py-2 text-sm font-medium text-slate-700 bg-white hover:bg-blue-50 border border-slate-200 rounded-lg transition-colors inline-flex items-center gap-1"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>ก่อนหน้า</span>
      </a>

      <a
        href="/news/"
        class="px-4 py-2 text-sm font-medium text-slate-700 bg-white hover:bg-blue-50 border border-slate-200 rounded-lg transition-colors"
      >
        1
      </a>

      {Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((pageNum) => (
        pageNum === currentPage ? (
          <span class="px-4 py-2 text-sm font-bold text-white bg-[#0047BA] rounded-lg shadow-sm">
            {pageNum}
          </span>
        ) : (
          <a
            href={`/news/page/${pageNum}/`}
            class="px-4 py-2 text-sm font-medium text-slate-700 bg-white hover:bg-blue-50 border border-slate-200 rounded-lg transition-colors"
          >
            {pageNum}
          </a>
        )
      ))}

      {nextUrl && (
        <a
          href={nextUrl}
          class="px-4 py-2 text-sm font-medium text-slate-700 bg-white hover:bg-blue-50 border border-slate-200 rounded-lg transition-colors inline-flex items-center gap-1"
        >
          <span>ถัดไป</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      )}
    </nav>
  </div>
</BaseLayout>
