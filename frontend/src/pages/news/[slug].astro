---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getAllPublishedPosts } from '../../lib/wordpress';
import type { Post } from '../../types/wordpress';

export const getStaticPaths = (async () => {
  const allPosts = await getAllPublishedPosts();

  return allPosts.map((post) => {
    // Find up to 3 related posts (excluding current post)
    const relatedPosts = allPosts
      .filter((p) => p.id !== post.id)
      .slice(0, 3);

    return {
      params: { slug: post.slug },
      props: { post, relatedPosts },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  relatedPosts: Post[];
}

const { post, relatedPosts } = Astro.props;

// Date formatting
const dateObj = new Date(post.publishedAt);
const formattedDate = !isNaN(dateObj.getTime())
  ? dateObj.toLocaleDateString('th-TH', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : post.publishedAt;

const fallbackCover = 'https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=1200&auto=format&fit=crop';
---

<BaseLayout
  title={post.seoMetaTitle || post.titlePlain}
  description={post.seoMetaDescription || post.excerptPlain}
  image={post.seoOgImageUrl || post.coverUrl || fallbackCover}
  type="article"
  publishedTime={post.publishedAt}
  modifiedTime={post.modifiedAt}
  articleSection={post.categoryNames?.[0] || 'เทคโนโลยี'}
>
  <article class="py-8 sm:py-14 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 sm:mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] transition-colors">หน้าแรก</a>
      <span>/</span>
      <a href="/news/" class="hover:text-[#0047BA] transition-colors">ข่าวสารและกิจกรรม</a>
      <span>/</span>
      <span class="text-slate-800 font-medium truncate max-w-[180px] sm:max-w-md">{post.titlePlain}</span>
    </nav>

    <!-- Header / Meta -->
    <header class="mb-8 sm:mb-10">
      {post.categoryNames && post.categoryNames.length > 0 && (
        <span class="inline-block px-3 py-1 rounded-md text-xs font-bold bg-blue-100 text-[#003893] mb-4">
          {post.categoryNames[0]}
        </span>
      )}

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 leading-snug tracking-tight">
        {post.titlePlain}
      </h1>

      <div class="mt-4 sm:mt-6 flex flex-wrap items-center gap-3 sm:gap-4 text-xs text-slate-500 border-b border-slate-200 pb-5 sm:pb-6">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#0047BA]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={post.publishedAt}>เผยแพร่เมื่อ: {formattedDate}</time>
        </div>
        <span class="hidden sm:inline">•</span>
        <span>ฝ่ายประชาสัมพันธ์ วิทยาลัยเทคโนโลยีศรีราชา</span>
      </div>
    </header>

    <!-- Featured Image -->
    <div class="mb-8 sm:mb-12 rounded-2xl overflow-hidden aspect-[16/9] bg-slate-100 border border-slate-200 shadow-md">
      <img
        src={post.coverUrl || fallbackCover}
        alt={post.coverAlt || post.titlePlain}
        loading="eager"
        class="w-full h-full object-cover"
        onerror={`this.onerror=null;this.src='${fallbackCover}';`}
      />
    </div>

    <!-- Sanitized Content Body -->
    <div class="wp-content max-w-none bg-white p-5 sm:p-8 md:p-10 rounded-2xl border border-blue-100 shadow-xs" set:html={post.contentHtml} />

    <!-- Photo Album Gallery (if available) -->
    {post.gallery && post.gallery.length > 0 && (
      <section class="mt-8 sm:mt-12 p-6 sm:p-8 bg-white rounded-2xl border border-blue-100 shadow-xs">
        <div class="flex items-center gap-2.5 mb-6">
          <div class="p-2 rounded-lg bg-blue-50 text-[#0047BA]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-slate-900">อัลบั้มภาพกิจกรรม</h2>
            <p class="text-xs text-slate-500">รวมภาพบรรยากาศทั้งหมด ({post.gallery.length} ภาพ)</p>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
          {post.gallery.map((img, idx) => (
            <a
              href={img.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 border border-slate-200/80 shadow-xs hover:shadow-md transition-all duration-300 block focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <img
                src={img.thumbUrl || img.url}
                alt={img.alt || `${post.titlePlain} - ภาพที่ ${idx + 1}`}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white">
                <svg class="w-6 h-6 drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Share / Back to news footer -->
    <div class="mt-14 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
      <a
        href="/news/"
        class="inline-flex items-center gap-2 text-sm font-bold text-[#0047BA] hover:text-[#002D72] transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>กลับไปหน้ารวมข่าวสาร</span>
      </a>
      <div class="flex items-center gap-2 text-xs text-slate-600">
        <span>แชร์บทความนี้:</span>
        <button
          type="button"
          onclick="navigator.clipboard.writeText(window.location.href); alert('คัดลอกลิงก์เรียบร้อยแล้ว');"
          class="px-3.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 font-medium transition-colors"
        >
          คัดลอกลิงก์
        </button>
      </div>
    </div>

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="mt-20 pt-16 border-t border-slate-200">
        <h2 class="text-2xl font-bold text-slate-900 mb-8">บทความที่เกี่ยวข้อง</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPosts.map((related) => (
            <NewsCard post={related} />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
