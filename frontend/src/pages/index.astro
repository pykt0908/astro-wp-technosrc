---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { getPublishedPosts, getBanners } from '../lib/wordpress';

const { posts } = await getPublishedPosts(1, 3);
const banners = await getBanners();
---

<BaseLayout
  title="Technosrc - โซลูชันคลาวด์และดิจิทัลทรานส์ฟอร์เมชันสำหรับธุรกิจคุณ"
  description="ผู้เชี่ยวชาญการพัฒนาระบบคลาวด์ สถาปัตยกรรมซอฟต์แวร์สมัยใหม่ และ Headless CMS เพื่อขับเคลื่อนธุรกิจสู่ความสำเร็จ"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-20 pb-28 lg:pt-28 lg:pb-36">
    <!-- Glow backgrounds -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-sky-600/20 to-indigo-600/20 blur-[130px] rounded-full pointer-events-none"></div>
    <div class="absolute -top-24 left-10 w-96 h-96 bg-sky-500/10 blur-[100px] rounded-full pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-semibold mb-8 animate-pulse">
        <span class="w-2 h-2 rounded-full bg-sky-400"></span>
        Modern Cloud & Headless Architecture
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.15] max-w-4xl mx-auto">
        ขับเคลื่อนธุรกิจสู่อนาคตด้วย
        <span class="bg-gradient-to-r from-sky-400 via-cyan-300 to-indigo-400 bg-clip-text text-transparent">
          นวัตกรรมดิจิทัลระดับสูง
        </span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
        เราเปลี่ยนผ่านระบบไอทีแบบเดิมสู่สถาปัตยกรรม Static & Serverless ที่รวดเร็ว ปลอดภัย ประหยัดต้นทุน และพร้อมรองรับการเติบโตอย่างไร้ขีดจำกัด
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contact/"
          class="w-full sm:w-auto px-8 py-3.5 text-base font-semibold text-white bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 rounded-xl shadow-xl shadow-sky-500/25 transition-all duration-200 hover:shadow-sky-500/40 hover:-translate-y-0.5"
        >
          เริ่มต้นปรึกษาโครงการ
        </a>
        <a
          href="/services/"
          class="w-full sm:w-auto px-8 py-3.5 text-base font-semibold text-slate-300 hover:text-white bg-slate-900/80 hover:bg-slate-800 border border-slate-700/80 rounded-xl transition-all duration-200"
        >
          สำรวจบริการของเรา
        </a>
      </div>

      <!-- Tech Badges -->
      <div class="mt-16 pt-10 border-t border-slate-800/60 max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6 text-slate-400 text-sm">
        <div class="flex items-center justify-center gap-2">
          <span class="text-sky-400 font-bold text-lg">⚡ 99.9%</span>
          <span>Uptime Static Edge</span>
        </div>
        <div class="flex items-center justify-center gap-2">
          <span class="text-indigo-400 font-bold text-lg">🔒 Zero Trust</span>
          <span>Security Hardened</span>
        </div>
        <div class="flex items-center justify-center gap-2">
          <span class="text-cyan-400 font-bold text-lg">🚀 3x Fast</span>
          <span>Load Time Speed</span>
        </div>
        <div class="flex items-center justify-center gap-2">
          <span class="text-emerald-400 font-bold text-lg">💰 70%</span>
          <span>Hosting Cost Cut</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Dynamic Banners Section -->
  {banners.length > 0 && (
    <section class="py-12 bg-slate-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {banners.map((banner) => (
            <a
              href={banner.targetUrl || '#'}
              class="group relative rounded-2xl overflow-hidden aspect-[21/9] block border border-slate-800 shadow-xl focus:outline-none focus:ring-2 focus:ring-sky-400"
            >
              <picture>
                <source media="(max-width: 640px)" srcset={banner.mobileImageUrl} />
                <img
                  src={banner.desktopImageUrl}
                  alt={banner.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent flex items-end p-6">
                <div>
                  <span class="text-xs font-semibold text-sky-400 tracking-wider uppercase">แคมเปญ & ข่าวประชาสัมพันธ์</span>
                  <h3 class="text-lg sm:text-xl font-bold text-white mt-1 group-hover:text-sky-300 transition-colors">
                    {banner.title}
                  </h3>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Company Intro Section -->
  <section class="py-20 bg-slate-900/40 border-y border-slate-800/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-semibold text-sky-400 tracking-wider uppercase">เกี่ยวกับเรา</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-white mt-2 leading-tight">
            ผสานเทคโนโลยีระดับสากล เพื่อตอบโจทย์ธุรกิจไทย
          </h2>
          <p class="mt-4 text-slate-300 leading-relaxed">
            Technosrc มุ่งมั่นพัฒนาระบบซอฟต์แวร์ระดับองค์กรด้วยเครื่องมือยุคใหม่ เช่น Astro, TypeScript และ Headless CMS ให้ความสำคัญกับความเร็ว ความปลอดภัย และการดูแลรักษาง่าย โดยไม่จำเป็นต้องใช้เซิร์ฟเวอร์ราคาแพง
          </p>
          <div class="mt-8 space-y-4">
            <div class="flex items-start gap-4">
              <div class="p-2 rounded-lg bg-sky-500/10 text-sky-400 mt-1">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-semibold text-white">ปลอดภัยสูงสุด ไร้ช่องโหว่เซิร์ฟเวอร์</h3>
                <p class="text-sm text-slate-400 mt-1">หน้าบ้านสร้างเป็น Static HTML 100% จึงไม่มีช่องโหว่ PHP/Database ให้ผู้ไม่ประสงค์ดีโจมตี</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="p-2 rounded-lg bg-indigo-500/10 text-indigo-400 mt-1">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-semibold text-white">จัดการข่าวง่ายผ่าน WordPress</h3>
                <p class="text-sm text-slate-400 mt-1">ทีมงานใช้งานระบบบทความที่คุ้นเคย ระบบอัตโนมัติจะสั่ง Build & Deploy ไปยังโฮสติ้งทันที</p>
              </div>
            </div>
          </div>
        </div>
        <div class="relative">
          <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl border border-slate-700/60 bg-slate-800">
            <img
              src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=1200&auto=format&fit=crop"
              alt="Technosrc Team Collaboration"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured News Section -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs font-semibold text-sky-400 tracking-wider uppercase">อัปเดตล่าสุด</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-white mt-2">ข่าวสารและบทความ</h2>
        </div>
        <a
          href="/news/"
          class="mt-4 md:mt-0 inline-flex items-center gap-1.5 text-sm font-semibold text-sky-400 hover:text-sky-300 transition-colors"
        >
          <span>ดูข่าวทั้งหมด</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <NewsCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Contact CTA Section -->
  <section class="py-20 bg-gradient-to-b from-transparent to-slate-900/60">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="glass-panel rounded-3xl p-10 sm:p-14 border border-sky-500/20 relative overflow-hidden">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white">พร้อมอัปเกรดระบบดิจิทัลของคุณแล้วหรือยัง?</h2>
        <p class="mt-4 text-slate-300 max-w-xl mx-auto">
          ปรึกษาทีมผู้เชี่ยวชาญจาก Technosrc เพื่อออกแบบสถาปัตยกรรมเว็บไซต์และระบบคลาวด์ที่ตอบโจทย์ธุรกิจคุณอย่างแท้จริง
        </p>
        <div class="mt-8">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-white bg-gradient-to-r from-sky-500 to-indigo-600 hover:from-sky-400 hover:to-indigo-500 rounded-xl shadow-lg shadow-sky-500/25 hover:shadow-sky-500/40 transition-all duration-200"
          >
            ติดต่อเราวันนี้
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
