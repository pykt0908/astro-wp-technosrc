---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeCarousel from '../components/HomeCarousel.astro';
import HomeIntroSection from '../components/HomeIntroSection.astro';
import { getBanners } from '../lib/wordpress';

const banners = await getBanners();
---

<BaseLayout
  title="วิทยาลัยเทคโนโลยีศรีราชา - SERIRACHA TECHNOLOGY COLLEGE"
  description="วิทยาลัยเทคโนโลยีศรีราชา มุ่งมั่นจัดการศึกษาด้านวิชาชีพและเทคโนโลยีที่ทันสมัย ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี"
>
  <HomeCarousel banners={banners} />
  <HomeIntroSection />
</BaseLayout>

