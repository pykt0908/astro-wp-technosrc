---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeCarousel from '../components/HomeCarousel.astro';
import HomeIntroSection from '../components/HomeIntroSection.astro';
import HomePostsSection from '../components/HomePostsSection.astro';
import HomeCalendarSection from '../components/HomeCalendarSection.astro';
import {
  getBanners,
  getPublishedPosts,
  getCategories,
  getCollegeEvents,
  getCollegeEventCategories,
} from '../lib/wordpress';

const [banners, postsData, categories, collegeEvents, eventCategories] = await Promise.all([
  getBanners(),
  getPublishedPosts(1, 20),
  getCategories(),
  getCollegeEvents(),
  getCollegeEventCategories(),
]);

const posts = postsData.posts;
---

<BaseLayout
  title="วิทยาลัยเทคโนโลยีศรีราชา - Sriracha Technological College"
  description="วิทยาลัยเทคโนโลยีศรีราชา มุ่งมั่นจัดการศึกษาด้านวิชาชีพและเทคโนโลยีที่ทันสมัย ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี"
>
  <HomeCarousel banners={banners} />
  <HomeIntroSection />
  <HomePostsSection posts={posts} categories={categories} />
  <HomeCalendarSection events={collegeEvents} categories={eventCategories} />
</BaseLayout>

