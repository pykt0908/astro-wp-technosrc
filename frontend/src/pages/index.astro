---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { getPublishedPosts, getBanners } from '../lib/wordpress';

const { posts } = await getPublishedPosts(1, 3);
const banners = await getBanners();
---

<BaseLayout
  title="วิทยาลัยเทคโนโลยีศรีราชา - SERIRACHA TECHNOLOGY COLLEGE"
  description="วิทยาลัยเทคโนโลยีศรีราชา มุ่งมั่นจัดการศึกษาด้านวิชาชีพและเทคโนโลยีที่ทันสมัย ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 bg-gradient-to-b from-blue-50/60 via-white to-slate-50">
    <!-- Subtle Royal Blue Accent Glows -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-blue-200/40 blur-[130px] rounded-full pointer-events-none"></div>
    <div class="absolute top-0 right-10 w-96 h-96 bg-sky-100/50 blur-[100px] rounded-full pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <!-- Logo badge in hero -->
      <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white border border-blue-200 text-[#003893] text-xs font-semibold mb-8 shadow-sm">
        <img
          src="/logo/LOGO_SERIRACHA_COLOR_FULL.png"
          alt="Logo"
          class="w-6 h-6 rounded-full object-contain"
        />
        <span>SERIRACHA TECHNOLOGY COLLEGE • ชลบุรี</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-[42px] font-extrabold text-slate-900 tracking-tight leading-[1.25] max-w-3xl mx-auto">
        พัฒนาทักษะวิชาชีพสู่อนาคต
        <span class="block mt-2 text-[#0047BA]">
          วิทยาลัยเทคโนโลยีศรีราชา
        </span>
      </h1>

      <p class="mt-5 text-sm sm:text-base lg:text-[17px] text-slate-600 max-w-2xl mx-auto leading-relaxed">
        มุ่งมั่นจัดการศึกษาด้านวิชาชีพและเทคโนโลยีสมัยใหม่ สร้างผู้เรียนให้มีความรู้ ทักษะ คุณธรรม พร้อมก้าวสู่ตลาดแรงงานสากล
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/services/"
          class="w-full sm:w-auto px-8 py-3.5 text-base font-semibold text-white bg-[#0047BA] hover:bg-[#003893] rounded-md shadow-lg shadow-blue-600/25 transition-all duration-200 hover:-translate-y-0.5"
        >
          สำรวจหลักสูตรการเรียน
        </a>
        <a
          href="/contact/"
          class="w-full sm:w-auto px-8 py-3.5 text-base font-semibold text-[#0047BA] hover:text-[#002D72] bg-white hover:bg-blue-50/80 border-2 border-[#0047BA] rounded-md transition-all duration-200 shadow-sm"
        >
          ติดต่อสมัครเรียน
        </a>
      </div>

      <!-- Highlights Badges -->
      <div class="mt-16 pt-10 border-t border-slate-200 max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-slate-700 text-sm">
        <div class="flex items-center justify-center gap-2 p-3 bg-white rounded-md border border-blue-100 shadow-xs">
          <span class="text-[#0047BA] font-bold text-base">🎓 ปวช. & ปวส.</span>
          <span class="text-xs sm:text-sm font-medium">มาตรฐานสากล</span>
        </div>
        <div class="flex items-center justify-center gap-2 p-3 bg-white rounded-md border border-blue-100 shadow-xs">
          <span class="text-[#0047BA] font-bold text-base">⚡ 100%</span>
          <span class="text-xs sm:text-sm font-medium">ฝึกปฏิบัติจริง</span>
        </div>
        <div class="flex items-center justify-center gap-2 p-3 bg-white rounded-md border border-blue-100 shadow-xs">
          <span class="text-[#0047BA] font-bold text-base">🤝 เครือข่าย</span>
          <span class="text-xs sm:text-sm font-medium">สถานประกอบการ</span>
        </div>
        <div class="flex items-center justify-center gap-2 p-3 bg-white rounded-md border border-blue-100 shadow-xs">
          <span class="text-[#0047BA] font-bold text-base">📍 ศรีราชา</span>
          <span class="text-xs sm:text-sm font-medium">ทุ่งสุขลา ชลบุรี</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Dynamic Banners Section -->
  {banners.length > 0 && (
    <section class="py-12 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {banners.map((banner) => (
            <a
              href={banner.targetUrl || '#'}
              class="group relative rounded-lg overflow-hidden aspect-[21/9] block border border-blue-100 shadow-md hover:shadow-xl transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <picture>
                <source media="(max-width: 640px)" srcset={banner.mobileImageUrl} />
                <img
                  src={banner.desktopImageUrl}
                  alt={banner.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/30 to-transparent flex items-end p-6">
                <div>
                  <span class="text-xs font-semibold text-sky-300 tracking-wider uppercase">ประชาสัมพันธ์ & กิจกรรม</span>
                  <h3 class="text-lg sm:text-xl font-bold text-white mt-1 group-hover:text-sky-200 transition-colors">
                    {banner.title}
                  </h3>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- College Intro Section -->
  <section class="py-20 bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block px-3 py-1 rounded-full bg-blue-100 text-[#003893] text-xs font-semibold tracking-wider uppercase mb-3">
            เกี่ยวกับวิทยาลัย
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-snug">
            สร้างคน สร้างอาชีพ สู่มาตรฐานสากล
          </h2>
          <p class="mt-4 text-slate-600 leading-relaxed text-sm sm:text-base">
            วิทยาลัยเทคโนโลยีศรีราชา ตั้งอยู่ ณ ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี มุ่งเน้นการจัดการเรียนการสอนสายอาชีพที่ตอบรับกับการเติบโตของเขตพัฒนาพิเศษภาคตะวันออก (EEC) เน้นผู้เรียนเป็นสำคัญ พร้อมอุปกรณ์และห้องปฏิบัติการที่ทันสมัย
          </p>
          <div class="mt-8 space-y-4">
            <div class="flex items-start gap-4 p-4 rounded-md bg-white border border-blue-100 shadow-xs">
              <div class="p-2.5 rounded-md bg-blue-50 text-[#0047BA] shrink-0">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900">หลักสูตรตรงความต้องการตลาดแรงงาน</h3>
                <p class="text-sm text-slate-600 mt-1">ทั้งสาขาวิชาช่างอุตสาหกรรม บริหารธุรกิจ และเทคโนโลยีสารสนเทศดิจิทัล</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-4 rounded-md bg-white border border-blue-100 shadow-xs">
              <div class="p-2.5 rounded-md bg-blue-50 text-[#0047BA] shrink-0">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900">ความร่วมมือกับสถานประกอบการชั้นนำ</h3>
                <p class="text-sm text-slate-600 mt-1">โอกาสฝึกงานจริงและมีตำแหน่งงานรองรับทันทีหลังสำเร็จการศึกษา</p>
              </div>
            </div>
          </div>
        </div>
        <div class="relative">
          <div class="aspect-[4/3] rounded-lg overflow-hidden shadow-xl border border-blue-100 bg-white">
            <img
              src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=1200&auto=format&fit=crop"
              alt="Students Collaboration"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured News Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="inline-block px-3 py-1 rounded-full bg-blue-100 text-[#003893] text-xs font-semibold tracking-wider uppercase mb-2">
            อัปเดตล่าสุด
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">ข่าวสารและกิจกรรมวิทยาลัย</h2>
        </div>
        <a
          href="/news/"
          class="mt-4 md:mt-0 inline-flex items-center gap-1.5 text-sm font-bold text-[#0047BA] hover:text-[#002D72] transition-colors"
        >
          <span>ดูข่าวทั้งหมด</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <NewsCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Contact CTA Section: Two-tone Royal Blue & White -->
  <section class="py-12 sm:py-20 bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="rounded-xl p-6 sm:p-10 lg:p-12 bg-gradient-to-br from-[#003893] via-[#0047BA] to-[#002D72] text-white relative overflow-hidden shadow-2xl shadow-blue-900/20">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
        <h2 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white">สนใจสมัครเรียน หรือสอบถามข้อมูลเพิ่มเติม</h2>
        <p class="mt-4 text-sm sm:text-base text-blue-100 max-w-xl mx-auto leading-relaxed">
          เปิดรับสมัครนักเรียน นักศึกษาใหม่ ระดับ ปวช. และ ปวส. ติดต่อฝ่ายแนะแนวและรับสมัครได้ทุกวันทำการ
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/contact/"
            class="w-full sm:w-auto px-8 py-3.5 text-base font-bold text-[#003893] bg-white hover:bg-blue-50 rounded-md shadow-lg transition-all duration-200 hover:-translate-y-0.5"
          >
            ติดต่อฝ่ายรับสมัคร
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
