---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getOrganizationData } from "../../lib/wordpress";

const orgData = await getOrganizationData();
const { settings, leaders, committee, divisions } = orgData;

// Format date in Thai
function formatThaiDate(dateStr: string) {
  if (!dateStr) return "";
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    const months = [
      "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน",
      "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"
    ];
    return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear() + 543}`;
  } catch {
    return dateStr;
  }
}

const formattedUpdated = formatThaiDate(settings.updated_at);
---

<BaseLayout
  title="โครงสร้างการบริหาร - วิทยาลัยเทคโนโลยีศรีราชา"
  description="โครงสร้างการบริหารและสายการปฏิบัติงาน วิทยาลัยเทคโนโลยีศรีราชา รู้จักผู้บริหารและหน่วยงานที่ร่วมขับเคลื่อนวิทยาลัย"
>
  <div class="py-8 sm:py-12 lg:py-16 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <span>/</span>
      <a href="/about/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">เกี่ยวกับเรา</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold" aria-current="page">โครงสร้างการบริหาร</span>
    </nav>

    <!-- Page Title -->
    <div class="mb-8 sm:mb-12 pb-6 border-b border-slate-200 dark:border-slate-800">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            โครงสร้างการบริหาร
          </h1>
          <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2 max-w-2xl">
            {settings.page_description || "รู้จักผู้บริหารและหน่วยงานที่ร่วมขับเคลื่อนวิทยาลัยเทคโนโลยีศรีราชา"}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs sm:text-sm text-slate-700 dark:text-slate-300 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>ปีการศึกษา</span>
            <strong class="text-slate-900 dark:text-white font-bold">{settings.academic_year}</strong>
          </div>

          {settings.pdf_url && (
            <a
              href={settings.pdf_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#0047BA] hover:bg-[#003893] text-white text-xs sm:text-sm font-semibold shadow-xs hover:shadow-md transition-all active:scale-98"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <span>ดาวน์โหลดผัง (PDF)</span>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Section 1: Full Chart View (Responsive Org Chart Diagram) -->
    <section class="bg-white dark:bg-slate-900 rounded-3xl p-4 sm:p-6 lg:p-8 relative mb-14 shadow-xs overflow-x-clip" aria-label="ผังสายการบริหาร">
      <div class="w-full">

        <!-- Leaders Vertical Tree Stack -->
        <div class="flex flex-col items-center w-full">
          {leaders.map((leader, idx) => {
            const isDirector = idx === 2; // ผู้อำนวยการ
            return (
              <div class="flex flex-col items-center w-full">
                {idx > 0 && (
                  <div class="w-0.5 h-6 bg-slate-300 dark:bg-slate-600" aria-hidden="true"></div>
                )}

                <div class="org-leader-box">
                  <!-- Leader Card (No border, no shadow, enlarged photo) -->
                  <article
                    class="bg-slate-50/90 dark:bg-slate-800/80 hover:bg-slate-100/90 dark:hover:bg-slate-800 rounded-2xl p-4 transition-all flex items-center gap-4 w-full"
                  >
                    <!-- Photo Container (Square 1:1, 80-96px, no border) -->
                    <div class="relative w-20 h-20 sm:w-24 sm:h-24 aspect-square rounded-2xl overflow-hidden bg-slate-200/80 dark:bg-slate-700/80 flex-shrink-0">
                      {leader.personnel?.photo ? (
                        <img
                          src={leader.personnel.photo}
                          alt={`ภาพ ${leader.personnel.name}`}
                          class="w-full h-full object-cover object-center"
                          loading="lazy"
                        />
                      ) : (
                        <svg class="w-full h-full text-slate-400 dark:text-slate-500" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <circle cx="50" cy="34" r="20" fill="currentColor" opacity="0.55" />
                          <path d="M12 100V84c0-22 16-34 38-34s38 12 38 34v16" fill="currentColor" opacity="0.55" />
                          <path d="m36 57 14 15 14-15-7 43H43Z" fill="#eff4f8" />
                          <path d="m47 72 6 0 3 25-6 3-6-3Z" fill="#849eb5" />
                        </svg>
                      )}
                    </div>

                    <!-- Info (Name on top, Position below) -->
                    <div class="min-w-0 flex-1">
                      <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white truncate">
                        {leader.personnel?.name || "ชื่อ–นามสกุล"}
                      </h3>
                      <div class="text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300 mt-0.5 truncate">
                        {leader.position}
                      </div>
                      {leader.remark && (
                        <span class="inline-block mt-1.5 text-[10px] bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400 px-2.5 py-0.5 rounded-full">
                          {leader.remark}
                        </span>
                      )}
                    </div>
                  </article>

                  <!-- School Board / Committee (Desktop: Beside Director with dashed line) -->
                  {isDirector && committee && (
                    <div class="org-committee-desktop">
                      <div class="org-committee-connector" aria-hidden="true"></div>
                      <div class="org-committee-inner">
                        {committee.position || settings.committee_title}
                      </div>
                    </div>
                  )}
                </div>

                <!-- School Board / Committee (Mobile: Under Director with vertical dashed line) -->
                {isDirector && committee && (
                  <div class="org-committee-mobile">
                    <div class="org-committee-mobile-stem" aria-hidden="true"></div>
                    <div class="org-committee-inner">
                      {committee.position || settings.committee_title}
                    </div>
                  </div>
                )}
              </div>
            );
          })}

          <!-- Vertical Connector to Branches -->
          <div class="w-0.5 h-8 bg-slate-300 dark:bg-slate-600" aria-hidden="true"></div>
        </div>

        <!-- 4 Division Branches (Grid on Desktop, Responsive Stack on Mobile/Tablet) -->
        <div class="relative pt-2 lg:pt-6">
          <!-- Horizontal tree branch line across top (connecting 4 branches on desktop only) -->
          <div class="org-tree-branch bg-slate-300 dark:bg-slate-600" aria-hidden="true"></div>

          <div class="org-divisions-grid">
            {divisions.map((div) => (
              <div class="relative flex flex-col items-center w-full">
                <!-- Vertical tree stem connecting from top horizontal line (desktop only) -->
                <div class="org-tree-stem bg-slate-300 dark:bg-slate-600" aria-hidden="true"></div>

                <!-- Division Head Card -->
                <article
                  class="w-full bg-slate-50/90 dark:bg-slate-800/80 hover:bg-slate-100/90 dark:hover:bg-slate-800 rounded-2xl p-4 flex flex-col items-center text-center transition-all relative overflow-hidden group border-0 shadow-none"
                >
                  <!-- Division Head Photo (Square 1:1, 80-96px, no border) -->
                  <div class="relative w-20 h-20 sm:w-24 sm:h-24 aspect-square rounded-2xl overflow-hidden bg-slate-200/80 dark:bg-slate-700/80 mb-3 flex-shrink-0">
                    {div.head?.personnel?.photo ? (
                      <img
                        src={div.head.personnel.photo}
                        alt={`ภาพ ${div.head.personnel.name}`}
                        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                      />
                    ) : (
                      <svg class="w-full h-full text-slate-400 dark:text-slate-500" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <circle cx="50" cy="34" r="20" fill="currentColor" opacity="0.55" />
                        <path d="M12 100V84c0-22 16-34 38-34s38 12 38 34v16" fill="currentColor" opacity="0.55" />
                        <path d="m36 57 14 15 14-15-7 43H43Z" fill="#eff4f8" />
                        <path d="m47 72 6 0 3 25-6 3-6-3Z" fill="#849eb5" />
                      </svg>
                    )}
                  </div>

                  <!-- Name on top, Position below (All black text) -->
                  <div class="text-sm sm:text-base font-bold text-slate-900 dark:text-white truncate max-w-full">
                    {div.head?.personnel?.name || "ชื่อ–นามสกุล"}
                  </div>
                  <div class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 leading-snug mt-1">
                    {div.title}
                  </div>
                </article>

                <!-- Vertical Connector Line to Jobs -->
                <div class="w-0.5 h-6 bg-slate-300 dark:bg-slate-600 my-1" aria-hidden="true"></div>

                <!-- Subordinate Jobs (Flowing down vertically directly under division) -->
                <div class="w-full flex flex-col items-center">
                  {div.jobs.map((job, jobIdx) => (
                    <div class="w-full flex flex-col items-center">
                      {jobIdx > 0 && (
                        <div class="w-0.5 h-3 bg-slate-300 dark:bg-slate-600" aria-hidden="true"></div>
                      )}
                      <article class="w-full bg-slate-50/90 dark:bg-slate-800/60 hover:bg-slate-100/90 dark:hover:bg-slate-800/90 rounded-2xl p-3 flex items-center gap-3 transition-colors text-left group border-0 shadow-none">
                        <!-- Job Head Avatar (Square 1:1, 48-52px, no border, no shadow) -->
                        <div class="w-12 h-12 sm:w-13 sm:h-13 aspect-square rounded-xl overflow-hidden bg-slate-200/80 dark:bg-slate-700/80 flex-shrink-0">
                          {job.personnel?.photo ? (
                            <img
                              src={job.personnel.photo}
                              alt={`ภาพ ${job.personnel.name}`}
                              class="w-full h-full object-cover object-center"
                              loading="lazy"
                            />
                          ) : (
                            <svg class="w-full h-full text-slate-400 dark:text-slate-500" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                              <circle cx="50" cy="34" r="20" fill="currentColor" opacity="0.55" />
                              <path d="M12 100V84c0-22 16-34 38-34s38 12 38 34v16" fill="currentColor" opacity="0.55" />
                              <path d="m36 57 14 15 14-15-7 43H43Z" fill="#eff4f8" />
                              <path d="m47 72 6 0 3 25-6 3-6-3Z" fill="#849eb5" />
                            </svg>
                          )}
                        </div>

                        <!-- Name on top, Job & Position below -->
                        <div class="min-w-0 flex-1">
                          <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white leading-snug truncate">
                            {job.personnel?.name || "ชื่อ–นามสกุล"}
                          </h4>
                          <div class="text-[11px] sm:text-xs font-semibold text-slate-700 dark:text-slate-300 mt-0.5 leading-snug">
                            {job.title}
                          </div>
                          {job.remark && (
                            <span class="inline-block mt-1 text-[9px] bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400 px-1.5 py-0.5 rounded-full">
                              {job.remark}
                            </span>
                          )}
                        </div>
                      </article>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Footer Note -->
    <div class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-slate-500 dark:text-slate-400 gap-3">
      <div>
        <span>วิทยาลัยเทคโนโลยีศรีราชา · โครงสร้างการบริหารงานวิทยาลัย</span>
        {formattedUpdated && (
          <span class="block sm:inline sm:ml-2 text-slate-400 dark:text-slate-500">
            (ข้อมูลปรับปรุงล่าสุด: {formattedUpdated})
          </span>
        )}
      </div>
      <div>
        <span>ระบบบริหารจัดการโครงสร้างผ่าน WordPress Headless CMS</span>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .org-leader-box {
    position: relative;
    width: 100%;
    max-width: 380px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Committee Card - Desktop */
  .org-committee-desktop {
    display: none;
  }
  .org-committee-mobile {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: 0.25rem;
  }

  @media (min-width: 1024px) {
    .org-committee-desktop {
      display: flex;
      align-items: center;
      position: absolute;
      left: calc(100% + 1.5rem);
      top: 50%;
      transform: translateY(-50%);
      width: 240px;
      z-index: 10;
    }
    .org-committee-mobile {
      display: none !important;
    }
  }

  .org-committee-connector {
    border-top: 2px dashed #94a3b8;
    width: 1.5rem;
    margin-left: -1.5rem;
    margin-right: 0.5rem;
    flex-shrink: 0;
  }
  :global(.dark) .org-committee-connector {
    border-top-color: #64748b;
  }

  .org-committee-mobile-stem {
    width: 2px;
    height: 1rem;
    border-left: 2px dashed #94a3b8;
  }
  :global(.dark) .org-committee-mobile-stem {
    border-left-color: #64748b;
  }

  .org-committee-inner {
    background-color: rgba(248, 250, 252, 0.9);
    border: 1px dashed #cbd5e1;
    border-radius: 1rem;
    padding: 0.75rem 1rem;
    width: 100%;
    max-width: 260px;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #0f172a;
  }
  :global(.dark) .org-committee-inner {
    background-color: rgba(30, 41, 59, 0.8);
    border-color: #334155;
    color: #ffffff;
  }

  /* Tree Branch & Stem */
  .org-tree-branch {
    display: none;
  }
  .org-tree-stem {
    display: none;
  }

  @media (min-width: 1024px) {
    .org-tree-branch {
      display: block;
      position: absolute;
      top: 0;
      left: 12.5%;
      right: 12.5%;
      height: 2px;
    }
    .org-tree-stem {
      display: block;
      position: absolute;
      top: -1.5rem;
      left: 50%;
      transform: translateX(-50%);
      width: 2px;
      height: 1.5rem;
    }
  }

  /* Divisions Grid */
  .org-divisions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    position: relative;
    width: 100%;
  }

  @media (min-width: 640px) {
    .org-divisions-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .org-divisions-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }
</style>
