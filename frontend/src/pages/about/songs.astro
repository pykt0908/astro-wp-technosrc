---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Songs data
const songs = [
  {
    id: "march",
    index: "01",
    title: "เพลง มาร์ชเทคโนฯศรีราชา",
    englishTitle: "March Technosriracha",
    category: "เพลงมาร์ชประจำวิทยาลัย (Official Anthem)",
    tag: "เพลงประจำวิทยาลัย",
    tagColor: "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20",
    duration: "02:59",
    durationSec: 180,
    audioM4a: "/song/01_march_technosriracha.m4a",
    audioWav: encodeURI("/song/01 เพลง มาร์ชเทคโนฯศรีราชา.wav"),
    sizeM4a: "4.2 MB",
    sizeWav: "30.2 MB",
    composer: "อาจารย์จรัส วงศ์ชนะ (คำร้อง / ทำนอง)",
    meaning: "บทเพลงมาร์ชประจำสถาบันอันทรงเกียรติ ถ่ายทอดความสง่างาม อัตลักษณ์สีฟ้า-ขาว ความเป็นเลิศด้านวิชาการและทักษะวิชาชีพ ตลอดจนความจงรักภักดีต่อสถาบันชาติ ศาสนา พระมหากษัตริย์",
    lyrics: [
      {
        stanza: "ท่อนที่ 1",
        lines: [
          "เทคโนโลยีศรีราชา งามสง่าใครไม่เทียม",
          "ทักษะเยี่ยมเปี่ยมคุณธรรมล้ำเลิศวิชา",
          "ถิ่นศึกษาของเรา เพริศเพราน้องพี่ชื่อนี้ดีเรื่อยมา",
          "เป็นแหล่งปัญญาสร้างศรัทธาสร้างความมั่นใจ"
        ]
      },
      {
        stanza: "ท่อนที่ 2 (สร้อย)",
        lines: [
          "สัญลักษณ์ เกาะลอยวิไล ราชพฤกษ์สดใส",
          "ฟ้า-ขาว เกริกไกรก้าวต่อไปเคียงกัน",
          "มั่นรักสามัคคีเชิดชูศักดิ์ศรีสถาบัน",
          "ชาติ ศาสนา องค์ราชัน ยึดมั่นอยู่ในฤดี"
        ]
      },
      {
        stanza: "ท่อนจบ",
        lines: [
          "รักเกียรติ รักเรียน พากเพียร เพิ่มพูน",
          "ทูนเทิดในสิ่งดี... เพื่อเทคโนโลยีศรีราชา"
        ]
      }
    ]
  },
  {
    id: "khuen-rang",
    index: "02",
    title: "เพลง เทคโนฯคืนรัง",
    englishTitle: "Techno Khuen Rang (Homecoming Anthem)",
    category: "เพลงคืนสู่เหย้า & สายสัมพันธ์ศิษย์เก่า",
    tag: "ศิษย์เก่า & คืนสู่เหย้า",
    tagColor: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20",
    duration: "03:10",
    durationSec: 191,
    audioM4a: "/song/02_techno_khuen_rang.m4a",
    audioWav: encodeURI("/song/02 เพลง เทคโนฯคืนรัง.wav"),
    sizeM4a: "4.5 MB",
    sizeWav: "32.1 MB",
    composer: "วิทยาลัยเทคโนโลยีศรีราชา",
    meaning: "บทเพลงแห่งความคิดถึงและความผูกพัน บรรยายถึงห้วงเวลาที่ลูกเทคโนฯ เดินทางกลับคืนสู่รังอันอบอุ่น ร่วมรำลึกความหลัง มิตรภาพ และความรักที่มีต่อคุณครูและสถาบัน",
    lyrics: [
      {
        stanza: "ท่อนที่ 1",
        lines: [
          "จากแดนไกลคืนสู่รังอบอุ่น",
          "ด้วยการุณย์สายใยที่ผูกพัน",
          "ลูกเทคโนฯ คืนสู่เหย้าเราพร้อมกัน",
          "รวมใจมั่นระลึกคุณสถานศึกษา"
        ]
      },
      {
        stanza: "ท่อนที่ 2",
        lines: [
          "กราบครูบาอาจารย์ผู้เปี่ยมรัก",
          "ที่ฟูมฟักสั่งสอนแต่วิชา",
          "มิตรภาพพี่น้องไม่เสื่อมซา",
          "เทคโนฯ ศรีราชา... สถิตมั่นนิรันดร์เทอญ"
        ]
      }
    ]
  },
  {
    id: "khong-rao",
    index: "03",
    title: "เพลง เทคโนฯของเรา",
    englishTitle: "Techno Khong Rao (Our Technological Pride)",
    category: "เพลงสามัคคีและพลังสร้างสรรค์",
    tag: "พลังสามัคคี & พี่น้อง",
    tagColor: "bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border-cyan-500/20",
    duration: "02:32",
    durationSec: 152,
    audioM4a: "/song/03_techno_khong_rao.m4a",
    audioWav: encodeURI("/song/03 เพลง เทคโนฯของเรา.wav"),
    sizeM4a: "3.5 MB",
    sizeWav: "25.6 MB",
    composer: "วิทยาลัยเทคโนโลยีศรีราชา",
    meaning: "บทเพลงปลุกเร้าพลังสร้างสรรค์และมิตรภาพอันแน่นแฟ้นของพี่น้องชาวเทคโนฯ ทุกสายวิชาชีพ ทั้งสายช่างอุตสาหกรรมและพาณิชยกรรม รวมพลังก้าวสู่อนาคตที่สดใส",
    lyrics: [
      {
        stanza: "ท่อนที่ 1",
        lines: [
          "นี่คือแดนสวรรค์เทคโนฯ ของเรา",
          "ร่วมหล่อหลอมวัยเยาว์สู่วันสดใส",
          "ทักษะเลิศชำนาญการสร้างไทย",
          "ก้าวไกลด้วยวิชาและปัญญา"
        ]
      },
      {
        stanza: "ท่อนที่ 2",
        lines: [
          "จับมือก้าวไปไม่หวั่นไหว",
          "เลือดฟ้าขาวในใจไม่ร้างรา",
          "เพื่อเกียรติศักดิ์เทคโนโลยีศรีราชา",
          "เกรียงไกรทายท้าทุกเส้นทาง"
        ]
      }
    ]
  },
  {
    id: "chuen",
    index: "04",
    title: "เพลง ชื่น",
    englishTitle: "Chuen (Joy of S-TECH)",
    category: "เพลงรื่นเริงและชีวิตชีวาในรั้ววิทยาลัย",
    tag: "เพลงกิจกรรม & รื่นเริง",
    tagColor: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20",
    duration: "02:35",
    durationSec: 155,
    audioM4a: "/song/04_chuen.m4a",
    audioWav: encodeURI("/song/04 เพลง ชื่น.wav"),
    sizeM4a: "3.6 MB",
    sizeWav: "26.1 MB",
    composer: "วิทยาลัยเทคโนโลยีศรีราชา",
    meaning: "บทเพลงรื่นเริงเติมเต็มรอยยิ้ม ความสุข และพลังบวกในชีวิตรั้ววิทยาลัย สร้างบรรยากาศแห่งความเบิกบานใจในทุกกิจกรรม รอยยิ้ม และความทรงจำของวัยเรียน",
    lyrics: [
      {
        stanza: "ท่อนที่ 1",
        lines: [
          "ชื่นฤดีเมื่อได้มาพบหน้า",
          "เทคโนฯ ศรีราชารื่นเริงสดใส",
          "เสียงหัวเราะมิตรภาพก้องกังวานไกล",
          "ร่วมสร้างฝันยิ่งใหญ่ไปด้วยกัน"
        ]
      },
      {
        stanza: "ท่อนที่ 2",
        lines: [
          "สุขใดเล่าจะเท่าได้ร่วมทาง",
          "สร้างสรรค์สิ่งดีเคียงข้างทุกวัน",
          "รอยยิ้มนี้จะตราตรึงชั่วนิรันดร์",
          "ชื่นใจในรักและผูกพัน... ชาวเทคโนฯ"
        ]
      }
    ]
  }
];
---

<BaseLayout
  title="เพลงประจำวิทยาลัย - วิทยาลัยเทคโนโลยีศรีราชา"
  description="รับฟังและดาวน์โหลดเพลงประจำวิทยาลัยเทคโนโลยีศรีราชา (S-TECH) เพลงมาร์ชเทคโนฯศรีราชา เพลงเทคโนฯคืนรัง เพลงเทคโนฯของเรา และเพลงชื่น พร้อมเนื้อร้องและไฟล์เสียงคุณภาพสูง"
>
  <!-- Toast Notification Container -->
  <div
    id="song-toast"
    class="fixed bottom-24 sm:bottom-8 right-6 z-50 transform translate-y-16 opacity-0 transition-all duration-300 pointer-events-none bg-slate-900/95 dark:bg-white/95 text-white dark:text-slate-900 px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-3 text-sm font-medium backdrop-blur-md border border-white/10 dark:border-slate-800"
  >
    <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 dark:text-emerald-600 flex items-center justify-center flex-shrink-0">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <span id="song-toast-text">คัดลอกเรียบร้อยแล้ว</span>
  </div>

  <div class="py-8 sm:py-12 lg:py-16 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <span>/</span>
      <a href="/about/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">เกี่ยวกับเรา</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold" aria-current="page">เพลงประจำวิทยาลัย</span>
    </nav>

    <!-- Page Title -->
    <div class="mb-8 sm:mb-12 pb-6 border-b border-slate-200 dark:border-slate-800">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            เพลงประจำวิทยาลัย
          </h1>
          <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2 max-w-2xl font-normal">
            บทเพลงประจำสถาบันอันทรงเกียรติ เพลงมาร์ช เพลงคืนสู่เหย้า และบทเพลงแห่งมิตรภาพของวิทยาลัยเทคโนโลยีศรีราชา
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <button
            type="button"
            id="hero-play-all-btn"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#0047BA] hover:bg-[#003893] text-white text-xs sm:text-sm font-semibold shadow-xs hover:shadow-md transition-all active:scale-98 cursor-pointer"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
            <span>เล่นเพลงทั้งหมดต่อเนื่อง</span>
          </button>
        </div>
      </div>
    </div>

    <!-- MAIN STUDIO AUDIO PLAYER (THE CONSOLE) -->
    <section class="mb-14">
      <div class="relative rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl overflow-hidden p-6 sm:p-8 lg:p-10 transition-colors">
        
        <!-- Ambient soundwave background glow -->
        <div class="absolute top-0 right-0 w-80 h-80 bg-blue-500/10 dark:bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- Left Column: 3D Vinyl Record with Spin Animation -->
          <div class="lg:col-span-5 flex flex-col items-center justify-center">
            <div class="relative group">
              <!-- Vinyl Disc Container -->
              <div
                id="vinyl-disc"
                class="w-52 h-52 sm:w-64 sm:h-64 rounded-full bg-gradient-to-tr from-slate-950 via-slate-900 to-slate-950 shadow-2xl border-4 border-slate-800/80 flex items-center justify-center relative select-none transition-transform duration-700 ease-out"
                style="box-shadow: 0 15px 35px -5px rgba(0, 0, 0, 0.4), 0 0 20px 2px rgba(0, 163, 224, 0.2);"
              >
                <!-- Vinyl Grooves Rings -->
                <div class="absolute inset-3 rounded-full border border-slate-800/60 pointer-events-none"></div>
                <div class="absolute inset-6 rounded-full border border-slate-800/50 pointer-events-none"></div>
                <div class="absolute inset-10 rounded-full border border-slate-800/40 pointer-events-none"></div>
                <div class="absolute inset-14 rounded-full border border-slate-800/30 pointer-events-none"></div>
                
                <!-- Vinyl Center Label with College Crest -->
                <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-gradient-to-br from-[#002B7A] to-[#0047BA] border-4 border-amber-400/80 flex flex-col items-center justify-center shadow-inner relative overflow-hidden">
                  <img
                    src="/logo/main/logo_circle_gold.png"
                    alt="S-TECH Logo"
                    class="w-16 h-16 sm:w-20 sm:h-20 object-contain drop-shadow-md"
                  />
                  <!-- Spindle hole -->
                  <div class="w-4 h-4 rounded-full bg-slate-950 border-2 border-amber-400 absolute"></div>
                </div>
              </div>

              <!-- Animated Soundwave Equalizer Bars Badge Below Vinyl -->
              <div class="mt-4 flex items-center justify-center gap-1.5 h-6">
                <span class="w-1 bg-[#00A3E0] rounded-full eq-bar eq-bar-1"></span>
                <span class="w-1 bg-[#0047BA] rounded-full eq-bar eq-bar-2"></span>
                <span class="w-1 bg-amber-400 rounded-full eq-bar eq-bar-3"></span>
                <span class="w-1 bg-[#00A3E0] rounded-full eq-bar eq-bar-4"></span>
                <span class="w-1 bg-[#0047BA] rounded-full eq-bar eq-bar-5"></span>
              </div>
            </div>
          </div>

          <!-- Right Column: Player Controls & Metadata -->
          <div class="lg:col-span-7 flex flex-col justify-center space-y-6">
            
            <!-- Song Tag & Index -->
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span id="player-track-index" class="text-xs font-bold px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                  TRACK 01
                </span>
                <span id="player-track-tag" class="text-xs font-semibold px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
                  เพลงประจำวิทยาลัย
                </span>
              </div>

              <!-- Format Badge -->
              <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
                High-Fidelity Stereo (44.1 kHz)
              </span>
            </div>

            <!-- Song Title & Details -->
            <div>
              <h2 id="player-title" class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
                เพลง มาร์ชเทคโนฯศรีราชา
              </h2>
              <p id="player-subtitle" class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-1 font-medium">
                อาจารย์จรัส วงศ์ชนะ (คำร้อง / ทำนอง) • วิทยาลัยเทคโนโลยีศรีราชา
              </p>
            </div>

            <!-- Progress Scrubber Bar -->
            <div class="space-y-2">
              <div
                id="progress-container"
                class="relative w-full h-3 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden cursor-pointer group py-1"
                title="คลิกเพื่อเลื่อนตำแหน่งเวลา"
              >
                <!-- Buffer Bar -->
                <div id="buffer-bar" class="absolute top-0 left-0 h-full bg-slate-200 dark:bg-slate-700/60 rounded-full w-0 transition-all duration-300"></div>
                <!-- Played Bar -->
                <div
                  id="progress-bar"
                  class="absolute top-0 left-0 h-full bg-gradient-to-r from-[#0047BA] to-[#00A3E0] rounded-full w-0 relative"
                >
                  <span class="absolute right-0 top-1/2 -translate-y-1/2 w-3.5 h-3.5 bg-white rounded-full shadow-md border-2 border-[#00A3E0] opacity-0 group-hover:opacity-100 transition-opacity"></span>
                </div>
              </div>

              <!-- Time Display -->
              <div class="flex items-center justify-between text-xs font-mono font-medium text-slate-500 dark:text-slate-400">
                <span id="current-time">00:00</span>
                <span id="total-duration">02:59</span>
              </div>
            </div>

            <!-- Primary Playback Controls -->
            <div class="flex items-center justify-between pt-2">
              <div class="flex items-center gap-3 sm:gap-5">
                <!-- Shuffle Toggle -->
                <button
                  type="button"
                  id="shuffle-btn"
                  class="p-2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer"
                  title="สุ่มเพลง (Shuffle)"
                >
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H4v-4m0 0l5-5m11 5h-4m0 0l-5 5m9-9l-5-5m0 0h4v4" />
                  </svg>
                </button>

                <!-- Previous Track -->
                <button
                  type="button"
                  id="prev-btn"
                  class="p-2.5 text-slate-700 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-sky-400 transition-colors rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-95 cursor-pointer"
                  title="เพลงก่อนหน้า (Previous)"
                >
                  <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                    <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
                  </svg>
                </button>

                <!-- Big Play / Pause Button -->
                <button
                  type="button"
                  id="main-play-btn"
                  class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-gradient-to-tr from-[#0047BA] to-[#00A3E0] hover:from-[#003da6] hover:to-[#0092c8] text-white flex items-center justify-center shadow-lg shadow-blue-500/30 transform active:scale-95 transition-all cursor-pointer"
                  title="เล่น / หยุดเพลง"
                >
                  <svg id="play-icon" class="w-7 h-7 sm:w-8 sm:h-8 fill-current translate-x-0.5" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <svg id="pause-icon" class="w-7 h-7 sm:w-8 sm:h-8 fill-current hidden" viewBox="0 0 24 24">
                    <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                  </svg>
                </button>

                <!-- Next Track -->
                <button
                  type="button"
                  id="next-btn"
                  class="p-2.5 text-slate-700 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-sky-400 transition-colors rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-95 cursor-pointer"
                  title="เพลงถัดไป (Next)"
                >
                  <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                    <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
                  </svg>
                </button>

                <!-- Repeat / Loop Toggle -->
                <button
                  type="button"
                  id="repeat-btn"
                  class="p-2 text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer"
                  title="เล่นซ้ำ (Repeat)"
