---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Songs data with Spotify playlist metadata
const songs = [
  {
    id: "march",
    index: 1,
    displayIndex: "1",
    title: "เพลง มาร์ชเทคโนฯศรีราชา",
    englishTitle: "March Technosriracha",
    album: "อัลบั้มบทเพลงประจำสถาบัน S-TECH",
    category: "เพลงมาร์ชประจำวิทยาลัย",
    duration: "02:59",
    durationSec: 179,
    audioM4a: "/song/01_march_technosriracha.m4a",
    audioWav: encodeURI("/song/01 เพลง มาร์ชเทคโนฯศรีราชา.wav"),
    sizeM4a: "4.2 MB",
    sizeWav: "30.2 MB",
    composer: "อาจารย์จรัส วงศ์ชนะ (คำร้อง / ทำนอง)",
    description: "บทเพลงมาร์ชประจำสถาบันอันทรงเกียรติ ถ่ายทอดความสง่างาม อัตลักษณ์สีฟ้า-ขาว ความเป็นเลิศด้านวิชาการและทักษะวิชาชีพ"
  },
  {
    id: "khuen-rang",
    index: 2,
    displayIndex: "2",
    title: "เพลง เทคโนฯคืนรัง",
    englishTitle: "Techno Khuen Rang",
    album: "อัลบั้มบทเพลงประจำสถาบัน S-TECH",
    category: "เพลงคืนสู่เหย้า & ศิษย์เก่า",
    duration: "03:10",
    durationSec: 190,
    audioM4a: "/song/02_techno_khuen_rang.m4a",
    audioWav: encodeURI("/song/02 เพลง เทคโนฯคืนรัง.wav"),
    sizeM4a: "4.5 MB",
    sizeWav: "32.1 MB",
    composer: "วิทยาลัยเทคโนโลยีศรีราชา",
    description: "บทเพลงแห่งความคิดถึงและความผูกพัน บรรยายถึงห้วงเวลาที่ลูกเทคโนฯ เดินทางกลับคืนสู่รังอันอบอุ่นและรำลึกพระคุณครู"
  },
  {
    id: "khong-rao",
    index: 3,
    displayIndex: "3",
    title: "เพลง เทคโนฯของเรา",
    englishTitle: "Techno Khong Rao",
    album: "อัลบั้มบทเพลงประจำสถาบัน S-TECH",
    category: "เพลงสามัคคีและพลังสร้างสรรค์",
    duration: "02:32",
    durationSec: 152,
    audioM4a: "/song/03_techno_khong_rao.m4a",
    audioWav: encodeURI("/song/03 เพลง เทคโนฯของเรา.wav"),
    sizeM4a: "3.5 MB",
    sizeWav: "25.6 MB",
    composer: "วิทยาลัยเทคโนโลยีศรีราชา",
    description: "บทเพลงปลุกเร้าพลังสร้างสรรค์และมิตรภาพอันแน่นแฟ้นของพี่น้องชาวเทคโนฯ ทุกสาขาวิชาชีพ"
  },
  {
    id: "chuen",
    index: 4,
    displayIndex: "4",
    title: "เพลง ชื่น",
    englishTitle: "Chuen (Joy of S-TECH)",
    album: "อัลบั้มบทเพลงประจำสถาบัน S-TECH",
    category: "เพลงกิจกรรม & รื่นเริง",
    duration: "02:35",
    durationSec: 155,
    audioM4a: "/song/04_chuen.m4a",
    audioWav: encodeURI("/song/04 เพลง ชื่น.wav"),
    sizeM4a: "3.6 MB",
    sizeWav: "26.1 MB",
    composer: "วิทยาลัยเทคโนโลยีศรีราชา",
    description: "บทเพลงรื่นเริงเติมเต็มรอยยิ้ม ความสุข และพลังบวกในชีวิตรั้ววิทยาลัย สร้างบรรยากาศแห่งความเบิกบานใจ"
  }
];
---

<BaseLayout
  title="เพลงประจำวิทยาลัย - วิทยาลัยเทคโนโลยีศรีราชา"
  description="รับฟังและดาวน์โหลดบทเพลงประจำวิทยาลัยเทคโนโลยีศรีราชา (S-TECH) เพลย์ลิสต์ทางการ เพลงมาร์ชเทคโนฯศรีราชา เพลงเทคโนฯคืนรัง เพลงเทคโนฯของเรา และเพลงชื่น ในรูปแบบสตรีมมิ่งและสตูดิโอมาสเตอร์"
>
  <!-- Toast Notification Feedback -->
  <div
    id="song-toast"
    class="fixed bottom-28 sm:bottom-24 right-6 z-50 transform translate-y-16 opacity-0 transition-all duration-300 pointer-events-none bg-slate-900/95 dark:bg-white/95 text-white dark:text-slate-900 px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-3 text-sm font-medium backdrop-blur-md border border-slate-200/20 dark:border-slate-800"
  >
    <div class="w-6 h-6 rounded-full bg-[#0047BA]/20 text-[#0047BA] dark:text-sky-400 flex items-center justify-center shrink-0">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <span id="song-toast-text">เรียบร้อยแล้ว</span>
  </div>

  <div class="py-8 sm:py-12 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 pb-36">
    
    <!-- Standard Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <span>/</span>
      <a href="/about/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">เกี่ยวกับเรา</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold" aria-current="page">เพลงประจำวิทยาลัย</span>
    </nav>

    <!-- Standard Section Title -->
    <div class="mb-8 pb-5 border-b border-slate-200 dark:border-slate-800">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        เพลงประจำวิทยาลัย
      </h1>
      <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-1 font-normal">
        รับฟังบทเพลงแห่งความภาคภูมิใจและอัตลักษณ์ของวิทยาลัยเทคโนโลยีศรีราชา ในรูปแบบเพลย์ลิสต์
      </p>
    </div>

    <!-- SPOTIFY-STYLE PLAYLIST CONTAINER (Light theme matching website) -->
    <div class="rounded-3xl bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden transition-all duration-300">
      
      <!-- Playlist Header Hero -->
      <div class="relative bg-gradient-to-b from-blue-50/90 via-slate-50/40 to-white dark:from-slate-800/80 dark:via-slate-900/60 dark:to-slate-900 p-6 sm:p-8 lg:p-10 border-b border-slate-200/80 dark:border-slate-800">
        <!-- Ambient soundwave backdrop -->
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#00A3E0]/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row items-center md:items-end gap-6 sm:gap-8">
          
          <!-- Playlist Album Cover Art -->
          <div class="relative w-48 h-48 sm:w-56 sm:h-56 lg:w-60 lg:h-60 rounded-2xl bg-gradient-to-tr from-[#002B7A] via-[#0047BA] to-[#00A3E0] shadow-lg shrink-0 flex flex-col items-center justify-center p-6 border border-blue-200/60 dark:border-blue-900 overflow-hidden group">
            <div class="absolute inset-0 bg-radial from-transparent via-black/10 to-black/30 pointer-events-none"></div>
            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-white/10 backdrop-blur-md border border-white/30 flex items-center justify-center shadow-lg transform group-hover:scale-105 transition-transform duration-500">
              <img
                src="/logo/main/logo_circle_gold.png"
                alt="S-TECH Logo"
                class="w-20 h-20 sm:w-24 sm:h-24 object-contain drop-shadow-md"
              />
            </div>
            <div class="mt-3 text-center">
              <p class="text-[11px] font-extrabold tracking-widest text-white/95 uppercase">S-TECH ANTHEM</p>
              <p class="text-[9px] font-medium text-white/70 tracking-wider">OFFICIAL SOUNDTRACK</p>
            </div>
          </div>

          <!-- Playlist Metadata Information -->
          <div class="flex flex-col justify-end text-center md:text-left space-y-2 sm:space-y-3 min-w-0 flex-1">
            <div class="flex items-center justify-center md:justify-start gap-2 text-xs font-bold uppercase tracking-wider text-[#0047BA] dark:text-sky-400">
              <span class="inline-block w-2 h-2 rounded-full bg-[#0047BA] dark:bg-sky-400 animate-pulse"></span>
              <span>เพลย์ลิสต์ทางการ (PUBLIC PLAYLIST)</span>
            </div>

            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
              บทเพลงแห่งความภาคภูมิใจ S-TECH
            </h2>

            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 font-normal line-clamp-2 max-w-3xl leading-relaxed">
              รวมบทเพลงประจำสถาบันอันทรงเกียรติ ทั้งเพลงมาร์ชประจำวิทยาลัย เพลงคืนสู่เหย้า และเพลงกิจกรรม เพื่อความเป็นหนึ่งเดียวของชาวเลือดฟ้า-ขาว
            </p>

            <!-- Creator & Duration Meta Row -->
            <div class="pt-2 flex flex-wrap items-center justify-center md:justify-start gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 font-medium">
              <div class="flex items-center gap-2">
                <img
                  src="/logo/main/logo_circle_color_full.png"
                  alt="S-TECH"
                  class="w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-800 p-0.5 object-contain"
                />
                <span class="font-bold text-slate-800 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-sky-400 cursor-pointer">
                  วิทยาลัยเทคโนโลยีศรีราชา
                </span>
              </div>
              <span>•</span>
              <span>4 บทเพลง</span>
              <span>•</span>
              <span>11 นาที 16 วินาที</span>
              <span>•</span>
              <span class="px-2.5 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/40 text-xs text-[#0047BA] dark:text-sky-300 font-semibold border border-blue-200/50 dark:border-blue-800/50">
                Lossless & AAC High Quality
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Bar (Play button, Shuffle, Heart, Download dropdown) -->
      <div class="px-6 sm:px-8 lg:px-10 py-5 bg-white dark:bg-slate-900 flex flex-wrap items-center justify-between gap-4 border-b border-slate-200/80 dark:border-slate-800">
        <div class="flex items-center gap-3 sm:gap-5">
          <!-- Big Theme Play Button -->
          <button
            type="button"
            id="spotify-big-play-btn"
            class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#0047BA] hover:bg-[#003893] text-white flex items-center justify-center shadow-lg shadow-blue-500/25 hover:scale-105 active:scale-95 transition-all cursor-pointer"
            title="เล่นเพลย์ลิสต์"
          >
            <svg id="spotify-big-play-icon" class="w-7 h-7 fill-current translate-x-0.5" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
            <svg id="spotify-big-pause-icon" class="w-7 h-7 fill-current hidden" viewBox="0 0 24 24">
              <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
            </svg>
          </button>

          <!-- Shuffle Button -->
          <button
            type="button"
            id="spotify-header-shuffle-btn"
            class="p-2.5 text-slate-500 hover:text-[#0047BA] dark:text-slate-400 dark:hover:text-white transition-colors cursor-pointer rounded-full hover:bg-slate-100 dark:hover:bg-slate-800"
            title="สุ่มเพลง (Shuffle)"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H4v-4m0 0l5-5m11 5h-4m0 0l-5 5m9-9l-5-5m0 0h4v4" />
            </svg>
          </button>

          <!-- Heart / Like Button -->
          <button
            type="button"
            id="spotify-header-heart-btn"
            class="p-2.5 text-slate-500 hover:text-[#0047BA] dark:text-slate-400 dark:hover:text-sky-400 transition-colors cursor-pointer rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 group"
            title="บันทึกลงในรายการโปรด"
          >
            <svg id="header-heart-icon" class="w-6 h-6 transition-transform group-active:scale-125" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </button>

          <!-- Share Link Button -->
          <button
            type="button"
            id="spotify-header-share-btn"
            class="p-2.5 text-slate-500 hover:text-[#0047BA] dark:text-slate-400 dark:hover:text-white transition-colors cursor-pointer rounded-full hover:bg-slate-100 dark:hover:bg-slate-800"
            title="คัดลอกลิงก์แชร์เพลย์ลิสต์"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
          </button>
        </div>

        <!-- Download Buttons -->
        <div class="flex items-center gap-2">
          <a
            href="/song/01_march_technosriracha.m4a"
            download="01_เพลงมาร์ชเทคโนฯศรีราชา.m4a"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold transition-colors cursor-pointer border border-slate-200 dark:border-slate-700"
            title="ดาวน์โหลดไฟล์ AAC/M4A สำหรับสมาร์ตโฟน"
          >
            <svg class="w-4 h-4 text-[#0047BA] dark:text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>ดาวน์โหลด M4A</span>
          </a>

          <a
            href={encodeURI("/song/01 เพลง มาร์ชเทคโนฯศรีราชา.wav")}
            download="01_เพลงมาร์ชเทคโนฯศรีราชา.wav"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-blue-50 hover:bg-blue-100 dark:bg-blue-950/40 dark:hover:bg-blue-900/50 text-[#0047BA] dark:text-sky-300 text-xs font-semibold transition-colors cursor-pointer border border-blue-200/60 dark:border-blue-800/60"
            title="ดาวน์โหลดไฟล์สตูดิโอมาสเตอร์ WAV สำหรับงานพิธีการ"
          >
            <svg class="w-4 h-4 text-[#0047BA] dark:text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>ดาวน์โหลด WAV Master</span>
          </a>
        </div>
      </div>

      <!-- SPOTIFY TRACKLIST TABLE -->
      <div class="px-3 sm:px-6 lg:px-8 py-4 bg-white dark:bg-slate-900">
        
        <!-- Table Header -->
        <div class="grid grid-cols-12 gap-2 sm:gap-4 px-4 py-2.5 text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-100 dark:border-slate-800 select-none">
          <div class="col-span-1 text-center">#</div>
          <div class="col-span-7 sm:col-span-8 md:col-span-8">ชื่อเพลง (Title)</div>
          <div class="hidden sm:block sm:col-span-1 text-center">คุณภาพ</div>
          <div class="col-span-4 sm:col-span-3 md:col-span-3 text-right flex items-center justify-end gap-1">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>เวลา / โหลด</span>
          </div>
        </div>

        <!-- Table Body Rows -->
        <div class="mt-2 space-y-1" id="track-rows-container">
          {songs.map((song, idx) => (
            <div
              id={`track-row-${idx}`}
              class="track-row group grid grid-cols-12 gap-2 sm:gap-4 px-4 py-3 rounded-xl items-center hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors cursor-pointer select-none"
              data-song-index={idx}
              data-song-id={song.id}
            >
              <!-- Column 1: Index Number OR Play Icon OR Animated Equalizer -->
              <div class="col-span-1 flex items-center justify-center text-sm font-medium text-slate-400 dark:text-slate-500">
                <!-- Static Track Number -->
                <span class="track-number block group-hover:hidden font-mono">
                  {song.displayIndex}
                </span>

                <!-- Hover Play Icon -->
                <button
                  type="button"
                  class="row-play-btn hidden group-hover:flex items-center justify-center text-[#0047BA] dark:text-sky-400 hover:scale-110 transition-transform"
                  title="เล่นเพลงนี้"
                >
                  <svg class="w-4 h-4 fill-current row-play-icon" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <svg class="w-4 h-4 fill-current row-pause-icon hidden" viewBox="0 0 24 24">
                    <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                  </svg>
                </button>

                <!-- Animated Equalizer Bars (Visible only when playing) -->
                <div class="track-equalizer hidden items-end justify-center gap-0.5 h-4 w-4">
                  <span class="w-0.5 bg-[#0047BA] dark:bg-sky-400 rounded-full eq-bar-theme eq-bar-th-1"></span>
                  <span class="w-0.5 bg-[#00A3E0] dark:bg-sky-400 rounded-full eq-bar-theme eq-bar-th-2"></span>
                  <span class="w-0.5 bg-[#0047BA] dark:bg-sky-400 rounded-full eq-bar-theme eq-bar-th-3"></span>
                </div>
              </div>

              <!-- Column 2: Song Title & Composer / Artwork thumbnail -->
              <div class="col-span-7 sm:col-span-8 md:col-span-8 flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded-lg bg-gradient-to-tr from-[#002B7A] to-[#00A3E0] shrink-0 flex items-center justify-center overflow-hidden shadow-xs">
                  <img src="/logo/main/logo_circle_gold.png" alt="S-TECH" class="w-8 h-8 object-contain" />
                </div>
                <div class="min-w-0">
                  <p class="track-title font-semibold text-slate-800 dark:text-slate-100 text-sm sm:text-base truncate group-hover:text-[#0047BA] dark:group-hover:text-sky-400 transition-colors">
                    {song.title}
                  </p>
                  <p class="text-xs text-slate-500 dark:text-slate-400 truncate">
                    {song.composer}
                  </p>
                </div>
              </div>

              <!-- Column 3: Quality Badge -->
              <div class="hidden sm:block sm:col-span-1 text-center">
                <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 uppercase tracking-wider">
                  Hi-Fi
                </span>
              </div>

              <!-- Column 4: Duration & Download Actions -->
              <div class="col-span-4 sm:col-span-3 md:col-span-3 flex items-center justify-end gap-2 sm:gap-3 text-xs text-slate-500 dark:text-slate-400 font-mono">
                <!-- Row Heart -->
                <button
                  type="button"
                  class="row-heart-btn p-1 text-slate-400 hover:text-[#0047BA] dark:hover:text-sky-400 opacity-0 group-hover:opacity-100 transition-opacity"
                  title="ถูกใจ"
