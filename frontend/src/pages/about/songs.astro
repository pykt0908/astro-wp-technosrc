  <!-- HIDDEN AUDIO ENGINE -->
  <audio id="college-audio" preload="metadata"></audio>

  <!-- Embedded JSON Data for Client Script -->
  <script is:inline id="songs-data" type="application/json" set:html={JSON.stringify(songs)}></script>

  <!-- Spotify Player Engine Script with Website Theme Integration -->
  <script is:inline>
    (function() {
      function initSpotifyPlayer() {
        const audio = document.getElementById('college-audio');
        const dataEl = document.getElementById('songs-data');
        if (!audio || !dataEl) return;

        let songsList = [];
        try {
          songsList = JSON.parse(dataEl.textContent || '[]');
        } catch (_) {
          return;
        }
        if (!songsList.length) return;

        let currentIndex = 0;
        let isPlaying = false;
        let isShuffle = false;
        let isRepeat = false;
        let speeds = [1.0, 1.25, 1.5, 0.75];
        let currentSpeedIdx = 0;
        let likedSongs = new Set();

        // DOM elements
        const bigPlayBtn = document.getElementById('spotify-big-play-btn');
        const bigPlayIcon = document.getElementById('spotify-big-play-icon');
        const bigPauseIcon = document.getElementById('spotify-big-pause-icon');
        const headerShuffleBtn = document.getElementById('spotify-header-shuffle-btn');
        const headerHeartBtn = document.getElementById('spotify-header-heart-btn');
        const headerHeartIcon = document.getElementById('header-heart-icon');
        const headerShareBtn = document.getElementById('spotify-header-share-btn');

        // Dock elements
        const dockPlayBtn = document.getElementById('dock-play-btn');
        const dockPlayIcon = document.getElementById('dock-play-icon');
        const dockPauseIcon = document.getElementById('dock-pause-icon');
        const dockPrevBtn = document.getElementById('dock-prev-btn');
        const dockNextBtn = document.getElementById('dock-next-btn');
        const dockShuffleBtn = document.getElementById('dock-shuffle-btn');
        const dockRepeatBtn = document.getElementById('dock-repeat-btn');
        const dockSpeedBtn = document.getElementById('dock-speed-btn');
        const dockMuteBtn = document.getElementById('dock-mute-btn');
        const dockVolumeHighIcon = document.getElementById('dock-volume-high-icon');
        const dockVolumeMutedIcon = document.getElementById('dock-volume-muted-icon');
        const dockVolumeSlider = document.getElementById('dock-volume-slider');
        const dockProgressBar = document.getElementById('dock-progress-bar');
        const dockBufferBar = document.getElementById('dock-buffer-bar');
        const dockProgressContainer = document.getElementById('dock-progress-container');
        const dockCurrentTime = document.getElementById('dock-current-time');
        const dockTotalDuration = document.getElementById('dock-total-duration');
        const nowPlayingTitle = document.getElementById('now-playing-title');
        const nowPlayingArtist = document.getElementById('now-playing-artist');
        const nowPlayingHeartBtn = document.getElementById('now-playing-heart-btn');
        const nowPlayingHeartIcon = document.getElementById('now-playing-heart-icon');
        const dockDownloadLink = document.getElementById('dock-download-link');

        function formatTime(seconds) {
          if (isNaN(seconds) || seconds < 0) return '00:00';
          const mins = Math.floor(seconds / 60);
          const secs = Math.floor(seconds % 60);
          return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        function loadSong(index, autoPlay = false) {
          if (index < 0) index = songsList.length - 1;
          if (index >= songsList.length) index = 0;
          currentIndex = index;
          const song = songsList[currentIndex];

          audio.src = song.audioM4a;
          audio.playbackRate = speeds[currentSpeedIdx];

          if (nowPlayingTitle) nowPlayingTitle.textContent = song.title;
          if (nowPlayingArtist) nowPlayingArtist.textContent = `${song.composer} • วิทยาลัยเทคโนโลยีศรีราชา`;
          if (dockTotalDuration) dockTotalDuration.textContent = song.duration;
          if (dockDownloadLink) {
            dockDownloadLink.href = song.audioM4a;
            dockDownloadLink.download = `${song.title}.m4a`;
          }

          // Update heart icon for current song
          updateHeartUI(song.id);

          // Update Table Rows Visual State
          updateRowHighlight();

          // Media Session API
          if ('mediaSession' in navigator) {
            navigator.mediaSession.metadata = new MediaMetadata({
              title: song.title,
              artist: song.composer,
              album: 'บทเพลงประจำวิทยาลัยเทคโนโลยีศรีราชา (S-TECH)',
              artwork: [
                { src: '/logo/main/logo_circle_color_full.png', sizes: '512x512', type: 'image/png' }
              ]
            });
          }

          if (autoPlay) {
            audio.play().catch(function() {});
          }
        }

        function playAudio() {
          audio.play().then(() => {
            isPlaying = true;
            updatePlayStateUI();
          }).catch(() => {});
        }

        function pauseAudio() {
          audio.pause();
          isPlaying = false;
          updatePlayStateUI();
        }

        function togglePlay() {
          if (audio.paused) {
            playAudio();
          } else {
            pauseAudio();
          }
        }

        function updatePlayStateUI() {
          const isPaused = audio.paused;
          
          // Big button in playlist header
          if (bigPlayIcon) bigPlayIcon.classList.toggle('hidden', !isPaused);
          if (bigPauseIcon) bigPauseIcon.classList.toggle('hidden', isPaused);

          // Dock player
          if (dockPlayIcon) dockPlayIcon.classList.toggle('hidden', !isPaused);
          if (dockPauseIcon) dockPauseIcon.classList.toggle('hidden', isPaused);

          // Update Rows
          updateRowHighlight();
        }

        function updateRowHighlight() {
          const isPaused = audio.paused;
          document.querySelectorAll('.track-row').forEach((row, idx) => {
            const numEl = row.querySelector('.track-number');
            const playBtn = row.querySelector('.row-play-btn');
            const playIcon = row.querySelector('.row-play-icon');
            const pauseIcon = row.querySelector('.row-pause-icon');
            const eqEl = row.querySelector('.track-equalizer');
            const titleEl = row.querySelector('.track-title');

            if (idx === currentIndex) {
              row.classList.add('bg-blue-50/70', 'dark:bg-blue-950/30');
              if (titleEl) {
                titleEl.classList.remove('text-slate-800', 'dark:text-slate-100');
                titleEl.classList.add('text-[#0047BA]', 'dark:text-sky-400');
              }
              
              if (!isPaused) {
                // Active playing: show equalizer, hide number
                if (numEl) numEl.classList.add('hidden');
                if (playBtn) playBtn.classList.remove('group-hover:flex');
                if (playBtn) playBtn.classList.add('hidden');
                if (eqEl) {
                  eqEl.classList.remove('hidden');
                  eqEl.classList.add('flex');
                }
              } else {
                // Paused active
                if (numEl) numEl.classList.remove('hidden');
                if (playBtn) playBtn.classList.remove('hidden');
                if (playBtn) playBtn.classList.add('group-hover:flex');
                if (playIcon) playIcon.classList.remove('hidden');
                if (pauseIcon) pauseIcon.classList.add('hidden');
                if (eqEl) {
                  eqEl.classList.add('hidden');
                  eqEl.classList.remove('flex');
                }
              }
            } else {
              row.classList.remove('bg-blue-50/70', 'dark:bg-blue-950/30');
              if (titleEl) {
                titleEl.classList.add('text-slate-800', 'dark:text-slate-100');
                titleEl.classList.remove('text-[#0047BA]', 'dark:text-sky-400');
              }
              if (numEl) numEl.classList.remove('hidden');
              if (playBtn) {
                playBtn.classList.remove('hidden');
                playBtn.classList.add('group-hover:flex');
              }
              if (playIcon) playIcon.classList.remove('hidden');
              if (pauseIcon) pauseIcon.classList.add('hidden');
              if (eqEl) {
                eqEl.classList.add('hidden');
                eqEl.classList.remove('flex');
              }
            }
          });
        }

        function nextTrack() {
          if (isShuffle) {
            let nextIdx;
            do {
              nextIdx = Math.floor(Math.random() * songsList.length);
            } while (nextIdx === currentIndex && songsList.length > 1);
            loadSong(nextIdx, true);
          } else {
            loadSong(currentIndex + 1, true);
          }
        }

        function prevTrack() {
          if (audio.currentTime > 3) {
            audio.currentTime = 0;
          } else {
            loadSong(currentIndex - 1, true);
          }
        }

        function toggleShuffle() {
          isShuffle = !isShuffle;
          const colorClass = isShuffle ? 'text-[#0047BA] dark:text-sky-400' : 'text-slate-400';
          if (dockShuffleBtn) {
            dockShuffleBtn.className = `p-1.5 ${colorClass} hover:text-[#0047BA] dark:hover:text-white transition-colors cursor-pointer hidden sm:block`;
          }
          if (headerShuffleBtn) {
            headerShuffleBtn.className = `p-2.5 ${colorClass} hover:text-[#0047BA] dark:hover:text-white transition-colors cursor-pointer rounded-full hover:bg-slate-100 dark:hover:bg-slate-800`;
          }
          showToast(isShuffle ? 'เปิดโหมดสุ่มเพลง (Shuffle On)' : 'ปิดโหมดสุ่มเพลง (Shuffle Off)');
        }

        function toggleRepeat() {
          isRepeat = !isRepeat;
          audio.loop = isRepeat;
          const colorClass = isRepeat ? 'text-[#0047BA] dark:text-sky-400' : 'text-slate-400';
          if (dockRepeatBtn) {
            dockRepeatBtn.className = `p-1.5 ${colorClass} hover:text-[#0047BA] dark:hover:text-white transition-colors cursor-pointer hidden sm:block`;
          }
          showToast(isRepeat ? 'เปิดเล่นซ้ำเพลงนี้ (Repeat On)' : 'ปิดเล่นซ้ำ (Repeat Off)');
        }

        function updateHeartUI(songId) {
          const isLiked = likedSongs.has(songId);
          if (headerHeartIcon) {
            headerHeartIcon.setAttribute('fill', isLiked ? '#0047BA' : 'none');
            headerHeartIcon.setAttribute('stroke', isLiked ? '#0047BA' : 'currentColor');
          }
          if (nowPlayingHeartIcon) {
            nowPlayingHeartIcon.setAttribute('fill', isLiked ? '#0047BA' : 'none');
            nowPlayingHeartIcon.setAttribute('stroke', isLiked ? '#0047BA' : 'currentColor');
          }
        }

        function toggleHeart() {
          const currentSong = songsList[currentIndex];
          if (!currentSong) return;
          if (likedSongs.has(currentSong.id)) {
            likedSongs.delete(currentSong.id);
            showToast(`นำเพลง "${currentSong.title}" ออกจากรายการโปรด`);
          } else {
            likedSongs.add(currentSong.id);
            showToast(`✓ บันทึกเพลง "${currentSong.title}" ลงในรายการโปรด`);
          }
          updateHeartUI(currentSong.id);
        }

        // Attach Click Handlers
        if (bigPlayBtn) bigPlayBtn.onclick = togglePlay;
        if (dockPlayBtn) dockPlayBtn.onclick = togglePlay;
        if (dockPrevBtn) dockPrevBtn.onclick = prevTrack;
        if (dockNextBtn) dockNextBtn.onclick = nextTrack;
        if (dockShuffleBtn) dockShuffleBtn.onclick = toggleShuffle;
        if (headerShuffleBtn) headerShuffleBtn.onclick = toggleShuffle;
        if (dockRepeatBtn) dockRepeatBtn.onclick = toggleRepeat;
        if (headerHeartBtn) headerHeartBtn.onclick = toggleHeart;
        if (nowPlayingHeartBtn) nowPlayingHeartBtn.onclick = toggleHeart;

        // Share Link Button
        if (headerShareBtn) {
          headerShareBtn.onclick = () => {
            if (navigator.clipboard) {
              navigator.clipboard.writeText(window.location.href).then(() => {
                showToast('✓ คัดลอกลิงก์เพลย์ลิสต์เรียบร้อยแล้ว');
              });
            }
          };
        }

        // Speed Toggle
        if (dockSpeedBtn) {
          dockSpeedBtn.onclick = () => {
            currentSpeedIdx = (currentSpeedIdx + 1) % speeds.length;
            const newSpeed = speeds[currentSpeedIdx];
            audio.playbackRate = newSpeed;
            dockSpeedBtn.textContent = `${newSpeed.toFixed(1)}x`;
            showToast(`ความเร็วเล่นเพลง: ${newSpeed.toFixed(1)}x`);
          };
        }

        // Volume & Mute
        let prevVolume = 0.85;
        audio.volume = prevVolume;

        if (dockVolumeSlider) {
          dockVolumeSlider.oninput = (e) => {
            const val = parseFloat(e.target.value);
            audio.volume = val;
            audio.muted = (val === 0);
            updateVolumeUI(val);
          };
        }

        if (dockMuteBtn) {
          dockMuteBtn.onclick = () => {
            if (audio.muted || audio.volume === 0) {
              audio.muted = false;
              audio.volume = prevVolume || 0.85;
              if (dockVolumeSlider) dockVolumeSlider.value = audio.volume;
            } else {
              prevVolume = audio.volume;
              audio.muted = true;
              audio.volume = 0;
              if (dockVolumeSlider) dockVolumeSlider.value = 0;
            }
            updateVolumeUI(audio.volume);
          };
        }

        function updateVolumeUI(val) {
          const isMuted = (val === 0 || audio.muted);
          if (dockVolumeHighIcon) dockVolumeHighIcon.classList.toggle('hidden', isMuted);
          if (dockVolumeMutedIcon) dockVolumeMutedIcon.classList.toggle('hidden', !isMuted);
        }

        // Time and Progress Bar Updates
        audio.ontimeupdate = () => {
          if (!audio.duration) return;
          const current = audio.currentTime;
          const total = audio.duration;
          const pct = (current / total) * 100;
          if (dockProgressBar) dockProgressBar.style.width = `${pct}%`;
          if (dockCurrentTime) dockCurrentTime.textContent = formatTime(current);
        };

        audio.onprogress = () => {
          if (audio.buffered.length > 0 && audio.duration) {
            const bufferedEnd = audio.buffered.end(audio.buffered.length - 1);
            const pct = (bufferedEnd / audio.duration) * 100;
            if (dockBufferBar) dockBufferBar.style.width = `${pct}%`;
          }
        };

        audio.onended = () => {
          if (!isRepeat) {
            nextTrack();
          }
        };

        audio.onplay = () => updatePlayStateUI();
        audio.onpause = () => updatePlayStateUI();

        // Scrubber Click to Seek
        if (dockProgressContainer) {
          dockProgressContainer.onclick = (e) => {
            const rect = dockProgressContainer.getBoundingClientRect();
            const clickPos = (e.clientX - rect.left) / rect.width;
            if (audio.duration) {
              audio.currentTime = clickPos * audio.duration;
            }
          };
        }

        // Track Row Click to Play
        document.querySelectorAll('.track-row').forEach(row => {
          row.onclick = () => {
            const idx = parseInt(row.dataset.songIndex || '0', 10);
            if (idx === currentIndex) {
              togglePlay();
            } else {
              loadSong(idx, true);
            }
          };
        });

        // Toast feedback
        function showToast(message) {
          const toast = document.getElementById('song-toast');
          const toastText = document.getElementById('song-toast-text');
          if (!toast || !toastText) return;
          toastText.textContent = message;
          toast.classList.remove('translate-y-16', 'opacity-0');
          toast.classList.add('translate-y-0', 'opacity-100');
          setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-16', 'opacity-0');
          }, 2800);
        }

        // Initial load of first track without autoplay
        loadSong(0, false);
      }

      // Astro Page Load Handler (View Transitions compatible)
      document.addEventListener('astro:page-load', () => {
        initSpotifyPlayer();
      });

      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initSpotifyPlayer();
      }
    })();
  </script>

  <style>
    /* Theme animated 3-bar equalizer */
    @keyframes themeEqPulse {
      0%, 100% { height: 4px; }
      50% { height: 16px; }
    }

    .eq-bar-theme {
      height: 4px;
      animation: themeEqPulse 0.9s ease-in-out infinite;
    }

    .eq-bar-th-1 { animation-delay: 0.1s; }
    .eq-bar-th-2 { animation-delay: 0.4s; }
    .eq-bar-th-3 { animation-delay: 0.2s; }
  </style>
</BaseLayout>
