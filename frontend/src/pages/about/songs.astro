  <!-- Interactive Player Script with View Transitions support -->
  <script is:inline>
    (function() {
      let isInitialized = false;

      function initPlayer() {
        const audio = document.getElementById('college-audio');
        const dataEl = document.getElementById('songs-data');
        if (!audio || !dataEl) return;

        let songsList = [];
        try {
          songsList = JSON.parse(dataEl.textContent || '[]');
        } catch (_) {
          return;
        }
        if (!songsList.length) return;

        let currentIndex = 0;
        let isPlaying = false;
        let isShuffle = false;
        let isRepeat = false;
        let speeds = [1.0, 1.25, 1.5, 0.75];
        let currentSpeedIdx = 0;

        // Elements
        const vinyl = document.getElementById('vinyl-disc');
        const mainPlayBtn = document.getElementById('main-play-btn');
        const playIcon = document.getElementById('play-icon');
        const pauseIcon = document.getElementById('pause-icon');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const shuffleBtn = document.getElementById('shuffle-btn');
        const repeatBtn = document.getElementById('repeat-btn');
        const speedBtn = document.getElementById('speed-btn');
        const muteBtn = document.getElementById('mute-btn');
        const volumeHighIcon = document.getElementById('volume-high-icon');
        const volumeMutedIcon = document.getElementById('volume-muted-icon');
        const volumeSlider = document.getElementById('volume-slider');
        const progressBar = document.getElementById('progress-bar');
        const bufferBar = document.getElementById('buffer-bar');
        const progressContainer = document.getElementById('progress-container');
        const currentTimeEl = document.getElementById('current-time');
        const totalDurationEl = document.getElementById('total-duration');
        const playerTrackIndex = document.getElementById('player-track-index');
        const playerTrackTag = document.getElementById('player-track-tag');
        const playerTitle = document.getElementById('player-title');
        const playerSubtitle = document.getElementById('player-subtitle');
        const downloadM4a = document.getElementById('current-download-m4a');
        const downloadWav = document.getElementById('current-download-wav');
        const heroPlayAllBtn = document.getElementById('hero-play-all-btn');

        // Mini player elements
        const floatingPlayer = document.getElementById('floating-mini-player');
        const miniPlayBtn = document.getElementById('mini-play-btn');
        const miniPlayIcon = document.getElementById('mini-play-icon');
        const miniPauseIcon = document.getElementById('mini-pause-icon');
        const miniPrevBtn = document.getElementById('mini-prev-btn');
        const miniNextBtn = document.getElementById('mini-next-btn');
        const miniTitle = document.getElementById('mini-title');
        const miniDuration = document.getElementById('mini-duration');

        function formatTime(seconds) {
          if (isNaN(seconds) || seconds < 0) return '00:00';
          const mins = Math.floor(seconds / 60);
          const secs = Math.floor(seconds % 60);
          return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        function loadSong(index, autoPlay = false) {
          if (index < 0) index = songsList.length - 1;
          if (index >= songsList.length) index = 0;
          currentIndex = index;
          const song = songsList[currentIndex];

          audio.src = song.audioM4a;
          audio.playbackRate = speeds[currentSpeedIdx];
          
          if (playerTrackIndex) playerTrackIndex.textContent = `TRACK ${song.index}`;
          if (playerTrackTag) playerTrackTag.textContent = song.tag;
          if (playerTitle) playerTitle.textContent = song.title;
          if (playerSubtitle) playerSubtitle.textContent = `${song.composer} • วิทยาลัยเทคโนโลยีศรีราชา`;
          if (totalDurationEl) totalDurationEl.textContent = song.duration;

          if (downloadM4a) {
            downloadM4a.href = song.audioM4a;
            downloadM4a.download = `${song.title}.m4a`;
          }
          if (downloadWav) {
            downloadWav.href = song.audioWav;
            downloadWav.download = `${song.title}.wav`;
          }

          if (miniTitle) miniTitle.textContent = song.title;
          if (miniDuration) miniDuration.textContent = `00:00 / ${song.duration}`;

          // Highlight card
          document.querySelectorAll('.track-card').forEach((card, i) => {
            if (i === currentIndex) {
              card.classList.add('ring-2', 'ring-[#00A3E0]', 'bg-blue-50/20', 'dark:bg-blue-950/20');
            } else {
              card.classList.remove('ring-2', 'ring-[#00A3E0]', 'bg-blue-50/20', 'dark:bg-blue-950/20');
            }
          });

          // Media Session API for Lock Screen & Keyboard Keys
          if ('mediaSession' in navigator) {
            navigator.mediaSession.metadata = new MediaMetadata({
              title: song.title,
              artist: song.composer,
              album: 'เพลงประจำวิทยาลัยเทคโนโลยีศรีราชา',
              artwork: [
                { src: '/logo/main/logo_circle_color_full.png', sizes: '512x512', type: 'image/png' }
              ]
            });
          }

          if (autoPlay) {
            audio.play().catch(function() {});
          }
        }

        function playAudio() {
          audio.play().then(() => {
            isPlaying = true;
            updatePlayStateUI();
          }).catch(() => {});
        }

        function pauseAudio() {
          audio.pause();
          isPlaying = false;
          updatePlayStateUI();
        }

        function togglePlay() {
          if (audio.paused) {
            playAudio();
          } else {
            pauseAudio();
          }
        }

        function updatePlayStateUI() {
          const isPaused = audio.paused;
          if (playIcon) playIcon.classList.toggle('hidden', !isPaused);
          if (pauseIcon) pauseIcon.classList.toggle('hidden', isPaused);
          if (miniPlayIcon) miniPlayIcon.classList.toggle('hidden', !isPaused);
          if (miniPauseIcon) miniPauseIcon.classList.toggle('hidden', isPaused);

          // Vinyl Spin
          if (vinyl) {
            if (!isPaused) {
              vinyl.classList.add('animate-spin-slow');
              vinyl.style.animationPlayState = 'running';
            } else {
              vinyl.style.animationPlayState = 'paused';
            }
          }

          // Equalizer Bars
          document.querySelectorAll('.eq-bar').forEach(bar => {
            bar.classList.toggle('active', !isPaused);
          });

          // Track Card Buttons icon state
          document.querySelectorAll('.card-play-btn').forEach((btn, idx) => {
            const num = btn.querySelector('.card-play-num');
            const playI = btn.querySelector('.card-play-icon');
            const pauseI = btn.querySelector('.card-pause-icon');
            if (idx === currentIndex) {
              if (num) num.classList.add('hidden');
              if (playI) playI.classList.toggle('hidden', !isPaused);
              if (pauseI) pauseI.classList.toggle('hidden', isPaused);
              btn.classList.add('bg-[#0047BA]', 'text-white');
            } else {
              if (num) num.classList.remove('hidden');
              if (playI) playI.classList.add('hidden');
              if (pauseI) pauseI.classList.add('hidden');
              btn.classList.remove('bg-[#0047BA]', 'text-white');
            }
          });
        }

        function nextTrack() {
          if (isShuffle) {
            let nextIdx;
            do {
              nextIdx = Math.floor(Math.random() * songsList.length);
            } while (nextIdx === currentIndex && songsList.length > 1);
            loadSong(nextIdx, true);
          } else {
            loadSong(currentIndex + 1, true);
          }
        }

        function prevTrack() {
          if (audio.currentTime > 3) {
            audio.currentTime = 0;
          } else {
            loadSong(currentIndex - 1, true);
          }
        }

        // Event Listeners
        if (mainPlayBtn) mainPlayBtn.onclick = togglePlay;
        if (miniPlayBtn) miniPlayBtn.onclick = togglePlay;
        if (prevBtn) prevBtn.onclick = prevTrack;
        if (nextBtn) nextBtn.onclick = nextTrack;
        if (miniPrevBtn) miniPrevBtn.onclick = prevTrack;
        if (miniNextBtn) miniNextBtn.onclick = nextTrack;

        if (heroPlayAllBtn) {
          heroPlayAllBtn.onclick = () => {
            loadSong(0, true);
          };
        }

        // Shuffle
        if (shuffleBtn) {
          shuffleBtn.onclick = () => {
            isShuffle = !isShuffle;
            shuffleBtn.classList.toggle('text-[#0047BA]', isShuffle);
            shuffleBtn.classList.toggle('dark:text-sky-400', isShuffle);
            shuffleBtn.classList.toggle('text-slate-400', !isShuffle);
            showToast(isShuffle ? 'เปิดโหมดสุ่มเพลง (Shuffle On)' : 'ปิดโหมดสุ่มเพลง (Shuffle Off)');
          };
        }

        // Repeat
        if (repeatBtn) {
          repeatBtn.onclick = () => {
            isRepeat = !isRepeat;
            audio.loop = isRepeat;
            repeatBtn.classList.toggle('text-[#0047BA]', isRepeat);
            repeatBtn.classList.toggle('dark:text-sky-400', isRepeat);
            repeatBtn.classList.toggle('text-slate-400', !isRepeat);
            showToast(isRepeat ? 'เปิดเล่นซ้ำเพลงนี้ (Repeat On)' : 'ปิดเล่นซ้ำ (Repeat Off)');
          };
        }

        // Speed
        if (speedBtn) {
          speedBtn.onclick = () => {
            currentSpeedIdx = (currentSpeedIdx + 1) % speeds.length;
            const newSpeed = speeds[currentSpeedIdx];
            audio.playbackRate = newSpeed;
            speedBtn.textContent = `${newSpeed.toFixed(1)}x`;
            showToast(`ความเร็วในการเล่น: ${newSpeed.toFixed(1)}x`);
          };
        }

        // Volume & Mute
        let prevVolume = 0.85;
        audio.volume = prevVolume;

        if (volumeSlider) {
          volumeSlider.oninput = (e) => {
            const val = parseFloat(e.target.value);
            audio.volume = val;
            audio.muted = (val === 0);
            updateVolumeUI(val);
          };
        }

        if (muteBtn) {
          muteBtn.onclick = () => {
            if (audio.muted || audio.volume === 0) {
              audio.muted = false;
              audio.volume = prevVolume || 0.85;
              if (volumeSlider) volumeSlider.value = audio.volume;
            } else {
              prevVolume = audio.volume;
              audio.muted = true;
              audio.volume = 0;
              if (volumeSlider) volumeSlider.value = 0;
            }
            updateVolumeUI(audio.volume);
          };
        }

        function updateVolumeUI(val) {
          const isMuted = (val === 0 || audio.muted);
          if (volumeHighIcon) volumeHighIcon.classList.toggle('hidden', isMuted);
          if (volumeMutedIcon) volumeMutedIcon.classList.toggle('hidden', !isMuted);
        }

        // Audio Events
        audio.ontimeupdate = () => {
          if (!audio.duration) return;
          const current = audio.currentTime;
          const total = audio.duration;
          const pct = (current / total) * 100;
          if (progressBar) progressBar.style.width = `${pct}%`;
          if (currentTimeEl) currentTimeEl.textContent = formatTime(current);
          if (miniDuration) miniDuration.textContent = `${formatTime(current)} / ${formatTime(total)}`;
        };

        audio.onprogress = () => {
          if (audio.buffered.length > 0 && audio.duration) {
            const bufferedEnd = audio.buffered.end(audio.buffered.length - 1);
            const pct = (bufferedEnd / audio.duration) * 100;
            if (bufferBar) bufferBar.style.width = `${pct}%`;
          }
        };

        audio.onended = () => {
          if (!isRepeat) {
            nextTrack();
          }
        };

        audio.onplay = () => updatePlayStateUI();
        audio.onpause = () => updatePlayStateUI();

        // Progress scrubber seek
        if (progressContainer) {
          progressContainer.onclick = (e) => {
            const rect = progressContainer.getBoundingClientRect();
            const clickPos = (e.clientX - rect.left) / rect.width;
            if (audio.duration) {
              audio.currentTime = clickPos * audio.duration;
            }
          };
        }

        // Track Cards Buttons
        document.querySelectorAll('.card-play-btn').forEach(btn => {
          btn.onclick = () => {
            const idx = parseInt(btn.dataset.songIndex || '0', 10);
            if (idx === currentIndex) {
              togglePlay();
            } else {
              loadSong(idx, true);
            }
          };
        });

        // View Lyrics buttons on Cards
        document.querySelectorAll('.view-lyrics-btn').forEach(btn => {
          btn.onclick = () => {
            const songId = btn.dataset.songId;
            const targetPane = document.getElementById(`lyrics-pane-${songId}`);
            if (targetPane) {
              // Switch tab
              document.querySelectorAll('.lyrics-tab-btn').forEach(t => {
                if (t.dataset.tabTarget === `lyrics-pane-${songId}`) {
                  t.click();
                }
              });
              targetPane.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          };
        });

        // Lyrics Tabs Switcher
        document.querySelectorAll('.lyrics-tab-btn').forEach(tabBtn => {
          tabBtn.onclick = () => {
            const targetId = tabBtn.dataset.tabTarget;
            document.querySelectorAll('.lyrics-tab-btn').forEach(b => {
              b.classList.remove('bg-[#0047BA]', 'text-white', 'shadow-md', 'shadow-blue-500/20');
              b.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-slate-700');
            });
            tabBtn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'border');
            tabBtn.classList.add('bg-[#0047BA]', 'text-white', 'shadow-md', 'shadow-blue-500/20');

            document.querySelectorAll('.lyrics-pane').forEach(p => {
              p.classList.add('hidden');
              p.classList.remove('block');
            });
            const target = document.getElementById(targetId);
            if (target) {
              target.classList.remove('hidden');
              target.classList.add('block');
            }
          };
        });

        // Play This Song buttons inside Lyrics Card
        document.querySelectorAll('.play-this-song-btn').forEach(btn => {
          btn.onclick = () => {
            const idx = parseInt(btn.dataset.songIndex || '0', 10);
            loadSong(idx, true);
            window.scrollTo({ top: 300, behavior: 'smooth' });
          };
        });

        // Copy Lyrics Button
        document.querySelectorAll('.copy-lyrics-btn').forEach(btn => {
          btn.onclick = () => {
            const songId = btn.dataset.songId;
            const song = songsList.find(s => s.id === songId);
            if (!song) return;
            const text = `${song.title}\n(${song.composer})\n\n` +
              song.lyrics.map(s => `${s.stanza}:\n` + s.lines.join('\n')).join('\n\n') +
              `\n\nวิทยาลัยเทคโนโลยีศรีราชา (S-TECH)`;

            if (navigator.clipboard) {
              navigator.clipboard.writeText(text).then(() => {
                showToast(`✓ คัดลอกเนื้อเพลง "${song.title}" เรียบร้อยแล้ว`);
              });
            }
          };
        });

        // Floating Mini-Player Scroll Trigger
        window.addEventListener('scroll', () => {
          if (!floatingPlayer) return;
          const scrollY = window.scrollY || window.pageYOffset;
          if (scrollY > 550) {
            floatingPlayer.classList.remove('translate-y-full', 'opacity-0');
            floatingPlayer.classList.add('translate-y-0', 'opacity-100');
          } else {
            floatingPlayer.classList.remove('translate-y-0', 'opacity-100');
            floatingPlayer.classList.add('translate-y-full', 'opacity-0');
          }
        }, { passive: true });

        // Toast feedback helper
        function showToast(message) {
          const toast = document.getElementById('song-toast');
          const toastText = document.getElementById('song-toast-text');
          if (!toast || !toastText) return;
          toastText.textContent = message;
          toast.classList.remove('translate-y-16', 'opacity-0');
          toast.classList.add('translate-y-0', 'opacity-100');
          setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-16', 'opacity-0');
          }, 3000);
        }

        // Initial Load (First song)
        loadSong(0, false);
      }

      // Astro Page Load Handler (View Transitions compatible)
      document.addEventListener('astro:page-load', () => {
        initPlayer();
      });

      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initPlayer();
      }
    })();
  </script>

  <style>
    /* Continuous Vinyl Spin Animation */
    @keyframes spinSlow {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .animate-spin-slow {
      animation: spinSlow 12s linear infinite;
    }

    /* Animated Soundwave Equalizer Bars */
    @keyframes eqBarPulse {
      0%, 100% { height: 6px; }
      50% { height: 22px; }
    }

    .eq-bar {
      height: 6px;
      transition: height 0.2s ease;
    }

    .eq-bar.active {
      animation: eqBarPulse 1s ease-in-out infinite;
    }

    .eq-bar-1 { animation-delay: 0.1s; }
    .eq-bar-2 { animation-delay: 0.4s; }
    .eq-bar-3 { animation-delay: 0.2s; }
    .eq-bar-4 { animation-delay: 0.5s; }
    .eq-bar-5 { animation-delay: 0.3s; }
  </style>
</BaseLayout>
