---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ปรัชญาและอัตลักษณ์ - วิทยาลัยเทคโนโลยีศรีราชา"
  description="ปรัชญา วัฒนธรรมองค์กร สีและต้นไม้ประจำวิทยาลัย วิสัยทัศน์ พันธกิจ อัตลักษณ์ และเอกลักษณ์ ของวิทยาลัยเทคโนโลยีศรีราชา"
>
  <div class="py-8 sm:py-12 lg:py-16 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <span>/</span>
      <a href="/about/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">เกี่ยวกับเรา</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold" aria-current="page">ปรัชญาและอัตลักษณ์</span>
    </nav>

    <!-- Page Title -->
    <div class="mb-8 sm:mb-12 pb-6 border-b border-slate-200 dark:border-slate-800">
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        ปรัชญาและอัตลักษณ์
      </h1>
    </div>

    <div class="max-w-4xl mx-auto space-y-12 sm:space-y-16">

      <!-- ================= 1. ปรัชญา ================= -->
      <section class="space-y-6">
        <div class="border-b border-slate-200 dark:border-slate-800 pb-3">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
            ปรัชญา
          </h2>
        </div>

        <!-- คำขวัญปรัชญา -->
        <blockquote class="text-2xl sm:text-3xl font-extrabold text-[#0047BA] dark:text-blue-400 tracking-tight leading-snug sm:leading-tight">
          “ทักษะเยี่ยม เปี่ยมคุณธรรม ล้ำเลิศวิชา พัฒนาสังคม”
        </blockquote>

        <!-- ความเชื่อมั่นในปรัชญาการศึกษา -->
        <div class="text-slate-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed font-normal space-y-4">
          <p>
            คณะผู้ก่อตั้งวิทยาลัยมีความเชื่อมั่นในปรัชญาการศึกษาว่า 
            <span class="font-semibold text-slate-900 dark:text-white">“รากฐานของตึกคืออิฐ รากฐานของชีวิตคือ การศึกษา”</span> 
            การศึกษาคือความเจริญงอกงามของการให้การศึกษาที่ดีแก่เด็ก เด็กจะสามารถสร้างคุณภาพชีวิตที่ดี 
            ซึ่งหมายถึง ชีวิตที่สมบูรณ์ด้วยสติปัญญา คุณธรรม สุขภาพทางกายใจ และได้ใช้ความเชื่อมั่นนี้เป็นพื้นฐานของการดำเนินปรัชญาวิทยาลัยว่า 
            <span class="font-semibold text-slate-900 dark:text-white">“ทักษะเยี่ยม เปี่ยมคุณธรรม ล้ำเลิศวิชา พัฒนาสังคม”</span>
          </p>
        </div>

        <!-- ความหมายของปรัชญา 4 ด้าน -->
        <div class="pt-2 space-y-3">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
            ความหมายของปรัชญา
          </h3>
          <dl class="space-y-2.5 text-slate-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed font-normal">
            <div class="flex flex-col sm:flex-row sm:gap-3">
              <dt class="font-semibold text-slate-900 dark:text-white sm:min-w-[140px]">ทักษะเยี่ยม</dt>
              <dd class="text-slate-600 dark:text-slate-400">หมายถึง มีความรู้ ความสามารถตรงตามสาขาที่เรียน</dd>
            </div>
            <div class="flex flex-col sm:flex-row sm:gap-3">
              <dt class="font-semibold text-slate-900 dark:text-white sm:min-w-[140px]">เปี่ยมคุณธรรม</dt>
              <dd class="text-slate-600 dark:text-slate-400">หมายถึง มีการประพฤติ และปฏิบัติตนไปในทิศทางที่ถูกต้อง เหมาะสม และมีความยุติธรรม</dd>
            </div>
            <div class="flex flex-col sm:flex-row sm:gap-3">
              <dt class="font-semibold text-slate-900 dark:text-white sm:min-w-[140px]">ล้ำเลิศวิชา</dt>
              <dd class="text-slate-600 dark:text-slate-400">หมายถึง สามารถนำความรู้ไปใช้ปฏิบัติงานได้จริง และคิดคาดคะเนไปในอนาคตในทางที่ดี และสร้างสรรค์</dd>
            </div>
            <div class="flex flex-col sm:flex-row sm:gap-3">
              <dt class="font-semibold text-slate-900 dark:text-white sm:min-w-[140px]">พัฒนาสังคม</dt>
              <dd class="text-slate-600 dark:text-slate-400">หมายถึง สร้างความเจริญในชุมชนและสังคม</dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- ================= 2. วัฒนธรรมองค์กร ================= -->
      <section class="space-y-4 pt-8 border-t border-slate-200 dark:border-slate-800">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
            วัฒนธรรมองค์กร
          </h2>
        </div>
        <p class="text-xl sm:text-2xl font-extrabold text-[#0047BA] dark:text-blue-400 tracking-tight">
          “ซื่อสัตย์ มีวินัย ใฝ่ความรู้ สู้งาน เชี่ยวชาญจริง ไม่นิ่งดูดาย”
        </p>
      </section>

      <!-- ================= 3. สีและต้นไม้ประจำวิทยาลัย ================= -->
      <section class="space-y-6 pt-8 border-t border-slate-200 dark:border-slate-800">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- สีประจำวิทยาลัย -->
          <div class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
              สีประจำวิทยาลัย
            </h2>
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-24 rounded-lg overflow-hidden border border-slate-300 dark:border-slate-700 shadow-xs">
                <div class="w-1/2 bg-[#00A3E0]" title="สีฟ้า"></div>
                <div class="w-1/2 bg-white" title="สีขาว"></div>
              </div>
              <p class="text-lg font-bold text-slate-900 dark:text-white">ฟ้า – ขาว</p>
            </div>
            <dl class="space-y-2 text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
              <div>
                <dt class="font-semibold text-slate-900 dark:text-white">สีฟ้า</dt>
                <dd class="text-slate-600 dark:text-slate-400">หมายถึง ความบริบูรณ์ หรือความถึงพร้อมด้วยความรู้</dd>
              </div>
              <div>
                <dt class="font-semibold text-slate-900 dark:text-white">สีขาว</dt>
                <dd class="text-slate-600 dark:text-slate-400">หมายถึง ความเป็นผู้มีคุณธรรมและจริยธรรมอันดี</dd>
              </div>
            </dl>
          </div>

          <!-- ต้นไม้ประจำวิทยาลัย -->
          <div class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
              ต้นไม้ประจำวิทยาลัย
            </h2>
            <div class="flex items-start gap-4">
              <div class="w-24 h-24 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700 shrink-0 bg-slate-100 dark:bg-slate-800">
                <img
                  src="/images/about/tree-ratchaphruek.jpg"
                  alt="ต้นราชพฤกษ์ ต้นไม้ประจำวิทยาลัยเทคโนโลยีศรีราชา"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="space-y-1">
                <p class="text-lg font-bold text-slate-900 dark:text-white">
                  ต้นราชพฤกษ์
                </p>
                <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed">
                  หมายถึง ความเจริญรุ่งเรืองของหมู่คณะ
                </p>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ================= 4. เอกลักษณ์ อัตลักษณ์ และคุณธรรมอัตลักษณ์ ================= -->
      <section class="space-y-8 pt-8 border-t border-slate-200 dark:border-slate-800">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
            เอกลักษณ์ อัตลักษณ์ และคุณธรรมอัตลักษณ์ ของสถานศึกษา
          </h2>
        </div>

        <!-- เอกลักษณ์วิทยาลัย -->
        <div class="space-y-2">
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
            เอกลักษณ์วิทยาลัย
          </h3>
          <blockquote class="text-xl sm:text-2xl font-bold text-[#0047BA] dark:text-blue-400">
            “เป็นแหล่งเรียนรู้ สู่อาชีพ”
          </blockquote>
          <p class="text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed font-normal">
            หมายถึง เป็นสถานศึกษาที่จัดการศึกษา เพื่อพัฒนาผู้เรียนให้มีความรู้ ทักษะและความสามารถให้ปฏิบัติวิชาชีพได้ตามมาตรฐานอาชีพและความต้องการของตลาดแรงงาน สอดคล้องกับเทคโนโลยีและภูมิปัญญาท้องถิ่น
          </p>
        </div>

        <!-- อัตลักษณ์วิทยาลัย -->
        <div class="space-y-3 pt-4 border-t border-slate-100 dark:border-slate-800/60">
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
            อัตลักษณ์วิทยาลัย
          </h3>
          <blockquote class="text-xl sm:text-2xl font-bold text-[#0047BA] dark:text-blue-400">
            “ทักษะดี มีวินัย ใฝ่คุณธรรม”
          </blockquote>
          <dl class="space-y-2 text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed font-normal">
            <div class="flex flex-col sm:flex-row sm:gap-3">
              <dt class="font-semibold text-slate-900 dark:text-white sm:min-w-[120px]">ทักษะดี</dt>
              <dd class="text-slate-600 dark:text-slate-400">หมายถึง มีความรู้ความสามารถทางวิชาการตรงตามสาขาที่เรียน และแก้ไขปัญหาเป็น</dd>
            </div>
            <div class="flex flex-col sm:flex-row sm:gap-3">
              <dt class="font-semibold text-slate-900 dark:text-white sm:min-w-[120px]">มีวินัย</dt>
              <dd class="text-slate-600 dark:text-slate-400">หมายถึง มีความรับผิดชอบต่อตนเองและส่วนรวม ตรงต่อเวลา มีคุณลักษณะที่พึงประสงค์</dd>
            </div>
            <div class="flex flex-col sm:flex-row sm:gap-3">
              <dt class="font-semibold text-slate-900 dark:text-white sm:min-w-[120px]">ใฝ่คุณธรรม</dt>
              <dd class="text-slate-600 dark:text-slate-400">หมายถึง ดำรงตนอยู่ในศีลธรรม และยึดมั่นในความยุติธรรม</dd>
            </div>
          </dl>
        </div>

        <!-- คุณธรรมอัตลักษณ์ ของสถานศึกษา -->
        <div class="space-y-3 pt-4 border-t border-slate-100 dark:border-slate-800/60">
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
            คุณธรรมอัตลักษณ์ของสถานศึกษา
          </h3>
          <blockquote class="text-xl sm:text-2xl font-bold text-[#0047BA] dark:text-blue-400">
            “มีระเบียบวินัย ใฝ่เรียนรู้ มีจิตสาธารณะ”
          </blockquote>
          <dl class="space-y-2 text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed font-normal">
            <div class="flex flex-col sm:flex-row sm:gap-3">
              <dt class="font-semibold text-slate-900 dark:text-white sm:min-w-[140px]">มีระเบียบวินัย</dt>
              <dd class="text-slate-600 dark:text-slate-400">หมายถึง ประพฤติปฏิบัติตามระเบียบแบบแผน ข้อบังคับ ข้อปฏิบัติ รวมทั้งการให้ความเคารพ และยอมรับที่จะปฏิบัติตามระเบียบ กฎเกณฑ์และข้อบังคับของสถานศึกษา</dd>
            </div>
            <div class="flex flex-col sm:flex-row sm:gap-3">
              <dt class="font-semibold text-slate-900 dark:text-white sm:min-w-[140px]">ใฝ่เรียนรู้</dt>
              <dd class="text-slate-600 dark:text-slate-400">หมายถึง ความเพียรพยายาม ในการแสวงหาความรู้จากแหล่งเรียนรู้ต่างๆ ทั้งภายในและภายนอกวิทยาลัย และสามารถนำไปใช้ในชีวิตประจำวันได้</dd>
            </div>
            <div class="flex flex-col sm:flex-row sm:gap-3">
              <dt class="font-semibold text-slate-900 dark:text-white sm:min-w-[140px]">มีจิตสาธารณะ</dt>
              <dd class="text-slate-600 dark:text-slate-400">หมายถึง การช่วยเหลือผู้อื่นด้วยความเสียสละโดยไม่หวังผลตอบแทน และสร้างสิ่งที่ดีงามต่อวิทยาลัย ชุมชน และสังคม</dd>
            </div>
          </dl>
        </div>
      </section>

      <!-- ================= 5. วิสัยทัศน์ ================= -->
      <section class="space-y-4 pt-8 border-t border-slate-200 dark:border-slate-800">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
            วิสัยทัศน์
          </h2>
        </div>
        <p class="text-slate-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed font-normal">
          วิทยาลัยเทคโนโลยีศรีราชา กำหนดวิสัยทัศน์ของวิทยาลัยเทคโนโลยีศรีราชา ไว้ดังนี้
        </p>
        <blockquote class="text-xl sm:text-2xl font-bold text-[#0047BA] dark:text-blue-400 leading-relaxed">
          “มุ่งผลิตและพัฒนากำลังคนอาชีวศึกษาที่มีคุณภาพ ควบคู่คุณธรรม สอดคล้องต่อความต้องการตลาดแรงงาน สู่มาตรฐานสากล ภายในปีการศึกษา ๒๕๗๑”
        </blockquote>
      </section>

      <!-- ================= 6. เป้าหมายหลักในการจัดการศึกษา ================= -->
      <section class="space-y-4 pt-8 border-t border-slate-200 dark:border-slate-800">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
            เป้าหมายหลักในการจัดการศึกษา
          </h2>
        </div>
        <p class="text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
          วิทยาลัยมีเป้าหมายหลักในการจัดการศึกษาเพื่อสนองปรัชญาของวิทยาลัยนี้ ๕ ประการ คือ
        </p>
        <ol class="space-y-2.5 list-decimal list-outside pl-5 text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed font-normal">
          <li>นักศึกษาทุกคนที่เข้ามาศึกษาในวิทยาลัยนี้ ได้พัฒนาศักยภาพของแต่ละคนอย่างเต็มที่โดยกระบวนการเรียนรู้ตลอดชีวิต และให้นักศึกษาเป็นสำคัญ</li>
          <li>นักศึกษาทุกคนเป็นผู้มีความรู้ ความประพฤติ มีคุณธรรม มีระเบียบวินัยความรับผิดชอบ ซื่อสัตย์ ตรงต่อเวลา และสามารถทำงานร่วมกับผู้อื่นได้อย่างมีความสุข โดยสอดคล้องกับปรัชญาของวิทยาลัยที่ว่า “ทักษะเยี่ยม เปี่ยมคุณธรรม ล้ำเลิศวิชา พัฒนาสังคม”</li>
          <li>ครูและบุคลากร มีประสิทธิภาพในการทำงานสูง มีความรู้ ความสามารถ พัฒนาตนเองได้ทันกับความก้าวหน้าทางเทคโนโลยี มีคุณธรรม จริยธรรม และจรรยาบรรณในอาชีพ โดยสอดคล้องกับวัฒนธรรมองค์กรที่ว่า “ซื่อสัตย์ มีวินัย ใฝ่ความรู้ สู้งาน เชี่ยวชาญจริง ไม่นิ่งดูดาย”</li>
          <li>การบริหารและจัดการของวิทยาลัยเป็นระบบ และคล่องตัว</li>
          <li>วิทยาลัยมีความสัมพันธ์ที่ดีกับชุมชนและให้บริการสังคม</li>
        </ol>
      </section>

      <!-- ================= 7. นโยบายของวิทยาลัย ================= -->
      <section class="space-y-4 pt-8 border-t border-slate-200 dark:border-slate-800">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">
            นโยบายของวิทยาลัย
          </h2>
        </div>
        <ol class="space-y-2.5 list-decimal list-outside pl-5 text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed font-normal">
