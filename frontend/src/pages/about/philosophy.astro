---
import BaseLayout from "../../layouts/BaseLayout.astro";

const tocItems = [
  { id: "philosophy", label: "ปรัชญา" },
  { id: "culture", label: "วัฒนธรรมองค์กร" },
  { id: "symbols", label: "สีและต้นไม้ประจำวิทยาลัย" },
  { id: "identity", label: "เอกลักษณ์และอัตลักษณ์" },
  { id: "vision", label: "วิสัยทัศน์" },
  { id: "goals-edu", label: "เป้าหมายหลักการศึกษา" },
  { id: "policies", label: "นโยบายของวิทยาลัย" },
  { id: "missions", label: "พันธกิจ 5 ประการ" },
  { id: "strategies", label: "ยุทธศาสตร์ 3 ประการ" },
  { id: "goals-all", label: "เป้าประสงค์ 16 ประการ" },
];
---

<BaseLayout
  title="ปรัชญาและอัตลักษณ์ - วิทยาลัยเทคโนโลยีศรีราชา"
  description="ปรัชญา วัฒนธรรมองค์กร สีและต้นไม้ประจำวิทยาลัย วิสัยทัศน์ พันธกิจ อัตลักษณ์ และเอกลักษณ์ ของวิทยาลัยเทคโนโลยีศรีราชา"
>
  <div
    class="py-8 sm:py-12 lg:py-16 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8"
  >
    <!-- Breadcrumb -->
    <nav
      class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6"
      aria-label="Breadcrumb"
    >
      <a
        href="/"
        class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors"
        >หน้าแรก</a
      >
      <span>/</span>
      <a
        href="/about/"
        class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors"
        >เกี่ยวกับเรา</a
      >
      <span>/</span>
      <span
        class="text-slate-800 dark:text-slate-200 font-semibold"
        aria-current="page">ปรัชญาและอัตลักษณ์</span
      >
    </nav>

    <!-- Page Title -->
    <div class="mb-10 pb-6 border-b border-slate-200 dark:border-slate-800">
      <h1
        class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight"
      >
        ปรัชญาและอัตลักษณ์
      </h1>
    </div>

    <!-- Main Layout: Left Sidebar TOC + Right Content -->
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-start">
      <!-- ================= Left Column: Table of Contents (Sticky on Desktop) ================= -->
      <aside
        class="w-full lg:w-64 xl:w-72 shrink-0 lg:sticky lg:top-28 self-start"
      >
        <div
          class="p-5 rounded-2xl bg-slate-50/80 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800"
        >
          <div
            class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800 mb-3"
          >
            <h2
              class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2"
            >
              <svg
                class="w-4 h-4 text-[#0047BA] dark:text-blue-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12"></path>
              </svg>
              สารบัญเนื้อหา
            </h2>
          </div>

          <nav class="space-y-1" id="toc-nav">
            {
              tocItems.map((item, index) => (
                <a
                  href={`#${item.id}`}
                  data-target={item.id}
                  class="toc-link flex items-center justify-between px-3 py-2 rounded-lg text-xs sm:text-sm text-slate-600 dark:text-slate-400 hover:text-[#0047BA] dark:hover:text-blue-400 hover:bg-white dark:hover:bg-slate-800 transition-all font-normal"
                >
                  <span class="truncate">{item.label}</span>
                  <span class="text-[10px] text-slate-400 dark:text-slate-500 font-mono ml-2">
                    {(index + 1).toString().padStart(2, "0")}
                  </span>
                </a>
              ))
            }
          </nav>
        </div>
      </aside>

      <!-- ================= Right Column: Content ================= -->
      <main class="flex-1 min-w-0 max-w-4xl space-y-14 sm:space-y-16">
        <!-- 1. ปรัชญา -->
        <section id="philosophy" class="scroll-mt-28 space-y-6">
          <div class="flex items-center gap-3">
            <span class="w-1.5 h-6 rounded-full bg-[#0047BA]"></span>
            <h2
              class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"
            >
              ปรัชญา
            </h2>
          </div>

          <!-- คำขวัญปรัชญา -->
          <div class="border-l-4 border-[#0047BA] pl-5 sm:pl-6 py-2">
            <blockquote
              class="text-2xl sm:text-3xl font-extrabold text-[#0047BA] dark:text-blue-400 tracking-tight leading-snug sm:leading-tight"
            >
              “ทักษะเยี่ยม เปี่ยมคุณธรรม ล้ำเลิศวิชา พัฒนาสังคม”
            </blockquote>
          </div>

          <!-- ความเชื่อมั่นในปรัชญาการศึกษา -->
          <div
            class="p-6 sm:p-7 rounded-2xl bg-slate-50/80 dark:bg-slate-900/60 border border-slate-200/70 dark:border-slate-800"
          >
            <p
              class="text-slate-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed font-normal"
            >
              คณะผู้ก่อตั้งวิทยาลัยมีความเชื่อมั่นในปรัชญาการศึกษาว่า
              <span class="font-semibold text-slate-900 dark:text-white"
                >“รากฐานของตึกคืออิฐ รากฐานของชีวิตคือ การศึกษา”</span
              >
              การศึกษาคือความเจริญงอกงามของการให้การศึกษาที่ดีแก่เด็ก เด็กจะสามารถสร้างคุณภาพชีวิตที่ดี
              ซึ่งหมายถึง ชีวิตที่สมบูรณ์ด้วยสติปัญญา คุณธรรม สุขภาพทางกายใจ และได้ใช้ความเชื่อมั่นนี้เป็นพื้นฐานของการดำเนินปรัชญาวิทยาลัยว่า
              <span class="font-semibold text-slate-900 dark:text-white"
                >“ทักษะเยี่ยม เปี่ยมคุณธรรม ล้ำเลิศวิชา พัฒนาสังคม”</span
              >
            </p>
          </div>

          <!-- ความหมายของปรัชญา 4 ด้าน -->
          <div class="pt-2 space-y-4">
            <h3
              class="text-base sm:text-lg font-bold text-slate-900 dark:text-white"
            >
              ความหมายของปรัชญา
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <div
                class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs"
              >
                <div class="flex items-center gap-2 mb-1.5">
                  <span
                    class="w-2 h-2 rounded-full bg-[#0047BA] dark:bg-blue-400 shrink-0"
                  ></span>
                  <span
                    class="font-bold text-slate-900 dark:text-white text-base"
                    >ทักษะเยี่ยม</span
                  >
                </div>
                <p
                  class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed pl-4"
                >
                  มีความรู้ ความสามารถตรงตามสาขาที่เรียน
                </p>
              </div>

              <div
                class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs"
              >
                <div class="flex items-center gap-2 mb-1.5">
                  <span
                    class="w-2 h-2 rounded-full bg-[#0047BA] dark:bg-blue-400 shrink-0"
                  ></span>
                  <span
                    class="font-bold text-slate-900 dark:text-white text-base"
                    >เปี่ยมคุณธรรม</span
                  >
                </div>
                <p
                  class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed pl-4"
                >
                  มีการประพฤติ และปฏิบัติตนไปในทิศทางที่ถูกต้อง เหมาะสม
                  และมีความยุติธรรม
                </p>
              </div>

              <div
                class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs"
              >
                <div class="flex items-center gap-2 mb-1.5">
                  <span
                    class="w-2 h-2 rounded-full bg-[#0047BA] dark:bg-blue-400 shrink-0"
                  ></span>
                  <span
                    class="font-bold text-slate-900 dark:text-white text-base"
                    >ล้ำเลิศวิชา</span
                  >
                </div>
                <p
                  class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed pl-4"
                >
                  สามารถนำความรู้ไปใช้ปฏิบัติงานได้จริง
                  และคิดคาดคะเนไปในอนาคตในทางที่ดี และสร้างสรรค์
                </p>
              </div>

              <div
                class="p-4 sm:p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs"
              >
                <div class="flex items-center gap-2 mb-1.5">
                  <span
                    class="w-2 h-2 rounded-full bg-[#0047BA] dark:bg-blue-400 shrink-0"
                  ></span>
                  <span
                    class="font-bold text-slate-900 dark:text-white text-base"
                    >พัฒนาสังคม</span
                  >
                </div>
                <p
                  class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed pl-4"
                >
                  สร้างความเจริญในชุมชนและสังคม
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- 2. วัฒนธรรมองค์กร -->
        <section
          id="culture"
          class="scroll-mt-28 space-y-4 pt-10 border-t border-slate-200 dark:border-slate-800"
        >
          <div class="flex items-center gap-3">
            <span class="w-1.5 h-6 rounded-full bg-[#0047BA]"></span>
            <h2
              class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"
            >
              วัฒนธรรมองค์กร
            </h2>
          </div>
          <div
            class="border-l-4 border-slate-300 dark:border-slate-700 pl-5 sm:pl-6 py-1"
          >
            <p
              class="text-xl sm:text-2xl font-bold text-slate-800 dark:text-slate-200 tracking-tight leading-snug"
            >
              “ซื่อสัตย์ มีวินัย ใฝ่ความรู้ สู้งาน เชี่ยวชาญจริง ไม่นิ่งดูดาย”
            </p>
          </div>
        </section>

        <!-- 3. สีและต้นไม้ประจำวิทยาลัย -->
        <section
          id="symbols"
          class="scroll-mt-28 space-y-6 pt-10 border-t border-slate-200 dark:border-slate-800"
        >
          <div class="flex items-center gap-3">
            <span class="w-1.5 h-6 rounded-full bg-[#0047BA]"></span>
            <h2
              class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"
            >
              สีและต้นไม้ประจำวิทยาลัย
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
            <!-- สีประจำวิทยาลัย -->
            <div
              class="p-6 rounded-2xl bg-slate-50/70 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-800 space-y-4"
            >
              <h3
                class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center justify-between"
              >
                <span>สีประจำวิทยาลัย</span>
                <span
                  class="text-sm font-semibold text-slate-500 dark:text-slate-400"
                  >ฟ้า – ขาว</span
                >
              </h3>

              <div
                class="flex h-10 w-full rounded-xl overflow-hidden border border-slate-300/80 dark:border-slate-700 shadow-xs"
              >
                <div
                  class="w-1/2 bg-[#00A3E0] flex items-center justify-center text-xs font-bold text-white tracking-wider"
                >
                  ฟ้า
                </div>
                <div
                  class="w-1/2 bg-white flex items-center justify-center text-xs font-bold text-slate-700 tracking-wider"
                >
                  ขาว
                </div>
              </div>

              <div class="space-y-3 pt-2 text-xs sm:text-sm">
                <div class="flex items-start gap-2.5">
                  <span
                    class="w-3.5 h-3.5 rounded-full bg-[#00A3E0] shrink-0 mt-0.5 border border-black/10"
                  ></span>
                  <div>
                    <strong class="text-slate-900 dark:text-white font-semibold"
                      >สีฟ้า</strong
                    >
                    <p
                      class="text-slate-600 dark:text-slate-400 leading-relaxed mt-0.5"
                    >
                      หมายถึง ความบริบูรณ์ หรือความถึงพร้อมด้วยความรู้
                    </p>
                  </div>
                </div>
                <div class="flex items-start gap-2.5">
                  <span
                    class="w-3.5 h-3.5 rounded-full bg-white border border-slate-300 dark:border-slate-600 shrink-0 mt-0.5"
                  ></span>
                  <div>
                    <strong class="text-slate-900 dark:text-white font-semibold"
                      >สีขาว</strong
                    >
                    <p
                      class="text-slate-600 dark:text-slate-400 leading-relaxed mt-0.5"
                    >
                      หมายถึง ความเป็นผู้มีคุณธรรมและจริยธรรมอันดี
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- ต้นไม้ประจำวิทยาลัย -->
            <div
              class="p-6 rounded-2xl bg-slate-50/70 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-800 flex flex-col justify-between space-y-4"
            >
              <div>
                <h3
                  class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mb-3"
                >
                  ต้นไม้ประจำวิทยาลัย
                </h3>
                <div class="flex items-center gap-4">
                  <div
                    class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700 shrink-0 shadow-xs"
                  >
                    <img
                      src="/images/about/tree-ratchaphruek.jpg"
                      alt="ต้นราชพฤกษ์ ต้นไม้ประจำวิทยาลัยเทคโนโลยีศรีราชา"
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </div>
                  <div class="space-y-1">
                    <p
                      class="text-base sm:text-lg font-bold text-slate-900 dark:text-white"
                    >
                      ต้นราชพฤกษ์
                    </p>
                    <p
                      class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm leading-relaxed"
                    >
                      หมายถึง ความเจริญรุ่งเรืองของหมู่คณะ
                    </p>
                  </div>
                </div>
              </div>
              <p
                class="text-xs text-slate-400 dark:text-slate-500 pt-2 border-t border-slate-200/60 dark:border-slate-800"
              >
                พรรณไม้มงคลสัญลักษณ์แห่งความเจริญงอกงามและความสามัคคี
              </p>
            </div>
          </div>
        </section>

        <!-- 4. เอกลักษณ์ อัตลักษณ์ และคุณธรรมอัตลักษณ์ -->
        <section
          id="identity"
          class="scroll-mt-28 space-y-8 pt-10 border-t border-slate-200 dark:border-slate-800"
        >
          <div class="flex items-center gap-3">
            <span class="w-1.5 h-6 rounded-full bg-[#0047BA]"></span>
            <h2
              class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight"
            >
              เอกลักษณ์ อัตลักษณ์ และคุณธรรมอัตลักษณ์
            </h2>
          </div>

          <!-- 1) เอกลักษณ์วิทยาลัย -->
          <div
            class="space-y-3 p-6 rounded-2xl bg-slate-50/70 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-800"
          >
            <span
              class="text-xs font-bold text-[#0047BA] dark:text-blue-400 uppercase tracking-wider"
            >
              เอกลักษณ์วิทยาลัย
            </span>
            <blockquote
              class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white"
            >
              “เป็นแหล่งเรียนรู้ สู่อาชีพ”
            </blockquote>
            <p
              class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed font-normal pt-1"
            >
              หมายถึง เป็นสถานศึกษาที่จัดการศึกษา เพื่อพัฒนาผู้เรียนให้มีความรู้
              ทักษะและความสามารถให้ปฏิบัติวิชาชีพได้ตามมาตรฐานอาชีพและความต้องการของตลาดแรงงาน
              สอดคล้องกับเทคโนโลยีและภูมิปัญญาท้องถิ่น
            </p>
          </div>

          <!-- 2) อัตลักษณ์วิทยาลัย -->
          <div
            class="space-y-4 p-6 rounded-2xl bg-slate-50/70 dark:bg-slate-900/50 border border-slate-200/70 dark:border-slate-800"
          >
            <span
              class="text-xs font-bold text-[#0047BA] dark:text-blue-400 uppercase tracking-wider"
            >
              อัตลักษณ์วิทยาลัย
            </span>
            <blockquote
              class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white"
            >
              “ทักษะดี มีวินัย ใฝ่คุณธรรม”
            </blockquote>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
              <div
                class="p-3.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs"
              >
                <span
                  class="font-bold text-slate-900 dark:text-white text-sm block mb-1"
                  >ทักษะดี</span
                >
                <p
                  class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed"
                >
                  มีความรู้ความสามารถทางวิชาการตรงตามสาขาที่เรียน
                  และแก้ไขปัญหาเป็น
                </p>
              </div>
              <div
                class="p-3.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs"
              >
                <span
                  class="font-bold text-slate-900 dark:text-white text-sm block mb-1"
                  >มีวินัย</span
                >
                <p
                  class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed"
                >
                  มีความรับผิดชอบต่อตนเองและส่วนรวม ตรงต่อเวลา
                  มีคุณลักษณะที่พึงประสงค์
                </p>
              </div>
              <div
                class="p-3.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs"
              >
                <span
                  class="font-bold text-slate-900 dark:text-white text-sm block mb-1"
                  >ใฝ่คุณธรรม</span
                >
                <p
                  class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed"
                >
                  ดำรงตนอยู่ในศีลธรรม และยึดมั่นในความยุติธรรม
                </p>
              </div>
            </div>
          </div>

          <!-- 3) คุณธรรมอัตลักษณ์ของสถานศึกษา -->
          <div
