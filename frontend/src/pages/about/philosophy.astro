  <!-- Client-side script for Active TOC Item Highlight on Scroll -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const links = document.querySelectorAll(".toc-link");
      const sections = Array.from(links)
        .map((link) => {
          const id = link.getAttribute("data-target");
          return document.getElementById(id);
        })
        .filter(Boolean);

      if (!sections.length || !("IntersectionObserver" in window)) return;

      let currentActiveId = null;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              currentActiveId = entry.target.id;
            }
          });

          if (currentActiveId) {
            links.forEach((link) => {
              const isMatch =
                link.getAttribute("data-target") === currentActiveId;
              if (isMatch) {
                link.classList.add(
                  "text-[#0047BA]",
                  "dark:text-blue-400",
                  "font-semibold",
                  "bg-blue-50/80",
                  "dark:bg-blue-950/50",
                  "border-l-2",
                  "border-[#0047BA]",
                  "pl-2.5",
                );
                link.classList.remove(
                  "text-slate-600",
                  "dark:text-slate-400",
                  "font-normal",
                );
              } else {
                link.classList.remove(
                  "text-[#0047BA]",
                  "dark:text-blue-400",
                  "font-semibold",
                  "bg-blue-50/80",
                  "dark:bg-blue-950/50",
                  "border-l-2",
                  "border-[#0047BA]",
                  "pl-2.5",
                );
                link.classList.add(
                  "text-slate-600",
                  "dark:text-slate-400",
                  "font-normal",
                );
              }
            });
          }
        },
        {
          rootMargin: "-10% 0px -70% 0px",
          threshold: 0,
        },
      );

      sections.forEach((section) => observer.observe(section));
    });
  </script>
