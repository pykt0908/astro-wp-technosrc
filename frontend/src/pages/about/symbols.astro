---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Table of Contents Items
const tocItems = [
  { id: "sec-emblem", label: "ตราสัญลักษณ์ประจำวิทยาลัย" },
  { id: "sec-colors", label: "สีประจำวิทยาลัย" },
  { id: "sec-wordmark", label: "อัตลักษณ์ตัวอักษร S-TECH (2026)" },
  { id: "sec-tobe", label: "ตราสัญลักษณ์ TO BE NUMBER ONE" },
  { id: "sec-guidelines", label: "แนวทางการนำไปใช้งาน" },
];

// Circle Logo Variants
const emblemVariants = [
  {
    title: "สีน้ำเงินเต็มวง (Official Full Color)",
    desc: "ตราทางการสำหรับเอกสารราชการ ประกาศนียบัตร และสื่อสิ่งพิมพ์ทางการ",
    png: "/logo/main/logo_circle_color_full.png",
    svg: "/logo/main/logo_circle_color_full.svg",
    bgClass: "bg-white",
    badge: "ทางการ",
  },
  {
    title: "สีน้ำเงินพื้นโปร่งใส (Transparent Color)",
    desc: "เหมาะสำหรับวางบนพื้นหลังสีขาวหรือสีสว่างโดยไม่มีขอบขาว",
    png: "/logo/main/logo_circle_color_transparent.png",
    svg: "/logo/main/logo_circle_color_transparent.svg",
    bgClass: "bg-slate-50 dark:bg-slate-800/60",
    badge: "พื้นใส",
  },
  {
    title: "สีทองพรีเมียม (Gold Metallic)",
    desc: "สำหรับงานพิธีการ โล่รางวัล บัตรเชิญเกียรติยศ และของที่ระลึกพิเศษ",
    png: "/logo/main/logo_circle_gold.png",
    svg: "/logo/main/logo_circle_gold.svg",
    bgClass: "bg-gradient-to-br from-amber-50 to-amber-100/60 dark:from-slate-900 dark:to-amber-950/30",
    badge: "พรีเมียม",
  },
  {
    title: "สีเงินพรีเมียม (Silver Metallic)",
    desc: "สำหรับงานออกแบบร่วมสมัย ป้ายสถาบัน และงานสกรีนวัสดุโลหะ",
    png: "/logo/main/logo_circle_silver.png",
    svg: "/logo/main/logo_circle_silver.svg",
    bgClass: "bg-gradient-to-br from-slate-100 to-slate-200/60 dark:from-slate-900 dark:to-slate-800",
    badge: "เมทัลลิก",
  },
  {
    title: "สีขาวล้วน (Silhouette White)",
