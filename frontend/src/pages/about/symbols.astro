    png: "/logo/main/logo_circle_white.png",
    svg: "/logo/main/logo_circle_white.svg",
    bgClass: "bg-slate-900",
    badge: "พื้นเข้ม",
    darkText: true,
  },
  {
    title: "สีดำ-ขาว (Monochrome Black)",
    desc: "สำหรับเอกสารขาว-ดำ งานพิมพ์หนังสือเวียน และแฟกซ์",
    png: "/logo/main/logo_circle_black_white.png",
    svg: "/logo/main/logo_circle_black_white.svg",
    bgClass: "bg-white dark:bg-slate-800/80",
    badge: "ขาว-ดำ",
  },
];

// Color Palette Data
const collegeColors = [
  {
    name: "สีน้ำเงินศรีราชา (S-TECH Royal Blue)",
    role: "สีหลักประจำวิทยาลัย (Primary Identity)",
    hex: "#0047BA",
    rgb: "RGB(0, 71, 186)",
    cmyk: "CMYK(100, 75, 0, 0)",
    desc: "สะท้อนถึงความมั่นคง ความสุขุมรอบรู้ ความเป็นเลิศทางเทคโนโลยี และเกียรติภูมิของวิทยาลัยเทคโนโลยีศรีราชา",
    bg: "bg-[#0047BA]",
    textLight: true,
  },
  {
    name: "สีฟ้าคราม (Sky Tech Blue)",
    role: "สีรองประจำวิทยาลัย (Secondary Identity)",
    hex: "#058EFA",
    rgb: "RGB(5, 142, 250)",
    cmyk: "CMYK(75, 40, 0, 0)",
    desc: "สะท้อนถึงพลังความคิดสร้างสรรค์ นวัตกรรมใหม่ ความเปิดกว้างทางวิชาการ และท้องทะเลศรีราชา",
    bg: "bg-[#058EFA]",
    textLight: true,
  },
  {
    name: "สีขาวบริสุทธิ์ (Pure White)",
    role: "สีอัตลักษณ์ร่วม (Accent Color)",
    hex: "#FFFFFF",
    rgb: "RGB(255, 255, 255)",
    cmyk: "CMYK(0, 0, 0, 0)",
    desc: "สะท้อนถึงความบริสุทธิ์ คุณธรรม จริยธรรมในวิชาชีพ ความโปร่งใส และความซื่อสัตย์สุจริต",
    bg: "bg-white",
    border: "border border-slate-200 dark:border-slate-700",
    textLight: false,
  },
  {
    name: "สีทองเกียรติยศ (Honor Gold)",
    role: "สีพิเศษสำหรับพิธีการ (Ceremonial Accent)",
    hex: "#B57E10",
    rgb: "RGB(181, 126, 16)",
    cmyk: "CMYK(20, 45, 100, 15)",
    desc: "สะท้อนถึงความสำเร็จอันทรงเกียรติ ความภาคภูมิใจ และมาตรฐานความเป็นเลิศระดับสากล",
    bg: "bg-[#B57E10]",
    textLight: true,
  },
];

// Wordmark 2026 Variants
const wordmarkVariants = [
  {
    title: "สีดำมาตรฐาน (Black Standard)",
    desc: "สำหรับใช้งานบนพื้นสว่างหรือเอกสารทั่วไป",
    png: "/logo/text/stech_text_black.png",
    svg: "/logo/text/stech_text_black.svg",
    bgClass: "bg-white dark:bg-slate-800",
  },
  {
    title: "สีขาวล้วน (White Reverse)",
    desc: "สำหรับใช้งานบนพื้นสีเข้ม ภาพถ่าย หรือวิดีโอ",
    png: "/logo/text/stech_text_white.png",
    svg: "/logo/text/stech_text_white.svg",
    bgClass: "bg-slate-900",
  },
  {
    title: "สีน้ำเงิน-ฟ้า S-TECH (Brand Blue)",
    desc: "อัตลักษณ์สีหลักตัวอักษรวิทยาลัย สดใส ทันสมัย",
    png: "/logo/text/stech_text_blue.png",
    svg: "/logo/text/stech_text_blue.svg",
    bgClass: "bg-slate-950",
  },
  {
    title: "สีทองเมทัลลิก (Metallic Gold)",
    desc: "เรียบหรู ทรงคุณค่า เหมาะกับงานเกียรติยศ",
    png: "/logo/text/stech_text_gold.png",
    svg: "/logo/text/stech_text_gold.svg",
    bgClass: "bg-slate-950",
  },
  {
    title: "สีเงินเมทัลลิก (Metallic Silver)",
    desc: "ทันสมัย สไตล์ไฮเทค เหมาะกับงานสื่อเทคโนโลยี",
    png: "/logo/text/stech_text_silver.png",
    svg: "/logo/text/stech_text_silver.svg",
    bgClass: "bg-slate-950",
  },
  {
    title: "สีเทาชาร์โคล (Minimal Charcoal)",
    desc: "สไตล์มินิมอล ทางการ เรียบง่าย",
    png: "/logo/text/stech_text_gray.png",
    svg: "/logo/text/stech_text_gray.svg",
    bgClass: "bg-white dark:bg-slate-800",
  },
  {
    title: "แถบสปอร์ตไดนามิก (Athletic Stripe)",
    desc: "สำหรับงานกิจกรรมนักศึกษา กีฬา และสื่อสมัยใหม่",
    png: "/logo/text/stech_text_stripe_blue.png",
    svg: "/logo/text/stech_text_stripe_blue.svg",
    bgClass: "bg-slate-950",
  },
  {
    title: "โครงร่างสีน้ำเงินเข้ม (Outline Dark)",
    desc: "ลวดลายเชิงสถาปัตยกรรมสำหรับกราฟิกแบคกราวด์",
    png: "/logo/text/stech_text_outline_dark.png",
    svg: "/logo/text/stech_text_outline_dark.svg",
    bgClass: "bg-[#001744]",
  },
  {
    title: "โครงร่างสีฟ้าอ่อน (Outline Light)",
    desc: "ลวดลายโปร่งเบาสำหรับพื้นหลังสีสว่าง",
    png: "/logo/text/stech_text_outline_light.png",
    svg: "/logo/text/stech_text_outline_light.svg",
    bgClass: "bg-sky-50 dark:bg-slate-800",
  },
  {
    title: "โลหะรมดำ (Dark Metallic)",
    desc: "สไตล์พรีเมียมลึกซึ้ง เหมาะกับสื่อโปรดักชัน",
    png: "/logo/text/stech_text_dark_metallic.png",
    svg: "/logo/text/stech_text_dark_metallic.svg",
    bgClass: "bg-slate-100 dark:bg-slate-800",
  },
];

// TO BE NUMBER ONE Variants
const tobeVariants = [
  {
    title: "ตราทางการสีน้ำเงิน-แดง (Official Full Color)",
    desc: "ตราสัญลักษณ์ทางการชมรม TO BE NUMBER ONE วิทยาลัยเทคโนโลยีศรีราชา",
    png: "/logo/tobe/tobe_color.png",
    svg: "/logo/tobe/tobe_color.svg",
    bgClass: "bg-white dark:bg-slate-800",
  },
  {
    title: "สีดำ-ขาว (Monochrome Black)",
    desc: "สำหรับงานพิมพ์ขาวดำและเอกสารทางการทั่วไป",
    png: "/logo/tobe/tobe_black.png",
    svg: "/logo/tobe/tobe_black.svg",
    bgClass: "bg-white dark:bg-slate-800",
  },
  {
    title: "สีขาวล้วน (White Reverse)",
    desc: "สำหรับงานสกรีนเสื้อชมรมสีเข้ม และสื่อดิจิทัลบนพื้นมืด",
    png: "/logo/tobe/tobe_white.png",
    svg: "/logo/tobe/tobe_white.svg",
    bgClass: "bg-slate-900",
  },
];
---

<BaseLayout
  title="ตราสัญลักษณ์และสีประจำวิทยาลัย - วิทยาลัยเทคโนโลยีศรีราชา"
  description="ข้อมูลอัตลักษณ์องค์กร ตราสัญลักษณ์ทางการประจำวิทยาลัยเทคโนโลยีศรีราชา สีประจำวิทยาลัย โลโก้ S-TECH 2026 ตรา TO BE NUMBER ONE และคู่มือการนำไปใช้งาน พร้อมดาวน์โหลดไฟล์ความละเอียดสูง"
>
  <!-- Toast Notification for Copy Code -->
  <div
    id="copy-toast"
    class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none bg-slate-900 dark:bg-white text-white dark:text-slate-900 px-4 py-2.5 rounded-xl shadow-xl flex items-center gap-2 text-xs sm:text-sm font-semibold"
  >
    <svg class="w-4 h-4 text-emerald-400 dark:text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
    </svg>
    <span id="copy-toast-msg">คัดลอกโค้ดสีเรียบร้อยแล้ว</span>
  </div>

  <div class="py-8 sm:py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 sm:mb-8">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <a href="/about/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">เกี่ยวกับเรา</a>
      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-slate-800 dark:text-slate-200 font-medium">ตราสัญลักษณ์และสีประจำวิทยาลัย</span>
    </nav>

    <!-- Page Header -->
    <div class="mb-10 sm:mb-12 pb-6 border-b border-slate-200 dark:border-slate-800">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-semibold tracking-wider text-[#0047BA] dark:text-blue-400 uppercase">
            College Identity & Brand Assets
          </span>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-1">
            ตราสัญลักษณ์และสีประจำวิทยาลัย
          </h1>
          <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2 max-w-2xl leading-relaxed">
            อัตลักษณ์แห่งความภาคภูมิใจ ความหมายของตราสัญลักษณ์ประจำสถาบัน โค้ดสีทางการ และแหล่งดาวน์โหลดไฟล์ตราสัญลักษณ์ความละเอียดสูงสำหรับงานพิมพ์และสื่อดิจิทัล
          </p>
        </div>

        <!-- Quick Download All Pack Button -->
        <div class="shrink-0">
          <a
            href="/logo/main/logo_circle_color_full.png"
            download="STECH_OFFICIAL_LOGO.png"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#0047BA] hover:bg-[#003893] text-white text-xs sm:text-sm font-semibold shadow-xs hover:shadow-md transition-all active:scale-98"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>ดาวน์โหลดโลโก้ทางการ (PNG)</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main Grid: Left TOC Sidebar + Right Content Area -->
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-10 items-start">
      
      <!-- ================= Left Column: Table of Contents ================= -->
      <aside class="w-full lg:w-64 xl:w-72 shrink-0 lg:sticky lg:top-28 z-20">
        <div class="bg-slate-50/80 dark:bg-slate-900/80 backdrop-blur-md rounded-2xl border border-slate-200/80 dark:border-slate-800 p-4 sm:p-5 shadow-xs">
          
          <div class="flex items-center gap-2 pb-3 mb-3 border-b border-slate-200 dark:border-slate-800">
            <svg class="w-4 h-4 text-[#0047BA] dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h10" />
            </svg>
            <h2 class="text-sm font-bold text-slate-800 dark:text-slate-200">
              สารบัญเนื้อหา
            </h2>
          </div>

          <nav class="space-y-1" id="toc-nav">
            {tocItems.map((item, index) => {
              const isActive = index === 0;
              return (
                <a
                  href={`#${item.id}`}
                  data-target={item.id}
                  class:list={[
                    "toc-link flex items-center justify-between px-3 py-2 rounded-lg text-xs sm:text-sm transition-all",
                    isActive
                      ? "text-[#0047BA] dark:text-blue-400 font-semibold bg-blue-50/80 dark:bg-blue-950/50"
                      : "text-slate-600 dark:text-slate-400 font-normal hover:text-[#0047BA] dark:hover:text-blue-400 hover:bg-white dark:hover:bg-slate-800"
                  ]}
                >
                  <span class="truncate">{item.label}</span>
                  <span
                    class:list={[
                      "toc-number text-[10px] font-mono ml-2 transition-colors",
                      isActive
                        ? "text-[#0047BA] dark:text-blue-400 font-semibold"
                        : "text-slate-400 dark:text-slate-500 font-normal"
                    ]}
                  >
                    {(index + 1).toString().padStart(2, "0")}
                  </span>
                </a>
              );
            })}
          </nav>

          <!-- Quick Helpline Box -->
          <div class="mt-6 pt-4 border-t border-slate-200/60 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400 space-y-1">
            <span class="font-semibold block text-slate-700 dark:text-slate-300">ฝ่ายสื่อสารองค์กร</span>
            <p class="leading-relaxed">ติดต่อขอไฟล์อัตลักษณ์เพิ่มเติมหรือสอบถามลิขสิทธิ์ตราสัญลักษณ์</p>
            <a href="/contact/" class="text-[#0047BA] dark:text-blue-400 hover:underline block pt-1 font-medium">
              ติดต่อวิทยาลัย &rarr;
            </a>
          </div>

        </div>
      </aside>

      <!-- ================= Right Column: Content ================= -->
      <main class="flex-1 min-w-0 max-w-4xl space-y-14 sm:space-y-16">

        <!-- SECTION 1: ตราสัญลักษณ์ประจำวิทยาลัย -->
        <section id="sec-emblem" class="scroll-mt-28 space-y-8">
          
          <div class="flex items-center gap-3">
            <span class="w-1.5 h-6 rounded-full bg-[#0047BA]"></span>
            <div>
              <span class="text-xs font-mono font-semibold text-[#0047BA] dark:text-blue-400 tracking-wider">01</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
                ตราสัญลักษณ์ประจำวิทยาลัย
              </h2>
            </div>
          </div>

          <!-- Official Hero Showcase Card -->
          <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-6 sm:p-10 shadow-xs overflow-hidden relative">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
              
              <!-- Left: Emblem Visual Display without card frame or hover effect -->
              <div class="md:col-span-4 flex flex-col items-center justify-center">
                <div class="w-36 h-36 sm:w-44 sm:h-44 flex items-center justify-center">
                  <img
                    src="/logo/main/logo_circle_color_full.png"
                    alt="ตราสัญลักษณ์ วิทยาลัยเทคโนโลยีศรีราชา"
                    class="w-full h-full object-contain"
                  />
                </div>

                <div class="flex items-center gap-2 mt-4">
                  <a
                    href="/logo/main/logo_circle_color_full.png"
                    download="logo_sriracha_official.png"
                    class="px-3 py-1.5 rounded-lg bg-blue-50 dark:bg-blue-950/80 hover:bg-blue-100 dark:hover:bg-blue-900 text-[#0047BA] dark:text-blue-300 text-xs font-semibold border border-blue-200 dark:border-blue-800 transition-colors inline-flex items-center gap-1.5"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                    PNG
                  </a>
                  <a
                    href="/logo/main/logo_circle_color_full.svg"
                    download="logo_sriracha_official.svg"
                    class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-semibold border border-slate-200 dark:border-slate-700 transition-colors inline-flex items-center gap-1.5"
                  >
