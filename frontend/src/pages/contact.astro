---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ติดต่อเรา - วิทยาลัยเทคโนโลยีศรีราชา"
  description="ช่องทางการติดต่อ แผนที่ และการเดินทางมายังวิทยาลัยเทคโนโลยีศรีราชา ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี"
>
  <div class="py-10 sm:py-16 lg:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      <span class="inline-block px-3 py-1 rounded-full bg-blue-100 text-[#003893] text-xs font-semibold tracking-wider uppercase mb-3">
        ติดต่อวิทยาลัย
      </span>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 mt-2 tracking-tight">
        ติดต่อสอบถาม & สมัครเรียน
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-600">
        ยินดีต้อนรับนักเรียน นักศึกษา ผู้ปกครอง และสถานประกอบการ สามารถติดต่อสอบถามข้อมูลหลักสูตรได้ทุกช่องทาง
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-blue-100 shadow-sm space-y-6">
          <h2 class="text-xl font-bold text-slate-900">ช่องทางการติดต่อ</h2>

          <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100">
            <div class="p-3 rounded-xl bg-blue-50 text-[#0047BA] border border-blue-200">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold text-slate-500 uppercase">อีเมล</p>
              <p class="text-base font-bold text-slate-900 mt-0.5">contact@seriracha.ac.th</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100">
            <div class="p-3 rounded-xl bg-blue-50 text-[#0047BA] border border-blue-200">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold text-slate-500 uppercase">โทรศัพท์</p>
              <p class="text-base font-bold text-slate-900 mt-0.5">038-123-456 (จันทร์ - ศุกร์ 08:30 - 16:30 น.)</p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100">
            <div class="p-3 rounded-xl bg-blue-50 text-[#0047BA] border border-blue-200">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold text-slate-500 uppercase">ที่อยู่สถานศึกษา</p>
              <p class="text-base font-bold text-slate-900 mt-0.5">ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="bg-white p-6 sm:p-8 rounded-2xl border border-blue-100 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 mb-6">ส่งข้อความถึงฝ่ายรับสมัคร</h2>
        <form id="contact-form" class="space-y-4">
          <div>
            <label for="name" class="block text-xs font-semibold text-slate-700 uppercase mb-1">ชื่อ - นามสกุล *</label>
            <input
              type="text"
              id="name"
              required
              class="w-full px-4 py-2.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0047BA] text-sm"
              placeholder="นายสมชาย ใจดี"
            />
          </div>
          <div>
            <label for="email" class="block text-xs font-semibold text-slate-700 uppercase mb-1">อีเมลติดต่อ *</label>
            <input
              type="email"
              id="email"
              required
              class="w-full px-4 py-2.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0047BA] text-sm"
              placeholder="somchai@example.com"
            />
          </div>
          <div>
            <label for="subject" class="block text-xs font-semibold text-slate-700 uppercase mb-1">หัวข้อที่สนใจ</label>
            <select
              id="subject"
              class="w-full px-4 py-2.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-900 focus:outline-none focus:ring-2 focus:ring-[#0047BA] text-sm"
            >
              <option value="admission-voc">สมัครเรียนระดับ ปวช.</option>
              <option value="admission-high">สมัครเรียนระดับ ปวส.</option>
              <option value="internship">ความร่วมมือฝึกงาน / สหกิจศึกษา</option>
              <option value="other">สอบถามข้อมูลทั่วไป</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-xs font-semibold text-slate-700 uppercase mb-1">รายละเอียดข้อความ *</label>
            <textarea
              id="message"
              rows="4"
              required
              class="w-full px-4 py-2.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0047BA] text-sm resize-none"
              placeholder="ระบุข้อความหรือคำถามที่ต้องการสอบถาม..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full py-3.5 px-6 text-sm font-bold text-white bg-[#0047BA] hover:bg-[#003893] rounded-lg shadow-md shadow-blue-600/20 transition-all duration-200"
          >
            ส่งข้อความ
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function setupContactForm() {
    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
    if (contactForm) {
      contactForm.onsubmit = (e) => {
        e.preventDefault();
        alert('ขอบคุณสำหรับข้อความ เจ้าหน้าที่จะติดต่อกลับโดยเร็วที่สุด');
        contactForm.reset();
      };
    }
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
