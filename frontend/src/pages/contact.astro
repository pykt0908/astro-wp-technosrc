---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ข้อมูลการติดต่อ - วิทยาลัยเทคโนโลยีศรีราชา"
  description="ข้อมูลการติดต่อและแผนที่ตั้ง วิทยาลัยเทคโนโลยีศรีราชา 12/19 หมู่ที่ 2 ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี 20230 โทร. 038-352440, 038-351785"
>
  <div class="py-8 sm:py-12 lg:py-16 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold" aria-current="page">ติดต่อเรา</span>
    </nav>

    <!-- Page Title Header -->
    <div class="mb-8 sm:mb-10 pb-6 border-b border-slate-200 dark:border-slate-800 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          ข้อมูลการติดต่อ
        </h1>
        <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2">
          วิทยาลัยเทคโนโลยีศรีราชา (Sriracha Technological College)
        </p>
      </div>

      <a
        href="https://maps.google.com/?q=13.1055718,100.9148445"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 hover:bg-[#0047BA] hover:text-white dark:hover:bg-[#0047BA] dark:hover:text-white transition-colors border border-blue-200 dark:border-blue-900/50 self-start md:self-auto"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
        เปิดดูใน Google Maps
      </a>
    </div>

    <!-- Main Grid: Left = Map, Right = Contact Info -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- ซ้าย: แผนที่ Google Maps (7 cols on lg) -->
      <div class="lg:col-span-7 flex flex-col">
        <div class="relative w-full rounded-2xl overflow-hidden shadow-sm border border-slate-200/80 dark:border-slate-800 bg-slate-100 dark:bg-slate-800 flex-1 min-h-[420px] sm:min-h-[500px] lg:min-h-[560px]">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4432.353774886147!2d100.9148445!3d13.105571800000002!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3102b9c0490daf0d%3A0x64d7370ddd52cff!2z4Lin4Li04LiX4Lii4Liy4Lil4Lix4Lii4LmA4LiX4LiE4LmC4LiZ4LmC4Lil4Lii4Li14Lio4Lij4Li14Lij4Liy4LiK4Liy!5e1!3m2!1sth!2sth!4v1792217824537!5m2!1sth!2sth"
            class="w-full h-full border-0 absolute inset-0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="แผนที่ตั้งวิทยาลัยเทคโนโลยีศรีราชา"
          ></iframe>
        </div>
      </div>

      <!-- ขวา: ข้อมูลติดต่อ (5 cols on lg) -->
      <div class="lg:col-span-5 flex flex-col">
        <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs flex-1 flex flex-col justify-between space-y-6">
          
          <div class="space-y-6">
            <!-- Header -->
            <div class="border-b border-slate-200 dark:border-slate-800 pb-4">
              <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2.5">
                <span class="w-1.5 h-5 rounded-full bg-[#0047BA]"></span>
                ข้อมูลการติดต่อ
              </h2>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                ช่องทางการติดต่อสื่อสารและสอบถามข้อมูล
              </p>
            </div>

            <!-- 1. Address -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 flex items-center justify-center shrink-0 border border-blue-100 dark:border-blue-900/50 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="space-y-1">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">ที่อยู่</span>
                <p class="text-sm sm:text-base text-slate-800 dark:text-slate-200 font-medium leading-relaxed">
                  12/19 หมู่ที่ 2 ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี 20230
                </p>
              </div>
            </div>

            <!-- 2. Phone -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 flex items-center justify-center shrink-0 border border-blue-100 dark:border-blue-900/50 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="space-y-1">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">โทรศัพท์</span>
                <div class="space-y-1">
                  <a href="tel:038352440" class="text-sm sm:text-base font-bold text-slate-800 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors block">
                    038-352440
                  </a>
                  <a href="tel:038351785" class="text-sm sm:text-base font-bold text-slate-800 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors block">
                    038-351785
                  </a>
                </div>
              </div>
            </div>

            <!-- 3. Email -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 flex items-center justify-center shrink-0 border border-blue-100 dark:border-blue-900/50 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="space-y-1">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">อีเมล</span>
                <a href="mailto:technosriracha@gmail.com" class="text-sm sm:text-base font-bold text-slate-800 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors block break-all">
                  technosriracha@gmail.com
                </a>
              </div>
            </div>

            <!-- 4. Website -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 flex items-center justify-center shrink-0 border border-blue-100 dark:border-blue-900/50 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              </div>
              <div class="space-y-1">
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">เว็บไซต์</span>
                <a href="http://www.technosriracha.ac.th" target="_blank" rel="noopener noreferrer" class="text-sm sm:text-base font-bold text-slate-800 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors block">
                  www.technosriracha.ac.th
                </a>
              </div>
            </div>
          </div>

          <!-- Office Hours Footer inside the Card -->
          <div class="pt-5 border-t border-slate-100 dark:border-slate-800 text-xs sm:text-sm text-slate-500 dark:text-slate-400 flex items-center gap-2.5">
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>เวลาทำการ: วันจันทร์ - ศุกร์ 08:30 - 16:30 น. (เว้นวันหยุดราชการ)</span>
          </div>

        </div>
      </div>

    </div>

  </div>
</BaseLayout>
