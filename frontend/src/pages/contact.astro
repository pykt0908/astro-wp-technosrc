---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ติดต่อเรา - วิทยาลัยเทคโนโลยีศรีราชา"
  description="ช่องทางการติดต่อ แผนที่ และการเดินทางมายังวิทยาลัยเทคโนโลยีศรีราชา ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี"
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-semibold text-blue-400 tracking-wider uppercase">ติดต่อวิทยาลัย</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-3 tracking-tight">
        ติดต่อสอบถาม & สมัครเรียน
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300">
        ยินดีต้อนรับนักเรียน นักศึกษา ผู้ปกครอง และสถานประกอบการ สามารถติดต่อสอบถามข้อมูลหลักสูตรได้ทุกช่องทาง
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div class="glass-panel p-8 rounded-2xl border border-blue-900/50 space-y-6">
          <h2 class="text-xl font-bold text-white">ช่องทางการติดต่อ</h2>

          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-blue-600/20 text-blue-400 border border-blue-500/30">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-medium text-slate-400 uppercase">อีเมล</p>
              <p class="text-base font-semibold text-white mt-0.5">contact@seriracha.ac.th</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-indigo-600/20 text-indigo-400 border border-indigo-500/30">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-medium text-slate-400 uppercase">โทรศัพท์</p>
              <p class="text-base font-semibold text-white mt-0.5">038-123-456 (จันทร์ - ศุกร์ 08:30 - 16:30 น.)</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-blue-700/20 text-blue-300 border border-blue-500/30">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-medium text-slate-400 uppercase">ที่อยู่สถานศึกษา</p>
              <p class="text-base font-semibold text-white mt-0.5">ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="glass-panel p-8 sm:p-10 rounded-2xl border border-blue-900/50">
        <h2 class="text-xl font-bold text-white mb-6">ส่งข้อความถึงฝ่ายรับสมัคร</h2>
        <form id="contact-form" class="space-y-4">
          <div>
            <label for="name" class="block text-xs font-medium text-slate-300 uppercase mb-1">ชื่อ - นามสกุล *</label>
            <input
              type="text"
              id="name"
              required
              class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-blue-900/60 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm"
              placeholder="นายสมชาย ใจดี"
            />
          </div>
          <div>
            <label for="email" class="block text-xs font-medium text-slate-300 uppercase mb-1">อีเมลติดต่อ *</label>
            <input
              type="email"
              id="email"
              required
              class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-blue-900/60 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm"
              placeholder="somchai@example.com"
            />
          </div>
          <div>
            <label for="subject" class="block text-xs font-medium text-slate-300 uppercase mb-1">หัวข้อที่สนใจ</label>
            <select
              id="subject"
              class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-blue-900/60 text-white focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm"
            >
              <option value="admission-voc">สมัครเรียนระดับ ปวช.</option>
              <option value="admission-high">สมัครเรียนระดับ ปวส.</option>
              <option value="internship">ความร่วมมือฝึกงาน / สหกิจศึกษา</option>
              <option value="other">สอบถามข้อมูลทั่วไป</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-xs font-medium text-slate-300 uppercase mb-1">รายละเอียดข้อความ *</label>
            <textarea
              id="message"
              rows="4"
              required
              class="w-full px-4 py-2.5 rounded-lg bg-slate-950 border border-blue-900/60 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm resize-none"
              placeholder="ระบุข้อความหรือคำถามที่ต้องการสอบถาม..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full py-3 px-6 text-sm font-semibold text-white bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-700 hover:from-blue-600 hover:to-indigo-600 rounded-lg shadow-lg shadow-blue-700/30 transition-all duration-200 border border-blue-400/20"
          >
            ส่งข้อความ
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('ขอบคุณสำหรับข้อความ เจ้าหน้าที่จะติดต่อกลับโดยเร็วที่สุด');
      contactForm.reset();
    });
  }
</script>
