---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCurriculums, getCurriculumLevels, getCurriculumDepartments } from '../../lib/wordpress';

const curriculums = await getCurriculums();
const levels = await getCurriculumLevels();
const departments = await getCurriculumDepartments();
---

<BaseLayout
  title="หลักสูตรการศึกษา - วิทยาลัยเทคโนโลยีศรีราชา"
  description="หลักสูตรประกาศนียบัตรวิชาชีพ (ปวช.) และประกาศนียบัตรวิชาชีพชั้นสูง (ปวส.) สาขาวิชาช่างอุตสาหกรรม บริหารธุรกิจ และเทคโนโลยีสารสนเทศ วิทยาลัยเทคโนโลยีศรีราชา"
>
  <div class="py-8 sm:py-12 lg:py-16 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold" aria-current="page">หลักสูตรการศึกษา</span>
    </nav>

    <!-- Page Header Hero -->
    <div class="mb-10 sm:mb-12 pb-6 border-b border-slate-200 dark:border-slate-800 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <span class="inline-block px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 text-xs font-bold uppercase tracking-wider mb-2 border border-blue-100 dark:border-blue-900/50">
          Programs & Curriculum
        </span>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          หลักสูตรการศึกษา
        </h1>
        <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2 max-w-2xl">
          เปิดสอนระดับ ปวช. และ ปวส. มุ่งเน้นการปฏิบัติงานจริง ควบคู่คุณธรรม รองรับตลาดแรงงานและเขตพัฒนาพิเศษภาคตะวันออก (EEC)
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-[#0047BA] text-white hover:bg-[#003893] transition-colors shadow-sm"
        >
          <span>สมัครเรียนออนไลน์</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>

    {curriculums.length === 0 ? (
      <div class="text-center py-20 px-6 bg-white dark:bg-slate-900 rounded-3xl border border-dashed border-slate-200 dark:border-slate-800 shadow-xs my-8">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 flex items-center justify-center mb-4 shadow-xs">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">ยังไม่มีข้อมูลหลักสูตรในระบบ</h3>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2 max-w-md mx-auto leading-relaxed">
          สามารถเพิ่มข้อมูลหลักสูตรการศึกษาได้ผ่านระบบจัดการหลังบ้าน WordPress (เมนู "หลักสูตร") พร้อมกำหนดระดับการศึกษา (ปวช., ปวส.) และกลุ่มสาขาวิชา
        </p>
      </div>
    ) : (
      <>
        <!-- Filter Controls: Level Tabs & Department Filter -->
        <div class="mb-8 space-y-4">
          <!-- 1. Level Filter Tabs (ปวช. / ปวส.) -->
          <div class="flex flex-wrap items-center gap-2 p-1.5 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 w-fit">
            <button
              type="button"
              data-level-filter="all"
              class="curr-level-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 bg-white dark:bg-slate-900 text-[#0047BA] dark:text-blue-400 shadow-xs"
            >
              ทั้งหมด ({curriculums.length})
            </button>
            {levels.map((lvl) => {
              const count = curriculums.filter((c) => c.level?.slug === lvl.slug).length;
              return (
                <button
                  type="button"
                  data-level-filter={lvl.slug}
                  class="curr-level-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white"
                >
                  {lvl.name} ({count})
                </button>
              );
            })}
          </div>

          <!-- 2. Department Filter Pills -->
          <div class="flex flex-wrap items-center gap-2 pt-2 text-xs sm:text-sm">
            <span class="text-slate-400 dark:text-slate-500 font-semibold mr-1">กลุ่มสาขา:</span>
            <button
              type="button"
              data-dept-filter="all"
              class="curr-dept-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-colors bg-[#0047BA] text-white"
            >
              ทุกสาขา
            </button>
            {departments.map((dept) => (
              <button
                type="button"
                data-dept-filter={dept.slug}
                class="curr-dept-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-colors bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-blue-300 dark:hover:border-blue-600"
              >
                {dept.name}
              </button>
            ))}
          </div>
        </div>

        <!-- Curriculums Cards Grid -->
        <div id="curriculums-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {curriculums.map((item) => {
        const isVoc = item.level?.slug === 'vocational';
        return (
          <article
            data-level={item.level?.slug || ''}
            data-department={item.department?.slug || ''}
            class="curr-card group bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-7 shadow-xs hover:border-blue-300 dark:hover:border-blue-700 hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
          >
            <div class="space-y-4">
              <!-- Top Badges -->
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <div class="flex items-center gap-2 flex-wrap">
                  <!-- Level Badge -->
                  <span
                    class={`inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold ${
                      isVoc
                        ? 'bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 border border-blue-200 dark:border-blue-900/50'
                        : 'bg-orange-50 dark:bg-orange-950/80 text-[#EA580C] dark:text-orange-400 border border-orange-200 dark:border-orange-900/50'
                    }`}
                  >
                    {item.level?.name || 'หลักสูตร'}
                  </span>

                  <!-- Department Badge -->
                  {item.department && (
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                      {item.department.name}
                    </span>
                  )}
                </div>

                <!-- Special Badge if any -->
                {item.meta?.badge && (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-amber-50 dark:bg-amber-950/80 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-900/50">
                    ★ {item.meta.badge}
                  </span>
                )}
              </div>

              <!-- Title -->
              <div>
                <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-[#0047BA] dark:group-hover:text-blue-400 transition-colors">
                  <a href={`/curriculum/${item.slug}/`}>
                    {item.title}
                  </a>
                </h2>
                {item.meta?.degreeEn && (
                  <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 line-clamp-1 font-mono">
                    {item.meta.degreeEn}
                  </p>
                )}
              </div>

              <!-- Excerpt -->
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 line-clamp-3 leading-relaxed">
                {item.excerpt}
              </p>

              <!-- Meta Features -->
              <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 grid grid-cols-2 gap-2 text-xs text-slate-500 dark:text-slate-400">
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>ระยะเวลา: <strong>{item.meta?.duration || '3 ปี'}</strong></span>
                </div>
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="truncate" title={item.meta?.requirements}>{isVoc ? 'รับ ม.3' : 'รับ ปวช./ม.6'}</span>
                </div>
              </div>

              <!-- Highlights snippet (first 2) -->
              {item.meta?.highlights && item.meta.highlights.length > 0 && (
                <ul class="space-y-1.5 pt-1 text-xs text-slate-600 dark:text-slate-400">
                  {item.meta.highlights.slice(0, 2).map((hl) => (
                    <li class="flex items-start gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#0047BA] dark:bg-blue-400 shrink-0 mt-1.5"></span>
                      <span class="line-clamp-1">{hl}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <!-- Footer Action Button -->
            <div class="pt-5 mt-5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-3">
              <a
                href={`/curriculum/${item.slug}/`}
                class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-[#0047BA] dark:text-blue-400 hover:underline"
              >
                <span>รายละเอียดหลักสูตร</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </a>

              <a
                href="/contact/"
                class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-[#0047BA] hover:text-white dark:hover:bg-[#0047BA] dark:hover:text-white transition-colors"
              >
                สมัครเรียน
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Empty Filter Notice -->
    <div id="curr-empty-state" class="hidden text-center py-16 px-4 bg-slate-50 dark:bg-slate-900 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 mt-8">
      <div class="w-14 h-14 mx-auto rounded-full bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 flex items-center justify-center mb-4">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-slate-800 dark:text-slate-200">ไม่พบหลักสูตรในเงื่อนไขที่เลือก</h3>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">โปรดเลือกตัวกรองระดับการศึกษาหรือกลุ่มสาขาวิชาอื่น</p>
      <button
        type="button"
        id="btn-reset-curr-filters"
        class="mt-4 px-4 py-2 rounded-xl text-xs font-bold bg-[#0047BA] text-white hover:bg-[#003893] transition-colors"
      >
        รีเซ็ตตัวกรองทั้งหมด
      </button>
    </div>
    </>
    )}

    <!-- Bottom Admission Help Banner -->
    <div class="mt-14 p-8 sm:p-10 rounded-2xl bg-gradient-to-r from-[#002D72] via-[#0047BA] to-blue-700 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-md">
      <div class="space-y-2 text-center md:text-left">
        <span class="inline-block px-3 py-1 rounded-full bg-white/10 text-blue-100 text-xs font-bold uppercase tracking-wider backdrop-blur-xs">
          Admission Open
        </span>
        <h2 class="text-xl sm:text-2xl font-bold text-white">ต้องการคำแนะนำการเลือกหลักสูตรที่เหมาะสม?</h2>
        <p class="text-xs sm:text-sm text-blue-100/90 max-w-xl">
          ฝ่ายแนะแนวการศึกษาพร้อมให้คำปรึกษา แนะนำสาขาวิชา โควตาพิเศษ และทุนการศึกษาสำหรับนักเรียนใหม่
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/contact/"
          class="px-6 py-3 rounded-xl text-sm font-bold bg-white text-[#0047BA] hover:bg-blue-50 transition-colors shadow-sm"
        >
          ติดต่อสอบถาม / สมัครเรียน
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  function setupCurriculumFilters() {
    let currentLevel = 'all';
    let currentDept = 'all';

    const levelBtns = document.querySelectorAll<HTMLButtonElement>('.curr-level-btn');
    const deptBtns = document.querySelectorAll<HTMLButtonElement>('.curr-dept-btn');
    const cards = document.querySelectorAll<HTMLElement>('.curr-card');
    const emptyState = document.getElementById('curr-empty-state');
    const resetBtn = document.getElementById('btn-reset-curr-filters');

    function applyFilter() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardLevel = card.getAttribute('data-level') || '';
        const cardDept = card.getAttribute('data-department') || '';

        const matchLevel = currentLevel === 'all' || cardLevel === currentLevel;
        const matchDept = currentDept === 'all' || cardDept === currentDept;

        if (matchLevel && matchDept) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    levelBtns.forEach((btn) => {
      btn.onclick = () => {
        const lvl = btn.getAttribute('data-level-filter') || 'all';
        currentLevel = lvl;

        // update active classes
        levelBtns.forEach((b) => {
          b.className = 'curr-level-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white';
        });
        btn.className = 'curr-level-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 bg-white dark:bg-slate-900 text-[#0047BA] dark:text-blue-400 shadow-xs';

        applyFilter();
      };
    });

    deptBtns.forEach((btn) => {
      btn.onclick = () => {
        const dept = btn.getAttribute('data-dept-filter') || 'all';
        currentDept = dept;

        // update active classes
        deptBtns.forEach((b) => {
          b.className = 'curr-dept-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-colors bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-blue-300 dark:hover:border-blue-600';
        });
        btn.className = 'curr-dept-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-colors bg-[#0047BA] text-white';

        applyFilter();
      };
    });

    if (resetBtn) {
      resetBtn.onclick = () => {
        currentLevel = 'all';
        currentDept = 'all';

        levelBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.className = 'curr-level-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 bg-white dark:bg-slate-900 text-[#0047BA] dark:text-blue-400 shadow-xs';
          } else {
            b.className = 'curr-level-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white';
          }
        });

        deptBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.className = 'curr-dept-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-colors bg-[#0047BA] text-white';
          } else {
            b.className = 'curr-dept-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-colors bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-blue-300 dark:hover:border-blue-600';
          }
        });

        applyFilter();
      };
    }
  }

  setupCurriculumFilters();
  document.addEventListener('astro:page-load', setupCurriculumFilters);
</script>
