---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCurriculums, getCurriculumLevels } from '../../lib/wordpress';

const curriculums = await getCurriculums();
const rawLevels = await getCurriculumLevels();
const levels = rawLevels || [];
---

<BaseLayout
  title="หลักสูตรการศึกษา - วิทยาลัยเทคโนโลยีศรีราชา"
  description="หลักสูตรประกาศนียบัตรวิชาชีพ (ปวช.) และประกาศนียบัตรวิชาชีพชั้นสูง (ปวส.) สาขาวิชาช่างอุตสาหกรรม บริหารธุรกิจ และเทคโนโลยีสารสนเทศ วิทยาลัยเทคโนโลยีศรีราชา"
>
  <div class="py-8 sm:py-12 lg:py-16 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold" aria-current="page">หลักสูตรการศึกษา</span>
    </nav>

    <!-- Page Header Hero -->
    <div class="mb-10 sm:mb-12 pb-6 border-b border-slate-200 dark:border-slate-800 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          หลักสูตรการศึกษา
        </h1>
        <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2 max-w-2xl">
          สอนระดับ ปวช. และ ปวส. มุ่งเน้นการปฏิบัติงานจริง รองรับตลาดแรงงานและเขตพัฒนาพิเศษภาคตะวันออก
        </p>
      </div>

      <!-- Level Selector Tabs -->
      {levels.length > 0 && (
        <div class="flex items-center">
          <div class="flex items-center gap-1.5 p-1.5 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs">
            {levels.map((lvl, idx) => (
              <button
                type="button"
                data-level-filter={lvl.slug}
                class={`curr-level-btn px-4 py-2 sm:px-5 sm:py-2.5 rounded-xl text-xs sm:text-sm transition-all duration-200 ${
                  idx === 0
                    ? 'bg-white dark:bg-slate-900 text-[#0047BA] dark:text-blue-400 font-bold shadow-xs'
                    : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-semibold'
                }`}
              >
                {lvl.name}
              </button>
            ))}
          </div>
        </div>
      )}
    </div>

    {curriculums.length === 0 ? (
      <div class="text-center py-20 px-6 bg-white dark:bg-slate-900 rounded-3xl border border-dashed border-slate-200 dark:border-slate-800 shadow-xs my-8">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 flex items-center justify-center mb-4 shadow-xs">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">-- ยังไม่มีข้อมูลหลักสูตรในระบบ --</h3>
        
      </div>
    ) : (
      <>

        <!-- Curriculums Cards Grid (4 Columns on Desktop) -->
        <div id="curriculums-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5 lg:gap-6">
      {curriculums.map((item) => {
        const isHighVoc = item.level?.slug === 'high-vocational' || item.title.includes('ปวส');
        const levelSlug = item.level?.slug || (isHighVoc ? 'high-vocational' : 'vocational');
        return (
          <article
            data-level={item.level?.slug || ''}
            data-department={item.department?.slug || ''}
            class="curr-card group bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-xs hover:border-blue-300 dark:hover:border-blue-700 hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden"
          >
            <div>
              <!-- Featured Image Header -->
              <a
                href={`/curriculum/${levelSlug}/${item.slug}/`}
                class="relative block aspect-[16/9] w-full overflow-hidden bg-slate-100 dark:bg-slate-800 focus:outline-none"
              >
                {item.featuredImage ? (
                  <img
                    src={item.featuredImage}
                    alt={item.title}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-blue-50 via-slate-50 to-indigo-50 dark:from-slate-800 dark:via-slate-850 dark:to-slate-900 text-[#0047BA] dark:text-blue-400 group-hover:scale-105 transition-transform duration-500">
                    <svg class="w-12 h-12 opacity-35 dark:opacity-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                    </svg>
                  </div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/15 to-transparent opacity-60 group-hover:opacity-40 transition-opacity"></div>

                <!-- Floating Badges on Top of Image -->
                <div class="absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between gap-1.5 pointer-events-none">
                  {item.meta?.badge && (
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-400 text-amber-950 shadow-xs">
                      {item.meta.badge}
                    </span>
                  )}
                </div>
              </a>

              <!-- Card Content Body -->
              <div class="p-5 space-y-3">
                <!-- Title -->
                <div>
                  <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-[#0047BA] dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                    <a href={`/curriculum/${levelSlug}/${item.slug}/`}>
                      {item.title}
                    </a>
                  </h2>
                </div>

                <!-- Highlights snippet (first 2) -->
                {item.meta?.highlights && item.meta.highlights.length > 0 && (
                  <ul class="space-y-1 pt-0.5 text-[11px] text-slate-600 dark:text-slate-400">
                    {item.meta.highlights.slice(0, 2).map((hl) => (
                      <li class="flex items-start gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#0047BA] dark:bg-blue-400 shrink-0 mt-1"></span>
                        <span class="line-clamp-1">{hl}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>

            <!-- Footer Action Button -->
            <div class="px-5 pb-5 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2">
              <a
                href={`/curriculum/${levelSlug}/${item.slug}/`}
                class="inline-flex items-center gap-1 text-xs font-bold text-[#0047BA] dark:text-blue-400 hover:underline"
              >
                <span>รายละเอียด</span>
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </a>

              <a
                href="/contact/"
                class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-[#0047BA] hover:text-white dark:hover:bg-[#0047BA] dark:hover:text-white transition-colors"
              >
                สมัครเรียน
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Empty Filter Notice -->
    <div id="curr-empty-state" class="hidden text-center py-16 px-4 bg-slate-50 dark:bg-slate-900 rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 mt-8">
      <div class="w-14 h-14 mx-auto rounded-full bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 flex items-center justify-center mb-4">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-slate-800 dark:text-slate-200">ไม่พบหลักสูตรในเงื่อนไขที่เลือก</h3>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">โปรดเลือกตัวกรองระดับการศึกษาหรือกลุ่มสาขาวิชาอื่น</p>
      <button
        type="button"
        id="btn-reset-curr-filters"
        class="mt-4 px-4 py-2 rounded-xl text-xs font-bold bg-[#0047BA] text-white hover:bg-[#003893] transition-colors"
      >
        รีเซ็ตตัวกรองทั้งหมด
      </button>
    </div>
    </>
    )}

    <!-- Bottom Admission Help Banner -->
    <div class="mt-14 p-8 sm:p-10 rounded-2xl bg-gradient-to-r from-[#002D72] via-[#0047BA] to-blue-700 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-md">
      <div class="space-y-2 text-center md:text-left">
        <span class="inline-block px-3 py-1 rounded-full bg-white/10 text-blue-100 text-xs font-bold uppercase tracking-wider backdrop-blur-xs">
          Admission Open
        </span>
        <h2 class="text-xl sm:text-2xl font-bold text-white">ต้องการคำแนะนำการเลือกหลักสูตรที่เหมาะสม?</h2>
        <p class="text-xs sm:text-sm text-blue-100/90 max-w-xl">
          ฝ่ายแนะแนวการศึกษาพร้อมให้คำปรึกษา แนะนำสาขาวิชา โควตาพิเศษ และทุนการศึกษาสำหรับนักเรียนใหม่
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/contact/"
          class="px-6 py-3 rounded-xl text-sm font-bold bg-white text-[#0047BA] hover:bg-blue-50 transition-colors shadow-sm"
        >
          ติดต่อสอบถาม / สมัครเรียน
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  function setupCurriculumFilters() {
    const levelBtns = document.querySelectorAll<HTMLButtonElement>('.curr-level-btn');
    const cards = document.querySelectorAll<HTMLElement>('.curr-card');
    const emptyState = document.getElementById('curr-empty-state');
    const resetBtn = document.getElementById('btn-reset-curr-filters');

    const firstLevelBtn = document.querySelector<HTMLButtonElement>('.curr-level-btn');
    const defaultLevel = firstLevelBtn ? firstLevelBtn.getAttribute('data-level-filter') || 'vocational' : 'vocational';
    
    // Check if level is specified in URL query (?level=vocational or ?level=high-vocational)
    const urlParams = new URLSearchParams(window.location.search);
    const paramLevel = urlParams.get('level');
    const isValidParam = paramLevel && Array.from(levelBtns).some((b) => b.getAttribute('data-level-filter') === paramLevel);
    let currentLevel = isValidParam ? (paramLevel as string) : defaultLevel;

    // Synchronize initial level buttons style with currentLevel
    levelBtns.forEach((b) => {
      const lvl = b.getAttribute('data-level-filter');
      if (lvl === currentLevel) {
        b.className = 'curr-level-btn px-4 py-2 sm:px-5 sm:py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 bg-white dark:bg-slate-900 text-[#0047BA] dark:text-blue-400 shadow-xs';
      } else {
        b.className = 'curr-level-btn px-4 py-2 sm:px-5 sm:py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white';
      }
    });

    function applyFilter() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardLevel = card.getAttribute('data-level') || '';
        const matchLevel = !currentLevel || cardLevel === currentLevel;

        if (matchLevel) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    levelBtns.forEach((btn) => {
      btn.onclick = () => {
        const lvl = btn.getAttribute('data-level-filter') || defaultLevel;
        currentLevel = lvl;

        // update active classes
        levelBtns.forEach((b) => {
          b.className = 'curr-level-btn px-4 py-2 sm:px-5 sm:py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white';
        });
        btn.className = 'curr-level-btn px-4 py-2 sm:px-5 sm:py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 bg-white dark:bg-slate-900 text-[#0047BA] dark:text-blue-400 shadow-xs';

        applyFilter();
      };
    });

    if (resetBtn) {
      resetBtn.onclick = () => {
        currentLevel = defaultLevel;

        levelBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.className = 'curr-level-btn px-4 py-2 sm:px-5 sm:py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 bg-white dark:bg-slate-900 text-[#0047BA] dark:text-blue-400 shadow-xs';
          } else {
            b.className = 'curr-level-btn px-4 py-2 sm:px-5 sm:py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white';
          }
        });

        applyFilter();
      };
    }

    applyFilter();
  }

  setupCurriculumFilters();
  document.addEventListener('astro:page-load', setupCurriculumFilters);
</script>
