---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCurriculums, getCurriculumBySlug, type CurriculumItem } from '../../lib/wordpress';

export async function getStaticPaths() {
  const allCurriculums = await getCurriculums();
  return allCurriculums.map((item) => ({
    params: { slug: item.slug },
    props: { curriculum: item },
  }));
}

interface Props {
  curriculum: CurriculumItem;
}

const { slug } = Astro.params;
const { curriculum: propCurriculum } = Astro.props;

// If accessed directly or during dynamic render
const curriculum = propCurriculum || (await getCurriculumBySlug(slug as string));

if (!curriculum) {
  return Astro.redirect('/curriculum/');
}

const allCurriculums = await getCurriculums();
const relatedCurriculums = allCurriculums
  .filter((c) => c.id !== curriculum.id && (c.level?.slug === curriculum.level?.slug || c.department?.slug === curriculum.department?.slug))
  .slice(0, 3);

const isVoc = curriculum.level?.slug === 'vocational';
---

<BaseLayout
  title={`${curriculum.title} - วิทยาลัยเทคโนโลยีศรีราชา`}
  description={curriculum.excerpt || `${curriculum.title} ${curriculum.meta?.degreeTh || ''} วิทยาลัยเทคโนโลยีศรีราชา`}
>
  <div class="py-8 sm:py-12 lg:py-16 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6 flex-wrap" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <span>/</span>
      <a href="/curriculum/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หลักสูตรการศึกษา</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold truncate max-w-[260px] sm:max-w-none" aria-current="page">
        {curriculum.title}
      </span>
    </nav>

    <!-- Header Section -->
    <div class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800 space-y-4">
      <div class="flex items-center gap-2 flex-wrap">
        <!-- Level Badge -->
        <span
          class={`inline-flex items-center px-3 py-1 rounded-xl text-xs font-bold ${
            isVoc
              ? 'bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 border border-blue-200 dark:border-blue-900/50'
              : 'bg-orange-50 dark:bg-orange-950/80 text-[#EA580C] dark:text-orange-400 border border-orange-200 dark:border-orange-900/50'
          }`}
        >
          {curriculum.level?.name || 'หลักสูตร'}
        </span>

        <!-- Department Badge -->
        {curriculum.department && (
          <span class="inline-flex items-center px-3 py-1 rounded-xl text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
            {curriculum.department.name}
          </span>
        )}

        <!-- Special Badge -->
        {curriculum.meta?.badge && (
          <span class="inline-flex items-center px-3 py-1 rounded-xl text-xs font-bold bg-amber-50 dark:bg-amber-950/80 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-900/50">
            ★ {curriculum.meta.badge}
          </span>
        )}
      </div>

      <div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          {curriculum.title}
        </h1>
        {curriculum.meta?.degreeEn && (
          <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-1 font-mono">
            {curriculum.meta.degreeEn}
          </p>
        )}
      </div>

      {curriculum.meta?.degreeTh && (
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
          <span class="font-bold text-slate-900 dark:text-white">วุฒิการศึกษา:</span>
          <span>{curriculum.meta.degreeTh}</span>
        </div>
      )}
    </div>

    <!-- Main Grid Layout (Left: Content, Right: Quick Fact Sidebar) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Main Content (8 cols) -->
      <div class="lg:col-span-8 space-y-10">
        
        <!-- Overview / About -->
        <section class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-4">
          <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center gap-2.5">
            <span class="w-1.5 h-5 rounded-full bg-[#0047BA]"></span>
            <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
              ภาพรวมและรายละเอียดหลักสูตร
            </h2>
          </div>

          <div class="prose prose-slate dark:prose-invert max-w-none text-sm sm:text-base leading-relaxed">
            {curriculum.content ? (
              <Fragment set:html={curriculum.content} />
            ) : (
              <p>{curriculum.excerpt}</p>
            )}
          </div>
        </section>

        <!-- Highlights & Skills -->
        {curriculum.meta?.highlights && curriculum.meta.highlights.length > 0 && (
          <section class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center gap-2.5">
              <span class="w-1.5 h-5 rounded-full bg-[#0047BA]"></span>
              <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                จุดเด่นและทักษะที่จะได้รับ
              </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2">
              {curriculum.meta.highlights.map((hl) => (
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                  <div class="w-5 h-5 rounded-full bg-blue-100 dark:bg-blue-900/60 text-[#0047BA] dark:text-blue-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                  </div>
                  <span class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 font-medium leading-relaxed">
                    {hl}
                  </span>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Career Opportunities -->
        {curriculum.meta?.careers && curriculum.meta.careers.length > 0 && (
          <section class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-4">
            <div class="border-b border-slate-100 dark:border-slate-800 pb-3 flex items-center gap-2.5">
              <span class="w-1.5 h-5 rounded-full bg-[#0047BA]"></span>
              <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                แนวทางการประกอบอาชีพและความก้าวหน้า
              </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2">
              {curriculum.meta.careers.map((career) => (
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                  <div class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                  </div>
                  <span class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 font-medium leading-relaxed">
                    {career}
                  </span>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Study Plan Download if available -->
        {curriculum.meta?.studyPlanUrl && (
          <div class="p-6 rounded-2xl bg-blue-50/70 dark:bg-blue-950/40 border border-blue-100 dark:border-blue-900/50 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-bold text-slate-900 dark:text-white">เอกสารแผนการเรียนตลอดหลักสูตร (PDF)</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">โครงสร้างรายวิชาและจำนวนหน่วยกิต</p>
              </div>
            </div>

            <a
              href={curriculum.meta.studyPlanUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-[#0047BA] text-white hover:bg-[#003893] transition-colors shrink-0 flex items-center gap-2"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              <span>ดาวน์โหลดแผนการเรียน</span>
            </a>
          </div>
        )}

      </div>

      <!-- Sidebar (4 cols) -->
      <div class="lg:col-span-4 space-y-6">
        
        <!-- Quick Facts Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-5">
          <h3 class="text-base font-bold text-slate-900 dark:text-white pb-3 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2">
            <span class="w-1.5 h-4 rounded-full bg-[#0047BA]"></span>
            ข้อมูลหลักสูตรโดยย่อ
          </h3>

          <div class="space-y-3.5 text-xs sm:text-sm">
            <!-- Level -->
            <div>
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">ระดับการศึกษา</span>
              <p class="font-bold text-slate-800 dark:text-slate-200 mt-0.5">
                {curriculum.level?.name || 'หลักสูตรอาชีวศึกษา'}
              </p>
            </div>

            <!-- Department -->
            {curriculum.department && (
              <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">กลุ่มสาขาวิชา</span>
                <p class="font-bold text-slate-800 dark:text-slate-200 mt-0.5">
                  {curriculum.department.name}
                </p>
              </div>
            )}

            <!-- Duration -->
            <div>
              <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">ระยะเวลาการศึกษา</span>
              <p class="font-bold text-slate-800 dark:text-slate-200 mt-0.5">
                {curriculum.meta?.duration || '3 ปี'}
              </p>
            </div>

            <!-- Requirements -->
            {curriculum.meta?.requirements && (
              <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">คุณสมบัติผู้สมัคร</span>
                <p class="text-slate-700 dark:text-slate-300 mt-0.5 leading-relaxed">
                  {curriculum.meta.requirements}
                </p>
              </div>
            )}

            <!-- Tuition -->
            {curriculum.meta?.tuitionFee && (
              <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">ค่าธรรมเนียมการศึกษา</span>
                <p class="text-slate-700 dark:text-slate-300 mt-0.5">
                  {curriculum.meta.tuitionFee}
                </p>
              </div>
            )}
          </div>

          <div class="pt-4 border-t border-slate-100 dark:border-slate-800 space-y-2.5">
            <a
              href="/contact/"
              class="w-full py-3 px-4 text-center rounded-xl text-sm font-bold text-white bg-[#0047BA] hover:bg-[#003893] transition-colors shadow-sm block"
            >
              สมัครเรียนหลักสูตรนี้
            </a>
            <a
              href="/curriculum/"
              class="w-full py-2.5 px-4 text-center rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-50 dark:bg-slate-800/80 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors block border border-slate-200 dark:border-slate-700"
            >
              &larr; ดูหลักสูตรทั้งหมด
            </a>
          </div>
        </div>

        <!-- Contact Admissions Box -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 text-xs sm:text-sm space-y-3">
          <h4 class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <svg class="w-4 h-4 text-[#0047BA] dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            สอบถามข้อมูลการรับสมัคร
          </h4>
          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            ฝ่ายแนะแนวการศึกษาและรับสมัครนักศึกษาใหม่
          </p>
          <div class="space-y-1 font-semibold text-slate-800 dark:text-slate-200">
            <p>โทร. <a href="tel:038352440" class="hover:text-[#0047BA] dark:hover:text-blue-400">038-352440</a></p>
            <p>โทร. <a href="tel:038351785" class="hover:text-[#0047BA] dark:hover:text-blue-400">038-351785</a></p>
          </div>
          <p class="text-slate-400 text-[11px] pt-1">วันจันทร์ - ศุกร์ 08:30 - 16:30 น.</p>
        </div>

        <!-- Related Curriculums -->
        {relatedCurriculums.length > 0 && (
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs space-y-3">
            <h4 class="text-sm font-bold text-slate-900 dark:text-white pb-2 border-b border-slate-100 dark:border-slate-800">
              หลักสูตรอื่นที่น่าสนใจ
            </h4>
            <div class="space-y-2.5">
              {relatedCurriculums.map((rel) => (
                <a
                  href={`/curriculum/${rel.slug}/`}
                  class="block p-3 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800/80 transition-colors group/rel border border-transparent hover:border-slate-200 dark:hover:border-slate-700"
                >
                  <span class="text-[11px] font-bold text-slate-400 block">{rel.level?.name}</span>
                  <span class="text-xs sm:text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover/rel:text-[#0047BA] dark:group-hover/rel:text-blue-400 block transition-colors">
                    {rel.title}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>

    </div>

  </div>
</BaseLayout>
