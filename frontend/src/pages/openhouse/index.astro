  <!-- Interactive Filtering & Copy Scripts -->
  <script is:inline>
    function initOpenHousePage() {
      // 1. Dynamic category pill filter
      const pills = document.querySelectorAll('.filter-pill');
      const cards = document.querySelectorAll('.activity-card');
      const emptyState = document.getElementById('no-activities-found');
      const searchInput = document.getElementById('activity-search-input');

      let currentCat = 'all';
      let currentQuery = '';

      function applyFilters() {
        let visibleCount = 0;
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-cat-slug') || '';
          const cardSearch = card.getAttribute('data-search-text') || '';

          const matchCat = (currentCat === 'all' || cardCat === currentCat);
          const matchQuery = (!currentQuery || cardSearch.includes(currentQuery));

          if (matchCat && matchQuery) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (emptyState) {
          emptyState.style.display = (visibleCount === 0) ? 'block' : 'none';
        }
      }

      pills.forEach((p) => {
        p.onclick = function() {
          pills.forEach((btn) => {
            btn.classList.remove('bg-[#0047BA]', 'text-white', 'shadow-2xs');
            btn.classList.add('bg-white', 'hover:bg-slate-100', 'dark:bg-slate-900', 'dark:hover:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'font-medium');
          });

          p.classList.remove('bg-white', 'hover:bg-slate-100', 'dark:bg-slate-900', 'dark:hover:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'font-medium');
          p.classList.add('bg-[#0047BA]', 'text-white', 'shadow-2xs');

          currentCat = p.getAttribute('data-cat') || 'all';
          applyFilters();
        };
      });

      if (searchInput) {
        searchInput.oninput = function(e) {
          currentQuery = (e.target.value || '').trim().toLowerCase();
          applyFilters();
        };
      }

      // 2. Copy Link Buttons with Toast Feedback
      const toast = document.getElementById('oh-toast');
      function setupCopy(btnId) {
        const btn = document.getElementById(btnId);
        if (!btn) return;
        btn.onclick = async function() {
          const url = window.location.origin + '/openhouse';
          try {
            await navigator.clipboard.writeText(url);
            if (toast) {
              toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
              setTimeout(() => {
                toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
              }, 2500);
            }
          } catch (err) {
            prompt('คัดลอกลิงก์:', url);
          }
        };
      }

      setupCopy('header-copy-link-btn');
      setupCopy('section-copy-btn');

      // Update share input with live origin
      const shareInput = document.getElementById('share-link-input');
      if (shareInput) {
        shareInput.value = window.location.origin + '/openhouse';
      }
    }

    document.addEventListener('DOMContentLoaded', initOpenHousePage);
    document.addEventListener('astro:page-load', initOpenHousePage);
  </script>
</BaseLayout>
