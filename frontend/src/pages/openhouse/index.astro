        <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-800 p-5 bg-slate-50 dark:bg-slate-800/40 text-center flex flex-col items-center justify-center min-h-[220px]">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-[#0047BA] dark:bg-blue-950 dark:text-sky-400 flex items-center justify-center text-xl mb-2">
