              <span class="text-base">💬</span>
              <div>
                <strong class="text-slate-900 dark:text-white">LINE Official Account:</strong>
                <span class="text-slate-600 dark:text-slate-400 ml-1">{info.contactLine || '@sriracha'}</span>
