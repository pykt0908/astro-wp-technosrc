---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDownloads, getDownloadCategories } from '../../lib/wordpress';
import type { DownloadItem, DownloadCategory } from '../../lib/wordpress';

// Fetch downloads and categories from WordPress API (with resilient fallback)
const [rawCategories, rawDownloads] = await Promise.all([
  getDownloadCategories(),
  getDownloads(),
]);

// Sort categories by order ASC
const categories = [...rawCategories].sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

// Sort downloads: order ASC, then publishedAt DESC
const downloads = [...rawDownloads].sort((a, b) => {
  if ((a.order ?? 0) !== (b.order ?? 0)) {
    return (a.order ?? 0) - (b.order ?? 0);
  }
  return new Date(b.publishedAt || 0).getTime() - new Date(a.publishedAt || 0).getTime();
});

// Calculate total downloads
const totalDownloads = downloads.length;

// Group downloads by category
const categoriesWithDocs = categories.map((cat) => {
  const docs = downloads.filter((d) => d.category?.slug === cat.slug);
  return {
    ...cat,
    docs,
  };
});

// Uncategorized documents
const uncategorizedDocs = downloads.filter(
  (d) => !d.category || !categories.some((c) => c.slug === d.category?.slug)
);
if (uncategorizedDocs.length > 0) {
  categoriesWithDocs.push({
    id: 99999,
    name: categories.length === 0 ? 'เอกสารทั้งหมด' : 'เอกสารทั่วไป / อื่นๆ',
    slug: categories.length === 0 ? 'all-docs' : 'other',
    description: categories.length === 0 ? '' : 'เอกสารและแบบฟอร์มทั่วไปของวิทยาลัย',
    count: uncategorizedDocs.length,
    order: 999,
    docs: uncategorizedDocs,
  });
}

// Only display categories that actually contain documents
const displayCategories = categoriesWithDocs.filter((c) => c.docs.length > 0);
const hasCategories = displayCategories.length > 0;

// Format Thai Date
function formatThaiDate(dateStr?: string) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  return d.toLocaleDateString('th-TH', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

// Decode HTML entities (e.g. &#038; -> &)
function decodeHtmlEntities(str?: string) {
  if (!str) return '';
  return str
    .replace(/&#038;/g, '&')
    .replace(/&amp;/g, '&')
    .replace(/&#8211;/g, '–')
    .replace(/&#8212;/g, '—')
    .replace(/&#8216;/g, '‘')
    .replace(/&#8217;/g, '’')
    .replace(/&#8220;/g, '“')
    .replace(/&#8221;/g, '”')
    .replace(/&quot;/g, '"')
    .replace(/&#039;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>');
}
---

<BaseLayout
  title="ศูนย์ดาวน์โหลดเอกสารและแบบฟอร์ม - วิทยาลัยเทคโนโลยีศรีราชา"
  description="ศูนย์ดาวน์โหลดเอกสาร แบบฟอร์มคำร้องทั่วไป ระเบียบปฏิบัติ ข้อบังคับ และคู่มือนักศึกษา วิทยาลัยเทคโนโลยีศรีราชา (S-TECH) ดาวน์โหลดเอกสารและเปิดดูตัวอย่างออนไลน์"
>
  <div class="py-8 sm:py-12 lg:py-16 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold" aria-current="page">ดาวน์โหลด</span>
    </nav>

    <!-- Page Title & Overview Header -->
    <div class="mb-8 sm:mb-12 pb-6 border-b border-slate-200 dark:border-slate-800">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/40 text-xs font-bold text-[#0047BA] dark:text-sky-300 border border-blue-200/50 dark:border-blue-800/50 mb-3">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>DOWNLOAD CENTER</span>
          </div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            ศูนย์ดาวน์โหลดเอกสารและแบบฟอร์ม
          </h1>
          <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2 max-w-2xl font-normal leading-relaxed">
            รวบรวมแบบฟอร์มคำร้องทางการ ระเบียบปฏิบัติ ข้อบังคับ และคู่มือนักศึกษาของวิทยาลัยเทคโนโลยีศรีราชา เพื่อความสะดวกรวดเร็วในการติดต่อประสานงาน
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <div class="px-4 py-2.5 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700 text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300">
            เอกสารทั้งหมด <span class="text-[#0047BA] dark:text-sky-400 font-bold" id="header-total-count">{totalDownloads}</span> รายการ
          </div>
        </div>
      </div>
    </div>

    <!-- MAIN TWO-COLUMN GRID: LEFT TOC SIDEBAR + RIGHT CONTENT AREA -->
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-10 items-start scroll-mt-28" id="downloads-main-content">
      
      <!-- ================= LEFT COLUMN: TABLE OF CONTENTS (สารบัญหมวดหมู่) ================= -->
      {hasCategories && (
        <aside class="w-full lg:w-68 xl:w-76 shrink-0 lg:sticky lg:top-28 z-20">
          <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 p-4 sm:p-5 shadow-xs">
            
            <!-- TOC Header -->
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-200 dark:border-slate-800">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-[#0047BA] dark:text-sky-400 flex items-center justify-center">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h10" />
                  </svg>
                </div>
                <h2 class="text-sm font-bold text-slate-900 dark:text-white">
                  สารบัญหมวดหมู่
                </h2>
              </div>
              <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                {displayCategories.length} หมวด
              </span>
            </div>

            <!-- TOC Navigation List -->
            <nav class="space-y-1" id="toc-nav" aria-label="Table of Contents">
              
              <!-- Quick Link: ดูทั้งหมด (Top of List) -->
              <a
                href="#downloads-main-content"
                data-target="all"
                class="toc-link active flex items-center justify-between px-3 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition-all cursor-pointer text-[#0047BA] dark:text-sky-300 bg-blue-50/80 dark:bg-blue-950/50"
              >
                <span class="flex items-center gap-2 truncate">
                  <span class="toc-dot w-1.5 h-1.5 rounded-full bg-[#0047BA] dark:bg-sky-400 shrink-0"></span>
                  <span>เอกสารทั้งหมด</span>
                </span>
                <span class="toc-count text-[11px] font-mono font-bold px-2 py-0.5 rounded-full bg-white dark:bg-slate-900 text-[#0047BA] dark:text-sky-300 shadow-xs">
                  {totalDownloads}
                </span>
              </a>

              <!-- Category TOC Links (Ordered by WordPress Order) -->
              {displayCategories.map((cat, index) => {
                return (
                  <a
                    href={`#cat-${cat.slug}`}
                    data-target={`cat-${cat.slug}`}
                    class="toc-link flex items-center justify-between px-3 py-2.5 rounded-xl text-xs sm:text-sm font-medium transition-all cursor-pointer text-slate-600 dark:text-slate-400 hover:text-[#0047BA] dark:hover:text-sky-300 hover:bg-slate-50 dark:hover:bg-slate-800/60"
                  >
                    <span class="flex items-center gap-2.5 truncate">
                      <span class="toc-number font-mono text-[11px] font-bold text-slate-400 dark:text-slate-500 w-5 text-right shrink-0">
                        {index + 1}.
                      </span>
                      <span class="truncate">{cat.name}</span>
                    </span>
                    <span class="toc-count text-[11px] font-mono font-semibold px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 shrink-0">
                      {cat.docs.length}
                    </span>
                  </a>
                );
              })}
            </nav>

            <!-- TOC Helpful Tip -->
            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 text-[11px] text-slate-400 dark:text-slate-500 leading-relaxed flex items-start gap-1.5">
              <span class="text-blue-500 shrink-0">💡</span>
              <span>คลิกที่หมวดหมู่เพื่อเลื่อนไปยังส่วนเอกสารที่ต้องการทันที</span>
            </div>

          </div>
        </aside>
      )}

      <!-- ================= RIGHT COLUMN: CONTENT AREA ================= -->
      <main class="flex-1 min-w-0 w-full space-y-8">
        
        <!-- Search Toolbar -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 p-4 shadow-xs">
          <!-- Live Search Input -->
          <div class="relative w-full">
            <input
              type="text"
              id="download-search-input"
              placeholder="ค้นหาชื่อเอกสารหรือแบบฟอร์มดาวน์โหลด..."
              class="w-full pl-10 pr-9 py-2.5 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#0047BA] dark:focus:ring-sky-500 focus:bg-white dark:focus:bg-slate-900 transition-all shadow-xs"
            />
            <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <button
              type="button"
              id="search-clear-btn"
              class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer p-0.5"
              title="ล้างคำค้นหา"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <!-- Mobile Quick Anchor Jump Pills (Shown on screens < lg) -->
          {hasCategories && (
            <div class="lg:hidden pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none text-xs">
              <span class="text-slate-400 font-semibold shrink-0 mr-1 text-[11px]">สารบัญ:</span>
              <a
                href="#downloads-main-content"
                data-target="all"
                class="mobile-toc-pill shrink-0 px-2.5 py-1 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-[#0047BA] dark:text-sky-300 font-semibold transition-colors"
              >
                ทั้งหมด
              </a>
              {displayCategories.map((cat, idx) => (
                <a
                  href={`#cat-${cat.slug}`}
                  data-target={`cat-${cat.slug}`}
                  class="mobile-toc-pill shrink-0 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:text-[#0047BA] dark:hover:text-sky-300 font-medium transition-colors"
                >
                  <span>{cat.name}</span>
                  <span class="ml-1 text-[10px] text-slate-400">({cat.docs.length})</span>
                </a>
              ))}
            </div>
          )}

        </div>

        <!-- DOWNLOADS CONTAINER (GROUPED BY CATEGORY SECTIONS) -->
        <div id="downloads-container" class="space-y-12 sm:space-y-14">
          {displayCategories.map((cat, catIdx) => {
            if (cat.docs.length === 0) return null;

            return (
              <section
                id={`cat-${cat.slug}`}
                class="category-section scroll-mt-28 space-y-4"
                data-category-slug={cat.slug}
              >
                <!-- Category Section Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3.5 border-b border-slate-200/90 dark:border-slate-800">
                  <div class="flex items-center gap-3">
                    {hasCategories && (
                      <span class="w-7 h-7 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-[#0047BA] dark:text-sky-400 font-mono font-bold text-xs flex items-center justify-center border border-blue-200/60 dark:border-blue-900/60 shadow-2xs">
                        {catIdx + 1}
                      </span>
                    )}
                    <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                      {cat.name}
                    </h2>
                    <span class="section-count-badge text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                      {cat.docs.length} รายการ
                    </span>
                  </div>
                  {cat.description && (
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-normal sm:max-w-md text-left sm:text-right">
                      {cat.description}
                    </p>
                  )}
                </div>

                <!-- Document Table within this category -->
                <div class="overflow-x-auto rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs">
                  <table class="w-full text-left border-collapse min-w-[720px]">
                    <thead>
                      <tr class="bg-slate-50/90 dark:bg-slate-800/70 border-b border-slate-200/90 dark:border-slate-800 text-[11px] sm:text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                        <th scope="col" class="py-3 px-4 text-center w-16 whitespace-nowrap">ลำดับ</th>
                        <th scope="col" class="py-3 px-4 min-w-[280px]">ชื่อเอกสาร / แบบฟอร์ม</th>
                        <th scope="col" class="py-3 px-4 text-center w-28">ประเภท</th>
                        <th scope="col" class="py-3 px-4 text-center w-32 whitespace-nowrap">วันที่อัปเดต</th>
                        <th scope="col" class="py-3 px-4 text-right w-44 whitespace-nowrap">ดาวน์โหลด / ตัวอย่าง</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80 text-xs sm:text-sm">
                      {cat.docs.map((item, docIdx) => {
                        const fileType = (item.fileType || 'pdf').toLowerCase();
                        
                        // Configuration for badge color and icon per type
                        let iconBg = "bg-rose-50 text-rose-600 dark:bg-rose-950/40 dark:text-rose-400 border-rose-200 dark:border-rose-900";
                        let typeLabel = "PDF";

                        if (fileType === 'docx' || fileType === 'doc' || fileType === 'word') {
                          iconBg = "bg-blue-50 text-[#0047BA] dark:bg-blue-950/40 dark:text-sky-400 border-blue-200 dark:border-blue-900";
                          typeLabel = "DOCX";
                        } else if (fileType === 'xlsx' || fileType === 'xls' || fileType === 'excel') {
                          iconBg = "bg-emerald-50 text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400 border-emerald-200 dark:border-emerald-900";
                          typeLabel = "XLSX";
                        } else if (fileType === 'pptx' || fileType === 'ppt' || fileType === 'powerpoint') {
                          iconBg = "bg-orange-50 text-orange-600 dark:bg-orange-950/40 dark:text-orange-400 border-orange-200 dark:border-orange-900";
                          typeLabel = "PPTX";
                        } else if (fileType === 'zip' || fileType === 'rar') {
                          iconBg = "bg-purple-50 text-purple-600 dark:bg-purple-950/40 dark:text-purple-400 border-purple-200 dark:border-purple-900";
                          typeLabel = fileType.toUpperCase();
                        } else if (fileType === 'link') {
                          iconBg = "bg-sky-50 text-sky-600 dark:bg-sky-950/40 dark:text-sky-400 border-sky-200 dark:border-sky-900";
                          typeLabel = "LINK";
                        }

                        const targetUrl = item.fileUrl || item.externalUrl || '#';
                        const isExternal = !item.fileUrl && !!item.externalUrl;
                        const titleClean = decodeHtmlEntities(item.title);

                        return (
                          <tr
                            id={`download-item-${item.id}`}
                            class="download-row group hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors"
                            data-category={cat.slug}
                            data-title={titleClean.toLowerCase()}
                          >
                            <!-- 1. Index -->
                            <td class="py-3.5 px-4 text-center font-mono text-xs font-semibold text-slate-400 dark:text-slate-500">
                              {docIdx + 1}
                            </td>

                            <!-- 2. Document Title -->
                            <td class="py-3.5 px-4">
                              <a
                                href={targetUrl}
                                download={item.fileUrl ? `${titleClean}.${fileType}` : undefined}
                                target={isExternal ? "_blank" : undefined}
                                rel={isExternal ? "noopener noreferrer" : undefined}
                                class="font-semibold text-slate-800 dark:text-slate-100 group-hover:text-[#0047BA] dark:group-hover:text-sky-400 transition-colors leading-snug break-words inline hover:underline"
                              >
                                {titleClean}
                              </a>
                            </td>

                            <!-- 3. File Type & Size -->
                            <td class="py-3.5 px-4 text-center">
                              <div class="inline-flex flex-col items-center">
                                <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] sm:text-[11px] font-bold border shadow-2xs ${iconBg}`}>
                                  {fileType === 'pdf' ? (
                                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                      <polyline points="14 2 14 8 20 8"></polyline>
                                    </svg>
                                  ) : (fileType === 'docx' || fileType === 'doc' || fileType === 'word') ? (
                                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                      <polyline points="14 2 14 8 20 8"></polyline>
                                      <line x1="12" y1="18" x2="12" y2="12"></line>
                                      <line x1="9" y1="15" x2="15" y2="15"></line>
                                    </svg>
                                  ) : (fileType === 'xlsx' || fileType === 'xls' || fileType === 'excel') ? (
                                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                      <line x1="3" y1="9" x2="21" y2="9"></line>
                                      <line x1="3" y1="15" x2="21" y2="15"></line>
                                    </svg>
                                  ) : (fileType === 'pptx' || fileType === 'ppt') ? (
                                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                      <line x1="8" y1="21" x2="16" y2="21"></line>
                                    </svg>
                                  ) : (fileType === 'zip' || fileType === 'rar') ? (
                                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                      <path d="M21 8v13H3V8"></path>
                                      <path d="M1 3h22v5H1z"></path>
                                    </svg>
                                  ) : (
                                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                                    </svg>
                                  )}
                                  <span>{typeLabel}</span>
                                </span>
                                {item.fileSize && (
                                  <span class="text-[10px] font-mono text-slate-400 dark:text-slate-500 mt-0.5">
                                    {item.fileSize}
                                  </span>
                                )}
                              </div>
                            </td>

                            <!-- 4. Date -->
                            <td class="py-3.5 px-4 text-center text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap font-medium">
                              {item.publishedAt ? formatThaiDate(item.publishedAt) : '-'}
                            </td>

                            <!-- 5. Actions (Preview & Download) -->
                            <td class="py-3.5 px-4 text-right whitespace-nowrap">
                              <div class="inline-flex items-center justify-end gap-1.5">
                                <!-- Preview button -->
                                <button
                                  type="button"
                                  class="btn-preview-file inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-blue-50 text-slate-700 hover:text-[#0047BA] dark:bg-slate-800 dark:hover:bg-blue-950/50 dark:text-slate-300 dark:hover:text-sky-300 border border-slate-200 dark:border-slate-700 transition-colors cursor-pointer"
                                  data-file-url={item.fileUrl || ''}
                                  data-external-url={item.externalUrl || ''}
                                  data-file-type={fileType}
                                  data-title={titleClean}
                                  data-size={item.fileSize || ''}
                                  title="ดูตัวอย่างเอกสาร"
                                >
                                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                  </svg>
                                  <span class="hidden sm:inline">ดูตัวอย่าง</span>
                                </button>

                                <!-- Direct Download / External Link Button -->
                                <a
                                  href={targetUrl}
                                  download={item.fileUrl ? `${titleClean}.${fileType}` : undefined}
                                  target={isExternal ? "_blank" : undefined}
                                  rel={isExternal ? "noopener noreferrer" : undefined}
                                  class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold bg-[#0047BA] hover:bg-[#003893] text-white shadow-xs hover:shadow transition-all active:scale-98 cursor-pointer"
                                  title={isExternal ? "เปิดลิงก์ดาวน์โหลดภายนอก" : "ดาวน์โหลดไฟล์ลงเครื่อง"}
                                >
                                  {isExternal ? (
                                    <>
                                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                                        <polyline points="15 3 21 3 21 9"></polyline>
                                        <line x1="10" y1="14" x2="21" y2="3"></line>
                                      </svg>
                                      <span>เปิดลิงก์</span>
                                    </>
                                  ) : (
                                    <>
                                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                        <polyline points="7 10 12 15 17 10"></polyline>
                                        <line x1="12" y1="15" x2="12" y2="3"></line>
                                      </svg>
                                      <span>ดาวน์โหลด</span>
                                    </>
                                  )}
                                </a>
                              </div>
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </section>
            );
          })}
        </div>

        <!-- Empty Search Notice -->
        <div id="no-search-results" class="hidden text-center py-20 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-xs mt-6">
          <div class="w-16 h-16 mx-auto rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 mb-4">
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-slate-800 dark:text-slate-200">ไม่พบเอกสารที่ค้นหา</h3>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">ลองเปลี่ยนคำค้นหา หรือเลือกตัวกรองประเภทไฟล์ใหม่</p>
          <button
            type="button"
            id="btn-clear-search"
            class="mt-4 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-[#0047BA] text-white hover:bg-[#003893] transition-colors cursor-pointer"
          >
            ล้างคำค้นหาทั้งหมด
          </button>
        </div>

      </main>

    </div>

    <!-- PREVIEW MODAL DIALOG -->
    <div
      id="download-preview-modal"
      class="hidden fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-3 sm:p-6 transition-opacity duration-300"
      role="dialog"
      aria-modal="true"
    >
      <div class="bg-white dark:bg-slate-900 rounded-2xl sm:rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-800 w-full max-w-5xl h-[88vh] sm:h-[85vh] flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
        
        <!-- Modal Top Bar -->
        <div class="flex items-center justify-between px-4 sm:px-6 py-3.5 border-b border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-800/60 shrink-0">
          <div class="flex items-center gap-3 min-w-0 flex-1 mr-4">
            <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-950/60 text-[#0047BA] dark:text-sky-300 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
            </div>
            <div class="min-w-0">
              <h4 id="modal-file-title" class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white truncate">
                ชื่อเอกสาร
              </h4>
              <div class="flex items-center gap-2 text-[11px] text-slate-500 font-mono">
                <span id="modal-file-size"></span>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <a
              id="modal-download-action"
              href="#"
              download
              class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#0047BA] hover:bg-[#003893] text-white transition-colors"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span id="modal-download-text">ดาวน์โหลด</span>
            </a>

            <a
              id="modal-newtab-action"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="p-1.5 rounded-lg text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
              title="เปิดในแท็บใหม่"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>

            <button
              type="button"
              id="modal-close-action"
              class="p-1.5 rounded-lg text-slate-500 hover:text-rose-600 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors cursor-pointer"
              title="ปิดหน้าต่างตัวอย่าง (ESC)"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>

        <!-- Modal Viewer Body -->
        <div class="flex-1 bg-slate-100 dark:bg-slate-950 relative overflow-hidden flex items-center justify-center">
          
          <!-- PDF / Web Viewer Frame -->
          <iframe
            id="modal-preview-iframe"
            class="w-full h-full border-0 hidden"
            src=""
            title="เอกสารตัวอย่าง"
          ></iframe>

          <!-- Image Preview -->
          <div id="modal-image-container" class="hidden max-h-full overflow-auto p-4 flex items-center justify-center">
            <img id="modal-preview-image" src="" alt="ตัวอย่างเอกสาร" class="max-h-[75vh] object-contain rounded-lg shadow-md" />
          </div>

          <!-- Fallback Card -->
          <div id="modal-fallback-container" class="hidden text-center p-8 max-w-md">
            <div class="w-16 h-16 rounded-2xl bg-blue-100 dark:bg-blue-950/60 text-[#0047BA] dark:text-sky-300 flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
            </div>
            <h4 id="fallback-file-name" class="text-base font-bold text-slate-800 dark:text-slate-200 mb-2 truncate"></h4>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6 leading-relaxed">
              ไฟล์ประเภทนี้สามารถดาวน์โหลดเพื่อเปิดด้วยโปรแกรมบนอุปกรณ์ของคุณ หรือเปิดอ่านในหน้าต่างใหม่
            </p>
            <a
              id="fallback-download-btn"
              href="#"
              download
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold bg-[#0047BA] hover:bg-[#003893] text-white shadow-md transition-all"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>ดาวน์โหลดเอกสารนี้</span>
            </a>
          </div>

        </div>

      </div>
