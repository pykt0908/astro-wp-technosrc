  </div>

  <!-- Client-side Interactive Script -->
  <script>
    (function() {
      function initDownloadPortal() {
        const searchInput = document.getElementById('download-search-input') as HTMLInputElement | null;
        const searchClearBtn = document.getElementById('search-clear-btn');
        const tocLinks = document.querySelectorAll('.toc-link');
        const sections = document.querySelectorAll<HTMLElement>('.category-section');
        const noResults = document.getElementById('no-search-results');
        const clearBtn = document.getElementById('btn-clear-search');

        // Modal Elements
        const modal = document.getElementById('download-preview-modal');
        const modalTitle = document.getElementById('modal-file-title');
        const modalSize = document.getElementById('modal-file-size');
        const modalIframe = document.getElementById('modal-preview-iframe') as HTMLIFrameElement | null;
        const modalImgContainer = document.getElementById('modal-image-container');
        const modalImg = document.getElementById('modal-preview-image') as HTMLImageElement | null;
        const modalFallback = document.getElementById('modal-fallback-container');
        const fallbackName = document.getElementById('fallback-file-name');
        const fallbackDownload = document.getElementById('fallback-download-btn') as HTMLAnchorElement | null;
        const modalDownload = document.getElementById('modal-download-action') as HTMLAnchorElement | null;
        const modalDownloadText = document.getElementById('modal-download-text');
        const modalNewTab = document.getElementById('modal-newtab-action') as HTMLAnchorElement | null;
        const modalClose = document.getElementById('modal-close-action');

        let searchQuery = '';

        // Filter rows and sections by search query
        function filterList() {
          let totalVisible = 0;

          sections.forEach(section => {
            const rows = section.querySelectorAll<HTMLElement>('.download-row');
            let sectionVisibleCount = 0;

            rows.forEach(row => {
              const title = row.dataset.title || '';
              const matchesSearch = !searchQuery || title.includes(searchQuery);

              if (matchesSearch) {
                row.classList.remove('hidden');
                sectionVisibleCount++;
                totalVisible++;
              } else {
                row.classList.add('hidden');
              }
            });

            // Toggle section visibility based on visible rows
            if (sectionVisibleCount === 0) {
              section.classList.add('hidden');
            } else {
              section.classList.remove('hidden');
              const countBadge = section.querySelector('.section-count-badge');
              if (countBadge) {
                countBadge.textContent = `${sectionVisibleCount} รายการ`;
              }
            }
          });

          if (noResults) {
            noResults.classList.toggle('hidden', totalVisible > 0);
          }
        }

        // Active state manager for both TOC sidebar and mobile pills
        let isClickScrolling = false;
        let clickScrollTimeout: any = null;

        function setActiveTocLink(targetId: string) {
          tocLinks.forEach(link => {
            const target = link.getAttribute('data-target');
            const isMatch = target === targetId;
            const numSpan = link.querySelector('.toc-number');
            const countSpan = link.querySelector('.toc-count');
            const dotSpan = link.querySelector('.toc-dot');

            if (isMatch) {
              link.classList.add('active', 'text-[#0047BA]', 'dark:text-sky-300', 'font-semibold', 'bg-blue-50/80', 'dark:bg-blue-950/50');
              link.classList.remove('text-slate-600', 'dark:text-slate-400', 'font-medium');
              if (numSpan) {
                numSpan.classList.add('text-[#0047BA]', 'dark:text-sky-400');
                numSpan.classList.remove('text-slate-400', 'dark:text-slate-500');
              }
              if (countSpan) {
                countSpan.classList.add('bg-white', 'dark:bg-slate-900', 'text-[#0047BA]', 'dark:text-sky-300', 'shadow-xs');
                countSpan.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-500', 'dark:text-slate-400');
              }
              if (dotSpan) {
                dotSpan.classList.add('bg-[#0047BA]', 'dark:bg-sky-400');
                dotSpan.classList.remove('bg-slate-400', 'dark:bg-slate-600');
              }
            } else {
              link.classList.remove('active', 'text-[#0047BA]', 'dark:text-sky-300', 'font-semibold', 'bg-blue-50/80', 'dark:bg-blue-950/50');
              link.classList.add('text-slate-600', 'dark:text-slate-400', 'font-medium');
              if (numSpan) {
                numSpan.classList.remove('text-[#0047BA]', 'dark:text-sky-400');
                numSpan.classList.add('text-slate-400', 'dark:text-slate-500');
              }
              if (countSpan) {
                countSpan.classList.remove('bg-white', 'dark:bg-slate-900', 'text-[#0047BA]', 'dark:text-sky-300', 'shadow-xs');
                countSpan.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-500', 'dark:text-slate-400');
              }
              if (dotSpan) {
                dotSpan.classList.remove('bg-[#0047BA]', 'dark:bg-sky-400');
                dotSpan.classList.add('bg-slate-400', 'dark:bg-slate-600');
              }
            }
          });

          // Sync mobile pills
          const mobilePills = document.querySelectorAll<HTMLElement>('.mobile-toc-pill');
          mobilePills.forEach(pill => {
            const target = pill.getAttribute('data-target');
            const isMatch = target === targetId;
            if (isMatch) {
              pill.classList.add('bg-blue-50', 'dark:bg-blue-950/60', 'text-[#0047BA]', 'dark:text-sky-300', 'font-semibold');
              pill.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'font-medium');
            } else {
              pill.classList.remove('bg-blue-50', 'dark:bg-blue-950/60', 'text-[#0047BA]', 'dark:text-sky-300', 'font-semibold');
              pill.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'font-medium');
            }
          });
        }

        function scrollToTarget(target: string) {
          isClickScrolling = true;
          clearTimeout(clickScrollTimeout);
          clickScrollTimeout = setTimeout(() => {
            isClickScrolling = false;
          }, 800);

          if (target === 'all') {
            const mainEl = document.getElementById('downloads-main-content');
            if (mainEl) {
              const headerOffset = 90;
              const elementPosition = mainEl.getBoundingClientRect().top;
              const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
              window.scrollTo({
                top: Math.max(0, offsetPosition),
                behavior: 'smooth'
              });
              history.replaceState(null, '', '#downloads-main-content');
            } else {
              window.scrollTo({ top: 0, behavior: 'smooth' });
              history.replaceState(null, '', '#downloads-main-content');
            }
          } else {
            const targetEl = document.getElementById(target);
            if (targetEl) {
              const headerOffset = 90;
              const elementPosition = targetEl.getBoundingClientRect().top;
              const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
              window.scrollTo({
                top: Math.max(0, offsetPosition),
                behavior: 'smooth'
              });
              history.replaceState(null, '', `#${target}`);
            }
          }
        }

        // Click handlers for TOC sidebar links
        tocLinks.forEach(link => {
          link.addEventListener('click', (e) => {
            const target = link.getAttribute('data-target');
            if (!target) return;
            e.preventDefault();
            setActiveTocLink(target);
            scrollToTarget(target);
          });
        });

        // Click handlers for mobile pills
        const mobilePills = document.querySelectorAll<HTMLElement>('.mobile-toc-pill');
        mobilePills.forEach(pill => {
          pill.addEventListener('click', (e) => {
            const target = pill.getAttribute('data-target');
            if (!target) return;
            e.preventDefault();
            setActiveTocLink(target);
            scrollToTarget(target);
          });
        });

        // Live ScrollSpy for Table of Contents
        function updateActiveToc() {
          if (isClickScrolling) return;

          let currentTarget = 'all';
          const scrollPos = window.scrollY;
          const mainEl = document.getElementById('downloads-main-content');
          const visibleSections = Array.from(sections).filter(s => !s.classList.contains('hidden'));

          // When downloads-main-content is at or near the viewport top (or above, in hero banner),
          // or scroll position is near the top of the page, "All Documents" is active
          const mainTop = mainEl ? mainEl.getBoundingClientRect().top : 0;
          if (mainTop >= 50 || scrollPos < 100) {
            currentTarget = 'all';
          } else if (visibleSections.length > 0) {
            // Find which category section is currently in reading focus
            for (let i = 0; i < visibleSections.length; i++) {
              const rect = visibleSections[i].getBoundingClientRect();
              if (rect.top <= 140) {
                currentTarget = visibleSections[i].getAttribute('id') || '';
              }
            }

            // Bottom of page: activate last visible category section
            if (
              window.innerHeight + scrollPos >=
              document.documentElement.scrollHeight - 60
            ) {
              currentTarget = visibleSections[visibleSections.length - 1].getAttribute('id') || '';
            }
          }

          setActiveTocLink(currentTarget);
        }

        window.addEventListener('scroll', updateActiveToc, { passive: true });
        window.addEventListener('resize', updateActiveToc, { passive: true });

        // Search Input
        if (searchInput) {
          searchInput.addEventListener('input', (e) => {
            searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
            if (searchClearBtn) {
              searchClearBtn.classList.toggle('hidden', !searchQuery);
            }
            filterList();
            updateActiveToc();
          });
        }

        if (searchClearBtn && searchInput) {
          searchClearBtn.addEventListener('click', () => {
            searchInput.value = '';
            searchQuery = '';
            searchClearBtn.classList.add('hidden');
            filterList();
            updateActiveToc();
            searchInput.focus();
          });
        }

        if (clearBtn && searchInput) {
          clearBtn.addEventListener('click', () => {
            searchInput.value = '';
            searchQuery = '';
            if (searchClearBtn) searchClearBtn.classList.add('hidden');
            filterList();
            updateActiveToc();
          });
        }

        // Modal Preview Button Clicks
        document.querySelectorAll('.btn-preview-file').forEach(btn => {
          btn.addEventListener('click', () => {
            const el = btn as HTMLElement;
            const fileUrl = el.dataset.fileUrl || '';
            const extUrl = el.dataset.externalUrl || '';
            const ftype = (el.dataset.fileType || 'pdf').toLowerCase();
            const title = el.dataset.title || 'เอกสาร';
            const size = el.dataset.size || '';
            const effectiveUrl = fileUrl || extUrl;

            if (modalTitle) modalTitle.textContent = title;
            if (modalSize) modalSize.textContent = size ? `• ${size}` : '';

            if (modalDownload) {
              modalDownload.href = effectiveUrl;
              modalDownload.download = fileUrl ? `${title}.${ftype}` : '';
              if (modalDownloadText) {
                modalDownloadText.textContent = extUrl && !fileUrl ? 'เปิดลิงก์' : 'ดาวน์โหลด';
              }
            }

            if (modalNewTab) {
              modalNewTab.href = effectiveUrl;
            }

            // Reset viewer frames
            if (modalIframe) {
              modalIframe.src = '';
              modalIframe.classList.add('hidden');
            }
            if (modalImgContainer) modalImgContainer.classList.add('hidden');
            if (modalFallback) modalFallback.classList.add('hidden');

            if (ftype === 'pdf') {
              if (modalIframe) {
                modalIframe.src = effectiveUrl;
                modalIframe.classList.remove('hidden');
              }
            } else if (ftype === 'image' || ['jpg', 'jpeg', 'png', 'webp', 'gif'].includes(ftype)) {
              if (modalImg && modalImgContainer) {
                modalImg.src = effectiveUrl;
                modalImgContainer.classList.remove('hidden');
              }
            } else if (['docx', 'doc', 'xlsx', 'xls', 'pptx', 'ppt'].includes(ftype)) {
              if (effectiveUrl.startsWith('http://') || effectiveUrl.startsWith('https://')) {
                const viewerUrl = `https://docs.google.com/viewer?url=${encodeURIComponent(effectiveUrl)}&embedded=true`;
                if (modalIframe) {
                  modalIframe.src = viewerUrl;
                  modalIframe.classList.remove('hidden');
                }
              } else {
                if (modalFallback) {
                  if (fallbackName) fallbackName.textContent = title;
                  if (fallbackDownload) fallbackDownload.href = effectiveUrl;
                  modalFallback.classList.remove('hidden');
                }
              }
            } else {
              if (modalFallback) {
                if (fallbackName) fallbackName.textContent = title;
                if (fallbackDownload) fallbackDownload.href = effectiveUrl;
                modalFallback.classList.remove('hidden');
              }
            }

            if (modal) {
              modal.classList.remove('hidden');
              document.body.style.overflow = 'hidden';
            }
          });
        });

        // Close Modal
        function closeModal() {
          if (modal) {
            modal.classList.add('hidden');
            if (modalIframe) modalIframe.src = '';
            document.body.style.overflow = '';
          }
        }

        if (modalClose) modalClose.addEventListener('click', closeModal);

        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
          });
        }

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
            closeModal();
          }
        });

        const initialHash = window.location.hash.replace('#', '');
        if (initialHash === 'downloads-main-content' || !initialHash) {
          setActiveTocLink('all');
        } else if (initialHash) {
          setActiveTocLink(initialHash);
        } else {
          updateActiveToc();
        }
      }

      document.addEventListener('astro:page-load', initDownloadPortal);
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initDownloadPortal();
      }
    })();
  </script>

  <style>
    .download-row {
      transition: background-color 0.15s ease;
    }
    .toc-link {
      transition: all 0.15s ease;
    }
  </style>
</BaseLayout>
