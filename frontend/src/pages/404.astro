---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ไม่พบหน้าที่คุณต้องการ (404) - วิทยาลัยเทคโนโลยีศรีราชา" description="หน้าที่คุณกำลังค้นหาไม่มีอยู่หรือถูกย้ายไปแล้ว">
  <div class="py-24 sm:py-36 max-w-3xl mx-auto px-4 text-center">
    <div class="inline-flex items-center justify-center w-24 h-24 rounded-2xl bg-blue-50 text-[#0047BA] mb-8 border border-blue-200 shadow-md">
      <span class="text-3xl font-extrabold">404</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">ไม่พบหน้าที่ต้องการ</h1>
    <p class="mt-4 text-lg text-slate-600 max-w-lg mx-auto">
      หน้าที่คุณกำลังเรียกหาอาจถูกย้าย ลบ หรือ URL ที่กรอกอาจไม่ถูกต้อง
    </p>
    <div class="mt-10 flex items-center justify-center gap-4">
      <a
        href="/"
        class="px-6 py-3.5 text-sm font-bold text-white bg-[#0047BA] hover:bg-[#003893] rounded-xl shadow-md transition-all"
      >
        กลับสู่หน้าแรก
      </a>
      <a
        href="/news/"
        class="px-6 py-3.5 text-sm font-bold text-[#0047BA] hover:text-[#002D72] bg-white border border-[#0047BA] rounded-xl transition-all"
      >
        ข่าวสารและกิจกรรมล่าสุด
      </a>
    </div>
  </div>
</BaseLayout>
