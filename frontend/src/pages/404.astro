---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ไม่พบหน้าที่คุณต้องการ (404)" description="หน้าที่คุณกำลังค้นหาไม่มีอยู่หรือถูกย้ายไปแล้ว">
  <div class="py-24 sm:py-36 max-w-3xl mx-auto px-4 text-center">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-blue-600/20 text-blue-400 mb-8 border border-blue-500/30 shadow-lg shadow-blue-900/30">
      <span class="text-3xl font-extrabold">404</span>
    </div>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">ไม่พบหน้าที่ต้องการ</h1>
    <p class="mt-4 text-lg text-slate-300 max-w-lg mx-auto">
      หน้าที่คุณกำลังเรียกหาอาจถูกย้าย ลบ หรือ URL ที่กรอกอาจไม่ถูกต้อง
    </p>
    <div class="mt-10 flex items-center justify-center gap-4">
      <a
        href="/"
        class="px-6 py-3 text-sm font-semibold text-white bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-700 rounded-xl shadow-lg shadow-blue-700/30 hover:shadow-blue-600/50 transition-all border border-blue-400/20"
      >
        กลับสู่หน้าแรก
      </a>
      <a
        href="/news/"
        class="px-6 py-3 text-sm font-semibold text-blue-200 hover:text-white bg-blue-950/60 border border-blue-800/60 rounded-xl transition-all"
      >
        ข่าวสารและกิจกรรมล่าสุด
      </a>
    </div>
  </div>
</BaseLayout>
