---
import BaseLayout from '../layouts/BaseLayout.astro';

const programs = [
  {
    title: 'ระดับประกาศนียบัตรวิชาชีพ (ปวช.)',
    desc: 'เปิดรับผู้สำเร็จการศึกษาระดับ ม.3 หรือเทียบเท่า มุ่งเน้นการปูพื้นฐานทักษะวิชาชีพควบคู่กับสามัญ พร้อมการฝึกปฏิบัติงานจริงในห้องปฏิบัติการทันสมัย',
    features: ['สาขาวิชาช่างยนต์ / เทคโนโลยียานยนต์', 'สาขาวิชาช่างไฟฟ้ากำลัง / อิเล็กทรอนิกส์', 'สาขาวิชาเทคโนโลยีสารสนเทศ (IT)', 'สาขาวิชาการบัญชีและการตลาดดิจิทัล'],
    icon: 'M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z',
  },
  {
    title: 'ระดับประกาศนียบัตรวิชาชีพชั้นสูง (ปวส.)',
    desc: 'เปิดรับผู้สำเร็จการศึกษา ปวช. หรือ ม.6 ต่อยอดความเชี่ยวชาญเฉพาะทางระดับสูง ตอบโจทย์เขตพัฒนาพิเศษภาคตะวันออก (EEC) และอุตสาหกรรม 4.0',
    features: ['เทคนิคยานยนต์และระบบควบคุม', 'เทคโนโลยีไฟฟ้าและระบบอัตโนมัติ (Automation)', 'เทคโนโลยีธุรกิจดิจิทัลและปัญญาประดิษฐ์', 'การจัดการโลจิสติกส์และซัพพลายเชน'],
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  },
  {
    title: 'ความร่วมมือทวิภาคี & บริการวิชาการ',
    desc: 'โครงการเรียนร่วมกับสถานประกอบการชั้นนำ ได้รับเบี้ยเลี้ยงระหว่างเรียน พร้อมฝึกทักษะกับเครื่องจักรและหน้างานจริง 100%',
    features: ['มีรายได้ระหว่างศึกษา', 'โอกาสบรรจุเข้าทำงานทันทีหลังจบ', 'ทุนการศึกษาสำหรับนักเรียนดีเด่น', 'อบรมพัฒนาวิชาชีพสู่ชุมชน'],
    icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
];
---

<BaseLayout
  title="หลักสูตรการศึกษา - วิทยาลัยเทคโนโลยีศรีราชา"
  description="ข้อมูลหลักสูตร ปวช. และ ปวส. สาขาวิชาช่างอุตสาหกรรม บริหารธุรกิจ และเทคโนโลยีดิจิทัล วิทยาลัยเทคโนโลยีศรีราชา"
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-semibold text-blue-400 tracking-wider uppercase">หลักสูตรที่เปิดสอน</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-3 tracking-tight">
        หลักสูตรคุณภาพ ตอบโจทย์โลกอนาคต
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300">
        เรียนรู้กับอาจารย์ผู้เชี่ยวชาญ เครื่องมือครบครัน เสริมสร้างทักษะสู่การทำงานจริงในระดับสากล
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {programs.map((prog) => (
        <div class="glass-panel p-8 rounded-2xl border border-blue-900/50 flex flex-col justify-between hover:border-blue-400/50 transition-all duration-300">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-600/30 to-indigo-600/30 text-blue-400 flex items-center justify-center mb-6 border border-blue-500/30 shadow-md">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={prog.icon} />
              </svg>
            </div>
            <h2 class="text-xl font-bold text-white mb-3">{prog.title}</h2>
            <p class="text-sm text-slate-300 leading-relaxed mb-6">{prog.desc}</p>
            <ul class="space-y-2.5 text-xs text-slate-300">
              {prog.features.map((feat) => (
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-blue-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="mt-8 pt-6 border-t border-blue-900/50">
            <a
              href="/contact/"
              class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 hover:text-blue-300 transition-colors"
            >
              <span>สนใจสมัครเรียนหลักสูตรนี้</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
