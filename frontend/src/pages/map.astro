---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="แผนที่และการเดินทาง - วิทยาลัยเทคโนโลยีศรีราชา"
  description="แผนที่ตั้งและการเดินทางมายังวิทยาลัยเทคโนโลยีศรีราชา 12/19 หมู่ที่ 2 ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี 20230 โทร. 038-352440, 038-351785"
>
  <div class="py-8 sm:py-12 lg:py-16 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <span>/</span>
      <a href="/about/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">เกี่ยวกับเรา</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold" aria-current="page">แผนที่และการเดินทาง</span>
    </nav>

    <!-- Page Title Header -->
    <div class="mb-10 sm:mb-12 pb-6 border-b border-slate-200 dark:border-slate-800 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          แผนที่และการเดินทาง
        </h1>
        <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2">
          วิทยาลัยเทคโนโลยีศรีราชา (Sriracha Technological College)
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-3">
        <a
          href="https://maps.google.com/?q=13.1055718,100.9148445"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-[#0047BA] text-white hover:bg-[#003893] transition-colors shadow-sm"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
          เปิดดูใน Google Maps
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors border border-slate-200 dark:border-slate-800 shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          ข้อมูลการติดต่อ
        </a>
      </div>
    </div>

    <!-- Google Maps Responsive Container -->
    <div class="relative w-full rounded-2xl overflow-hidden shadow-sm border border-slate-200/80 dark:border-slate-800 bg-slate-100 dark:bg-slate-800 h-[68vh] min-h-[500px] max-h-[800px]">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4432.353774886147!2d100.9148445!3d13.105571800000002!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3102b9c0490daf0d%3A0x64d7370ddd52cff!2z4Lin4Li04LiX4Lii4Liy4Lil4Lix4Lii4LmA4LiX4LiE4LmC4LiZ4LmC4Lil4Lii4Li14Lio4Lij4Li14Lij4Liy4LiK4Liy!5e1!3m2!1sth!2sth!4v1792217824537!5m2!1sth!2sth"
        class="w-full h-full border-0 absolute inset-0"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        title="แผนที่ตั้งวิทยาลัยเทคโนโลยีศรีราชา"
      ></iframe>
    </div>
  </div>
</BaseLayout>
