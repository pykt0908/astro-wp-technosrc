---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="แผนที่และการเดินทาง - วิทยาลัยเทคโนโลยีศรีราชา"
  description="แผนที่ตั้งและการเดินทางมายังวิทยาลัยเทคโนโลยีศรีราชา 12/19 หมู่ที่ 2 ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี 20230 โทร. 038-352440, 038-351785"
>
  <div class="py-8 sm:py-12 lg:py-16 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <span>/</span>
      <a href="/about/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">เกี่ยวกับเรา</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold" aria-current="page">แผนที่และการเดินทาง</span>
    </nav>

    <!-- Page Title Header -->
    <div class="mb-10 sm:mb-12 pb-6 border-b border-slate-200 dark:border-slate-800 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          แผนที่และการเดินทาง
        </h1>
        <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2">
          วิทยาลัยเทคโนโลยีศรีราชา (Sriracha Technological College)
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-3">
        <a
          href="https://maps.google.com/?q=13.1055718,100.9148445"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-[#0047BA] text-white hover:bg-[#003893] transition-colors shadow-sm"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
          เปิดดูใน Google Maps
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors border border-slate-200 dark:border-slate-800 shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          ข้อมูลการติดต่อ
        </a>
      </div>
    </div>

    <!-- Main Content Stack -->
    <div class="space-y-10 sm:space-y-12">
      
      <!-- 1. Google Maps Responsive Container -->
      <section class="space-y-3">
        <div class="relative w-full rounded-2xl overflow-hidden shadow-sm border border-slate-200/80 dark:border-slate-800 bg-slate-100 dark:bg-slate-800 aspect-[16/10] sm:aspect-[21/9] min-h-[420px] sm:min-h-[520px]">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4432.353774886147!2d100.9148445!3d13.105571800000002!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3102b9c0490daf0d%3A0x64d7370ddd52cff!2z4Lin4Li04LiX4Lii4Liy4Lil4Lix4Lii4LmA4LiX4LiE4LmC4LiZ4LmC4Lil4Lii4Li14Lio4Lij4Li14Lij4Liy4LiK4Liy!5e1!3m2!1sth!2sth!4v1792217824537!5m2!1sth!2sth"
            class="w-full h-full border-0 absolute inset-0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="แผนที่ตั้งวิทยาลัยเทคโนโลยีศรีราชา"
          ></iframe>
        </div>
        <p class="text-xs text-slate-400 dark:text-slate-500 text-right">
          * พิกัดละติจูด 13.1055718, ลองจิจูด 100.9148445
        </p>
      </section>

      <!-- 2. Location Highlights & Travel Guidance Grid -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        
        <!-- Address Card -->
        <div class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-11 h-11 rounded-xl bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 flex items-center justify-center border border-blue-100 dark:border-blue-900/50">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
                ที่ตั้งสถานศึกษา
              </h2>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                ทำเลใจกลางย่านอุตสาหกรรมและชุมชน
              </p>
            </div>
            <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-medium">
              12/19 หมู่ที่ 2 ตำบลทุ่งสุขลา อำเภอศรีราชา จังหวัดชลบุรี 20230
            </p>
          </div>

          <div class="pt-5 mt-5 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400">
            โทร. <a href="tel:038352440" class="font-bold hover:text-[#0047BA] dark:hover:text-blue-400">038-352440</a>, <a href="tel:038351785" class="font-bold hover:text-[#0047BA] dark:hover:text-blue-400">038-351785</a>
          </div>
        </div>

        <!-- Travel Guide: By Car -->
        <div class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-11 h-11 rounded-xl bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 flex items-center justify-center border border-blue-100 dark:border-blue-900/50">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h8m-8 4h8m-5 4h5M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
                การเดินทางด้วยรถยนต์
              </h2>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                เส้นทางสุขุมวิทและมอเตอร์เวย์
              </p>
            </div>
            <ul class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 space-y-2 leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0047BA] shrink-0 mt-1.5"></span>
                <span>จากกรุงเทพฯ / ชลบุรี: ใช้ถนนสุขุมวิท มุ่งหน้าพัทยา ผ่านตัวอำเภอศรีราชา มุ่งสู่อ่าวอุดม</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0047BA] shrink-0 mt-1.5"></span>
                <span>จุดสังเกต: ใกล้แยกอ่าวอุดม และทางเข้านิคมอุตสาหกรรมแหลมฉบัง</span>
              </li>
            </ul>
          </div>

          <div class="pt-5 mt-5 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400">
            มีที่จอดรถยนต์และรถจักรยานยนต์ภายในวิทยาลัย
          </div>
        </div>

        <!-- Travel Guide: Public Transit -->
        <div class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-11 h-11 rounded-xl bg-blue-50 dark:bg-blue-950/80 text-[#0047BA] dark:text-blue-400 flex items-center justify-center border border-blue-100 dark:border-blue-900/50">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
                รถโดยสารสาธารณะ
              </h2>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                รถประจำทางและรถตู้สายตะวันออก
              </p>
            </div>
            <ul class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 space-y-2 leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0047BA] shrink-0 mt-1.5"></span>
                <span>รถตู้ / มินิบัส กรุงเทพฯ - พัทยา - สัตหีบ: ลงที่แยกอ่าวอุดม หรือหน้านิคมแหลมฉบัง</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0047BA] shrink-0 mt-1.5"></span>
                <span>รถสองแถวประจำทางสาย ศรีราชา - แหลมฉบัง - นาเกลือ ผ่านหน้าเส้นทางหลัก</span>
              </li>
            </ul>
          </div>

          <div class="pt-5 mt-5 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-500 dark:text-slate-400">
            เดินทางสะดวกด้วยรถสองแถวท้องถิ่นและวินมอเตอร์ไซค์
          </div>
        </div>

      </section>

    </div>
  </div>
</BaseLayout>
