  <!-- Interactive ScrollSpy & Year Switcher Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      // Academic Year Switcher
      var yearButtons = document.querySelectorAll('#year-selector-tabs button');
      var yearPanels = document.querySelectorAll('.mis-year-panel');

      yearButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var targetId = btn.getAttribute('data-target-id');

          yearButtons.forEach(function (b) {
            b.classList.remove('bg-[#0047BA]', 'text-white', 'shadow-xs');
            b.classList.add('text-slate-600', 'dark:text-slate-300');
          });
          btn.classList.add('bg-[#0047BA]', 'text-white', 'shadow-xs');
          btn.classList.remove('text-slate-600', 'dark:text-slate-300');

          yearPanels.forEach(function (panel) {
            if (panel.id === targetId) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });

          // Refresh active TOC on year switch
          updateActiveToc();
        });
      });

      // ScrollSpy for Table of Contents
      var tocLinks = document.querySelectorAll('.toc-link');

      function updateActiveToc() {
        var activePanel = document.querySelector('.mis-year-panel:not(.hidden)');
        if (!activePanel) return;

        var sections = activePanel.querySelectorAll('section[id^="sec-"]');
        var currentSectionId = '';

        sections.forEach(function (section) {
          var rect = section.getBoundingClientRect();
          // Active if section header is near the top or section spans viewport
          if (rect.top <= 200 && rect.bottom >= 120) {
            currentSectionId = section.getAttribute('id');
          }
        });

        // Fallback for top of page
        if (!currentSectionId && sections.length > 0 && window.scrollY < 300) {
          currentSectionId = sections[0].getAttribute('id');
        }

        tocLinks.forEach(function (link) {
          if (link.getAttribute('data-section') === currentSectionId) {
            link.classList.add('text-[#0047BA]', 'dark:text-blue-400', 'border-[#0047BA]', 'dark:border-blue-400', 'bg-blue-50/70', 'dark:bg-blue-950/30', 'font-semibold');
            link.classList.remove('text-slate-600', 'dark:text-slate-400', 'border-transparent', 'font-medium');
          } else {
            link.classList.remove('text-[#0047BA]', 'dark:text-blue-400', 'border-[#0047BA]', 'dark:border-blue-400', 'bg-blue-50/70', 'dark:bg-blue-950/30', 'font-semibold');
            link.classList.add('text-slate-600', 'dark:text-slate-400', 'border-transparent', 'font-medium');
          }
        });
      }

      window.addEventListener('scroll', updateActiveToc, { passive: true });
      window.addEventListener('resize', updateActiveToc, { passive: true });
      updateActiveToc();
    });
  </script>
