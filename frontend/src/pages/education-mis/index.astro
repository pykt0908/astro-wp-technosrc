                      <th class="py-3 px-4">แผนกวิชา / กลุ่มสาระ</th>
                      <th class="py-3 px-4 w-32 text-center">GPAX เฉลี่ย</th>
                      <th class="py-3 px-4 w-40 text-center">ผลทดสอบ V-NET</th>
                      <th class="py-3 px-4 w-48 text-center">ผ่านเกณฑ์มาตรฐานวิชาชีพ</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                    {item.achievements.list.map((row, idx) => (
                      <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                        <td class="py-3 px-4 text-center text-slate-400">{idx + 1}</td>
                        <td class="py-3 px-4 font-bold text-slate-900 dark:text-white">{row.department}</td>
                        <td class="py-3 px-4 text-center font-bold text-[#0047BA] dark:text-blue-400 font-mono">{row.gpax}</td>
                        <td class="py-3 px-4 text-center font-semibold text-purple-600 dark:text-purple-400 font-mono">{row.vnet_score}</td>
                        <td class="py-3 px-4 text-center">
                          <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 font-mono">
                            {row.standard_pass_rate}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Section 6: มีงานทำ & ศึกษาต่อ -->
            <div id={`sec-employment-${item.id}`} class="sec-panel hidden">
              <div class="mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
                <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                  ข้อมูลการมีงานทำและการศึกษาต่อของผู้สำเร็จการศึกษา
                </h3>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                  สำรวจภาวะการมีงานทำ การศึกษาต่อในระดับปริญญาตรี และการประกอบอาชีพอิสระ
                </p>
              </div>

              <!-- Employment Distribution Visualization -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <!-- Visual Bars -->
                <div class="bg-slate-50 dark:bg-slate-800/60 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 flex flex-col justify-center">
                  <div class="flex items-center justify-between mb-4">
                    <span class="text-sm font-bold text-slate-800 dark:text-slate-200">สัดส่วนภาวะการมีงานทำและการศึกษาต่อ</span>
                    <span class="text-xs font-extrabold px-2.5 py-1 bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 rounded-full">
                      รวมความสำเร็จ {item.employment.totalRate}%
                    </span>
                  </div>

                  <div class="space-y-3">
                    <div>
                      <div class="flex justify-between text-xs font-semibold mb-1">
                        <span class="text-slate-700 dark:text-slate-300">ได้งานทำตรงสาขาวิชา</span>
                        <span class="text-[#0047BA] dark:text-blue-400">{item.employment.fieldRate}%</span>
                      </div>
                      <div class="h-2.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                        <div class="h-full bg-[#0047BA]" style={`width: ${item.employment.fieldRate}%`}></div>
                      </div>
                    </div>

                    <div>
                      <div class="flex justify-between text-xs font-semibold mb-1">
                        <span class="text-slate-700 dark:text-slate-300">ศึกษาต่อระดับปริญญาตรี</span>
                        <span class="text-indigo-600 dark:text-indigo-400">{item.employment.higherEdRate}%</span>
                      </div>
                      <div class="h-2.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                        <div class="h-full bg-indigo-500" style={`width: ${item.employment.higherEdRate}%`}></div>
                      </div>
                    </div>

                    <div>
                      <div class="flex justify-between text-xs font-semibold mb-1">
                        <span class="text-slate-700 dark:text-slate-300">ได้งานทำต่างสาขาวิชา</span>
                        <span class="text-teal-600 dark:text-teal-400">{item.employment.otherRate}%</span>
                      </div>
                      <div class="h-2.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                        <div class="h-full bg-teal-500" style={`width: ${item.employment.otherRate}%`}></div>
                      </div>
                    </div>

                    <div>
                      <div class="flex justify-between text-xs font-semibold mb-1">
                        <span class="text-slate-700 dark:text-slate-300">ประกอบอาชีพอิสระ / ธุรกิจส่วนตัว</span>
                        <span class="text-amber-600 dark:text-amber-400">{item.employment.freelanceRate}%</span>
                      </div>
                      <div class="h-2.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                        <div class="h-full bg-amber-500" style={`width: ${item.employment.freelanceRate}%`}></div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Summary Highlight Box -->
                <div class="bg-gradient-to-br from-blue-900 to-slate-900 text-white p-6 rounded-2xl relative overflow-hidden flex flex-col justify-between">
                  <div>
                    <div class="text-xs uppercase tracking-wider text-blue-300 font-semibold">Employability Excellence</div>
                    <h4 class="text-xl font-bold mt-1 text-white">ตลาดแรงงาน EEC ต้องการกำลังคนวิชาชีพ</h4>
                    <p class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
                      ผู้สำเร็จการศึกษาจากวิทยาลัยเทคโนโลยีศรีราชาได้รับการตอบรับเข้าทำงานในโรงงานอุตสาหกรรมชั้นนำในเขตพัฒนาพิเศษภาคตะวันออก (EEC) และนิคมอุตสาหกรรมแหลมฉบังอย่างต่อเนื่อง
                    </p>
                  </div>
                  <div class="pt-4 border-t border-white/10 mt-4 flex items-center justify-between text-xs">
                    <span class="text-slate-300">ฐานเงินเดือนเฉลี่ยเริ่มต้น:</span>
                    <strong class="text-amber-400 text-sm font-bold">16,500 – 24,000 บาท/เดือน</strong>
                  </div>
                </div>
              </div>

              <!-- Employment Table -->
              <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                <table class="w-full text-left border-collapse text-xs sm:text-sm">
                  <thead>
                    <tr class="bg-slate-50 dark:bg-slate-800/80 border-b border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 font-bold">
                      <th class="py-3 px-4 w-12 text-center">ลำดับ</th>
                      <th class="py-3 px-4">สถานะการมีงานทำและการศึกษาต่อ</th>
                      <th class="py-3 px-4 w-32 text-right">จำนวน (คน)</th>
                      <th class="py-3 px-4 w-32 text-right">ร้อยละ (%)</th>
                      <th class="py-3 px-4 w-48 text-right">ฐานเงินเดือนเฉลี่ย (บาท)</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-mono">
                    {item.employment.data.map((row, idx) => (
                      <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                        <td class="py-3 px-4 text-center text-slate-400 font-sans">{idx + 1}</td>
                        <td class="py-3 px-4 font-bold text-slate-800 dark:text-slate-200 font-sans">{row.category}</td>
                        <td class="py-3 px-4 text-right text-slate-600 dark:text-slate-400">{row.count.toLocaleString()}</td>
                        <td class="py-3 px-4 text-right font-bold text-[#0047BA] dark:text-blue-400">{row.percent}</td>
                        <td class="py-3 px-4 text-right text-slate-600 dark:text-slate-400">{row.avg_salary}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Section 7: สถานประกอบการคู่ความร่วมมือ -->
            <div id={`sec-partners-${item.id}`} class="sec-panel hidden">
              <div class="mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
                <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                  ข้อมูลสถานประกอบการคู่ความร่วมมือและการฝึกอาชีพ
                </h3>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                  เครือข่ายความร่วมมือในการจัดการอาชีวศึกษาระบบทวิภาคี (Dual Vocational Education: DVE) และการฝึกประสบการณ์วิชาชีพ
                </p>
              </div>

              <!-- Partner Stat Summary Cards -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
                <div class="bg-slate-50 dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
                  <div class="text-xs text-slate-500 dark:text-slate-400">ลงนามบันทึกความร่วมมือ (MOU)</div>
                  <div class="text-2xl font-black text-[#0047BA] dark:text-blue-400 mt-1">{item.partners.mouCount} แห่ง</div>
                </div>
                <div class="bg-slate-50 dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
                  <div class="text-xs text-slate-500 dark:text-slate-400">สถานประกอบการทวิภาคี</div>
                  <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">{item.partners.dualVocationalCount} แห่ง</div>
                </div>
                <div class="bg-slate-50 dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
                  <div class="text-xs text-slate-500 dark:text-slate-400">นักศึกษาฝึกอาชีพ</div>
                  <div class="text-2xl font-black text-purple-600 dark:text-purple-400 mt-1">{item.partners.internStudentsCount} คน</div>
                </div>
                <div class="bg-slate-50 dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700">
                  <div class="text-xs text-slate-500 dark:text-slate-400">เบี้ยเลี้ยงฝึกอาชีพเฉลี่ย</div>
                  <div class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-1">{item.partners.internAllowanceAvg.toLocaleString()} บ./ด.</div>
                </div>
              </div>

              <!-- Partner Enterprises Grid -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {item.partners.enterprises.map((p, pIdx) => (
                  <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 hover:border-blue-400 dark:hover:border-blue-500 transition-colors">
                    <div class="flex items-start justify-between gap-2">
                      <div class="font-bold text-slate-900 dark:text-white text-sm">
                        {p.name}
                      </div>
                      <span class="inline-block px-2 py-0.5 rounded-full text-[11px] font-bold bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300 whitespace-nowrap">
                        {p.industry}
                      </span>
                    </div>
                    <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
                      <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 font-medium border border-emerald-200 dark:border-emerald-800">
                        {p.cooperation_type}
                      </span>
                      <span class="text-slate-500 dark:text-slate-400">
                        สาขาวิชา: <strong class="text-slate-700 dark:text-slate-300">{p.departments}</strong>
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

          </div>
        </div>
      </div>
    ))}

    <!-- Empty State Fallback -->
    {allMisItems.length === 0 && (
      <div class="py-16 text-center bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
        <p class="text-slate-500 dark:text-slate-400">อยู่ระหว่างการจัดเตรียมข้อมูลสารสนเทศทางการศึกษา</p>
      </div>
    )}

  </div>

  <!-- Interactive Script for Year and Section Tabs -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      // Academic Year Tabs switcher
      var yearButtons = document.querySelectorAll('#year-selector-tabs button');
      var yearPanels = document.querySelectorAll('.mis-year-panel');

      yearButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var targetId = btn.getAttribute('data-target-id');

          // Highlight active year button
          yearButtons.forEach(function (b) {
            b.classList.remove('bg-[#0047BA]', 'text-white', 'shadow-xs');
            b.classList.add('text-slate-600', 'dark:text-slate-300');
          });
          btn.classList.add('bg-[#0047BA]', 'text-white', 'shadow-xs');
          btn.classList.remove('text-slate-600', 'dark:text-slate-300');

          // Show targeted year panel
          yearPanels.forEach(function (panel) {
            if (panel.id === targetId) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });
        });
      });

      // Section Navigation Tabs inside each year panel
      var allSecNavs = document.querySelectorAll('[id^="sec-nav-"]');
      allSecNavs.forEach(function (navContainer) {
        var buttons = navContainer.querySelectorAll('.sec-tab-btn');
        var parentCard = navContainer.closest('.bg-white');

        buttons.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var secTargetId = btn.getAttribute('data-sec-target');

            // Button styling
            buttons.forEach(function (b) {
              b.classList.remove('bg-[#0047BA]', 'text-white', 'shadow-xs');
              b.classList.add('text-slate-600', 'dark:text-slate-400');
            });
            btn.classList.add('bg-[#0047BA]', 'text-white', 'shadow-xs');
            btn.classList.remove('text-slate-600', 'dark:text-slate-400');

            // Show selected section panel
            if (parentCard) {
              var panels = parentCard.querySelectorAll('.sec-panel');
              panels.forEach(function (p) {
                if (p.id === secTargetId) {
                  p.classList.remove('hidden');
                } else {
                  p.classList.add('hidden');
                }
              });
            }
          });
        });
      });
    });
  </script>
</BaseLayout>
