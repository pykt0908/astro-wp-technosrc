---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEducationMisList, getEducationMisYears } from '../../lib/wordpress';
import type { EducationMisItem, EducationMisYear } from '../../lib/wordpress';

// Fetch all available academic years and items
const yearsList: EducationMisYear[] = await getEducationMisYears();
const allMisItems: EducationMisItem[] = await getEducationMisList({ year: 'all' });

// Default to the latest year (or first available)
const currentItem: EducationMisItem | undefined = allMisItems.length > 0 ? allMisItems[0] : undefined;

const tocItems = [
  { id: 'sec-students', no: '01', title: 'จำนวนนักเรียน–นักศึกษา' },
  { id: 'sec-personnel', no: '02', title: 'ผู้บริหาร ครู และบุคลากร' },
  { id: 'sec-curriculum', no: '03', title: 'หลักสูตรและสาขาวิชาที่เปิดสอน' },
  { id: 'sec-admissions', no: '04', title: 'สถิติรับเข้าและสำเร็จการศึกษา' },
  { id: 'sec-achievements', no: '05', title: 'ผลสัมฤทธิ์และมาตรฐานวิชาชีพ' },
  { id: 'sec-employment', no: '06', title: 'การมีงานทำและการศึกษาต่อ' },
  { id: 'sec-partners', no: '07', title: 'สถานประกอบการคู่ความร่วมมือ' },
];
---

<BaseLayout
  title="สารสนเทศทางการศึกษา - วิทยาลัยเทคโนโลยีศรีราชา"
  description="ข้อมูลสารสนเทศทางการศึกษา วิทยาลัยเทคโนโลยีศรีราชา สถิติจำนวนนักเรียนนักศึกษา บุคลากร หลักสูตร ผลสัมฤทธิ์ทางการเรียน V-NET การมีงานทำ และสถานประกอบการความร่วมมือ"
>
  <div class="py-8 sm:py-12 lg:py-16 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">หน้าแรก</a>
      <span>/</span>
      <a href="/about/" class="hover:text-[#0047BA] dark:hover:text-blue-400 transition-colors">เกี่ยวกับเรา</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold" aria-current="page">สารสนเทศทางการศึกษา</span>
    </nav>

    <!-- Header Section with Year Selector & PDF Button -->
    <div class="mb-10 pb-6 border-b border-slate-200 dark:border-slate-800 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div>
        <span class="text-xs font-semibold tracking-wider text-[#0047BA] dark:text-blue-400 uppercase">
          Educational Management Information System
        </span>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-1">
          สารสนเทศทางการศึกษา
        </h1>
        <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2 max-w-2xl leading-relaxed">
          สรุปรายงานและข้อมูลสถิติตามมาตรฐานการจัดการอาชีวศึกษา 7 ด้าน วิทยาลัยเทคโนโลยีศรีราชา เพื่อการประกันคุณภาพการศึกษาและการบริหารจัดการอย่างมีประสิทธิภาพ
        </p>
      </div>

      <!-- Year Selector & PDF Download -->
      <div class="flex flex-wrap items-center gap-3">
        {yearsList.length > 0 && (
          <div class="flex items-center gap-1 p-1 bg-slate-100 dark:bg-slate-800/80 rounded-xl border border-slate-200 dark:border-slate-700 text-xs sm:text-sm" id="year-selector-tabs">
            {allMisItems.map((item, idx) => (
              <button
                type="button"
                class={`px-3.5 py-1.5 rounded-lg font-semibold transition-all ${
                  idx === 0
                    ? 'bg-[#0047BA] text-white shadow-xs'
                    : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white'
                }`}
                data-year-slug={item.academicYear.slug}
                data-target-id={`mis-item-${item.id}`}
              >
                {item.academicYear.name || `ปีการศึกษา ${item.academicYear.slug}`}
              </button>
            ))}
          </div>
        )}

        {currentItem?.pdfUrl && (
          <a
            href={currentItem.pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 rounded-xl transition-colors shadow-xs"
            id="btn-download-pdf"
          >
            <svg class="w-4 h-4 text-red-500" viewBox="0 0 24 24" fill="currentColor">
              <path d="M5.625 1.5c-1.036 0-1.875.84-1.875 1.875v17.25c0 1.035.84 1.875 1.875 1.875h12.75c1.035 0 1.875-.84 1.875-1.875V12.75A3.75 3.75 0 0016.5 9h-1.875a1.875 1.875 0 01-1.875-1.875V5.25A3.75 3.75 0 009 1.5H5.625z" />
              <path d="M12.971 1.816A5.23 5.23 0 0114.25 5.25v1.875c0 .207.168.375.375.375H16.5a5.23 5.23 0 013.434 1.279 9.768 9.768 0 00-6.963-6.963z" />
            </svg>
            <span>รายงานฉบับสมบูรณ์ (PDF)</span>
          </a>
        )}
      </div>
    </div>

    <!-- Main Content Layout with Sticky Table of Contents -->
    <div class="flex flex-col md:flex-row gap-8 items-start relative">
      
      <!-- Sticky Table of Contents (TOC) Sidebar -->
      <aside
        class="w-full md:w-64 lg:w-72 xl:w-80 shrink-0 sticky top-24 z-30 self-start"
        style="position: sticky; top: 96px;"
      >
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 shadow-xs max-h-[calc(100vh-7.5rem)] overflow-y-auto">
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100 dark:border-slate-800">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">สารบัญเนื้อหา</span>
            <span class="text-[11px] font-semibold text-[#0047BA] dark:text-blue-400">7 ด้านสำคัญ</span>
          </div>
          <nav class="space-y-1" id="toc-nav">
            {tocItems.map((toc) => (
              <a
                href={`#${toc.id}`}
                class="toc-link group flex items-start gap-3 px-3 py-2.5 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-[#0047BA] dark:hover:text-blue-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-all border-l-2 border-transparent"
                data-section={toc.id}
              >
                <span class="font-mono text-[11px] text-slate-400 group-hover:text-[#0047BA] dark:group-hover:text-blue-400 transition-colors pt-0.5">
                  {toc.no}
                </span>
                <span class="leading-relaxed">{toc.title}</span>
              </a>
            ))}
          </nav>

          <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800">
            <div class="text-[11px] text-slate-400 leading-relaxed">
              คลิกเพื่อเลื่อนไปยังหัวข้อที่ต้องการ หรือเลื่อนหน้าจอเพื่อดูเนื้อหาทั้งหมดอย่างต่อเนื่อง
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Content Panels (Flowing All 7 Sections) -->
      <main class="flex-1 min-w-0">

        {allMisItems.map((item, itemIdx) => (
          <div
            id={`mis-item-${item.id}`}
            class={`mis-year-panel ${itemIdx === 0 ? '' : 'hidden'}`}
            data-year-slug={item.academicYear.slug}
          >
            <!-- KPI Executive Metrics (Modern Clean Cards) -->
            <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-3 sm:gap-4 mb-10">
              <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-slate-800 shadow-xs">
                <span class="text-xs text-slate-500 dark:text-slate-400 block font-medium">นักเรียน–นักศึกษา</span>
                <span class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1 block">
                  {item.overview.totalStudents.toLocaleString()}
                </span>
                <span class="text-[11px] text-slate-400 mt-1 block">
                  ปวช. {item.students.pvchTotal} / ปวส. {item.students.pvsTotal}
                </span>
              </div>

              <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-slate-800 shadow-xs">
                <span class="text-xs text-slate-500 dark:text-slate-400 block font-medium">บุคลากรทั้งหมด</span>
                <span class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1 block">
                  {item.overview.totalPersonnel}
                </span>
                <span class="text-[11px] text-slate-400 mt-1 block">
                  ครูผู้สอน {item.personnel.teachers} คน
                </span>
              </div>

              <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-slate-800 shadow-xs">
                <span class="text-xs text-slate-500 dark:text-slate-400 block font-medium">สาขาวิชาที่เปิดสอน</span>
                <span class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1 block">
                  {item.curriculum.departmentsCount}
                </span>
                <span class="text-[11px] text-slate-400 mt-1 block">
                  {item.curriculum.programsCount} สาขางาน
                </span>
              </div>

              <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-slate-800 shadow-xs">
                <span class="text-xs text-slate-500 dark:text-slate-400 block font-medium">มีงานทำ/ศึกษาต่อ</span>
                <span class="text-2xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1 block">
                  {item.overview.employmentRate}%
                </span>
                <span class="text-[11px] text-slate-400 mt-1 block">
                  ตรงสาขา {item.employment.fieldRate}%
                </span>
              </div>

              <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-slate-800 shadow-xs">
                <span class="text-xs text-slate-500 dark:text-slate-400 block font-medium">มาตรฐานวิชาชีพ</span>
                <span class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1 block">
                  {item.achievements.vocationalStandardPassRate}%
                </span>
                <span class="text-[11px] text-slate-400 mt-1 block">
                  GPAX รวม {item.overview.avgGpax}
                </span>
              </div>

              <div class="bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200 dark:border-slate-800 shadow-xs">
                <span class="text-xs text-slate-500 dark:text-slate-400 block font-medium">ความร่วมมือ MOU</span>
                <span class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1 block">
                  {item.overview.partnerCount}
                </span>
                <span class="text-[11px] text-slate-400 mt-1 block">
                  ทวิภาคี {item.partners.dualVocationalCount} แห่ง
                </span>
              </div>
            </div>

            <!-- ALL 7 SECTIONS SEQUENTIALLY -->

            <!-- SECTION 1: จำนวนนักเรียน–นักศึกษา -->
            <section id="sec-students" class="mb-14 scroll-mt-28">
              <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-xs">
                
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-5 mb-6 border-b border-slate-100 dark:border-slate-800">
                  <div>
                    <span class="text-xs font-mono font-semibold text-[#0047BA] dark:text-blue-400 tracking-wider">01</span>
                    <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5">
                      จำนวนนักเรียน–นักศึกษา แยกตามระดับชั้นและสาขาวิชา
                    </h2>
                  </div>
                  <div class="text-xs text-slate-500 dark:text-slate-400">
                    รวมทั้งสิ้น <strong class="text-slate-900 dark:text-white font-mono font-bold text-sm">{item.students.total.toLocaleString()}</strong> คน
                  </div>
                </div>

                <!-- Modern Chart: Level Proportion & Horizontal Distribution Bar -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                  <!-- Level Donut Representation -->
                  <div class="bg-slate-50 dark:bg-slate-800/60 p-5 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 flex flex-col justify-between">
                    <span class="text-xs font-bold text-slate-600 dark:text-slate-300">สัดส่วนตามระดับการศึกษา</span>
                    
                    <div class="flex items-center justify-center my-4 relative">
                      <svg class="w-32 h-32 -rotate-90" viewBox="0 0 100 100">
                        <!-- Background Circle -->
                        <circle cx="50" cy="50" r="40" fill="transparent" stroke="currentColor" stroke-width="12" class="text-slate-200 dark:text-slate-700" />
                        <!-- PVS Segment -->
                        <circle
                          cx="50"
                          cy="50"
                          r="40"
                          fill="transparent"
                          stroke="#10b981"
                          stroke-width="12"
                          stroke-dasharray="251.2"
                          stroke-dashoffset="0"
                        />
                        <!-- PVCH Segment -->
                        <circle
                          cx="50"
                          cy="50"
                          r="40"
                          fill="transparent"
                          stroke="#0047BA"
                          stroke-width="12"
                          stroke-dasharray="251.2"
                          stroke-dashoffset={251.2 * (1 - item.students.pvchTotal / (item.students.total || 1))}
                        />
                      </svg>
                      <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                        <span class="text-xs text-slate-400">ระดับ</span>
                        <span class="text-sm font-bold text-slate-800 dark:text-white">ปวช./ปวส.</span>
                      </div>
                    </div>

                    <div class="space-y-1.5 text-xs">
                      <div class="flex justify-between items-center">
                        <span class="flex items-center gap-1.5 text-slate-600 dark:text-slate-400">
                          <span class="w-2.5 h-2.5 rounded-full bg-[#0047BA]"></span> ปวช.
                        </span>
                        <strong class="font-mono text-slate-800 dark:text-slate-200">
                          {item.students.pvchTotal.toLocaleString()} ({Math.round((item.students.pvchTotal / (item.students.total || 1)) * 100)}%)
                        </strong>
                      </div>
                      <div class="flex justify-between items-center">
                        <span class="flex items-center gap-1.5 text-slate-600 dark:text-slate-400">
                          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> ปวส.
                        </span>
                        <strong class="font-mono text-slate-800 dark:text-slate-200">
                          {item.students.pvsTotal.toLocaleString()} ({Math.round((item.students.pvsTotal / (item.students.total || 1)) * 100)}%)
                        </strong>
                      </div>
                    </div>
                  </div>

                  <!-- Department Comparison Visual Chart -->
                  <div class="md:col-span-2 bg-slate-50 dark:bg-slate-800/60 p-5 rounded-2xl border border-slate-200/80 dark:border-slate-700/60">
                    <div class="flex justify-between items-center mb-4">
                      <span class="text-xs font-bold text-slate-600 dark:text-slate-300">กราฟจำนวนนักศึกษาแต่ละสาขาวิชา (เรียงตามสัดส่วน)</span>
                      <div class="flex items-center gap-3 text-[11px] text-slate-500">
                        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded bg-blue-600"></span> ชาย</span>
                        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded bg-indigo-300"></span> หญิง</span>
                      </div>
                    </div>

                    <div class="space-y-2.5">
                      {item.students.byDepartment.slice(0, 6).map((row) => {
                        const pctOfTotal = (row.total / (item.students.total || 1)) * 100;
                        const malePctOfRow = row.total > 0 ? (row.male / row.total) * 100 : 0;
                        const femalePctOfRow = 100 - malePctOfRow;
                        return (
                          <div>
                            <div class="flex justify-between text-xs mb-1">
                              <span class="font-medium text-slate-700 dark:text-slate-300 truncate max-w-[220px]">
                                {row.level} {row.department}
                              </span>
                              <span class="font-mono text-slate-500 dark:text-slate-400">
                                {row.total} คน
                              </span>
                            </div>
                            <div class="h-2 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden flex">
                              <div class="bg-blue-600 h-full" style={`width: ${pctOfTotal * (malePctOfRow / 100) * 3}%`}></div>
                              <div class="bg-indigo-300 dark:bg-indigo-400 h-full" style={`width: ${pctOfTotal * (femalePctOfRow / 100) * 3}%`}></div>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </div>

                <!-- Detailed Table -->
                <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
                  <table class="w-full text-left border-collapse text-xs sm:text-sm">
                    <thead>
                      <tr class="bg-slate-50 dark:bg-slate-800/80 border-b border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 font-bold">
                        <th class="py-3 px-4 w-12 text-center">ลำดับ</th>
                        <th class="py-3 px-4 w-28">ระดับ</th>
                        <th class="py-3 px-4">สาขาวิชา</th>
                        <th class="py-3 px-4 w-28 text-right">ชาย (คน)</th>
                        <th class="py-3 px-4 w-28 text-right">หญิง (คน)</th>
                        <th class="py-3 px-4 w-32 text-right">รวม (คน)</th>
                        <th class="py-3 px-4 w-32 text-center">สัดส่วน ช/ญ</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
                      {item.students.byDepartment.map((row, idx) => {
                        const mPct = row.total > 0 ? Math.round((row.male / row.total) * 100) : 0;
                        return (
                          <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                            <td class="py-3 px-4 text-center text-slate-400">{idx + 1}</td>
                            <td class="py-3 px-4 font-medium text-slate-600 dark:text-slate-400">{row.level}</td>
                            <td class="py-3 px-4 font-semibold text-slate-800 dark:text-slate-200">{row.department}</td>
                            <td class="py-3 px-4 text-right font-mono text-slate-600 dark:text-slate-400">{row.male}</td>
                            <td class="py-3 px-4 text-right font-mono text-slate-600 dark:text-slate-400">{row.female}</td>
                            <td class="py-3 px-4 text-right font-mono font-bold text-slate-900 dark:text-white">{row.total}</td>
                            <td class="py-3 px-4 text-center font-mono text-xs text-slate-500">
                              {mPct}% / {100 - mPct}%
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                    <tfoot>
                      <tr class="bg-slate-100/80 dark:bg-slate-800 font-bold border-t border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white">
                        <td colspan="3" class="py-3 px-4 text-center">รวมยอดนักเรียน–นักศึกษาทั้งสิ้น</td>
                        <td class="py-3 px-4 text-right font-mono">
                          {item.students.byDepartment.reduce((acc, r) => acc + (r.male || 0), 0).toLocaleString()}
                        </td>
                        <td class="py-3 px-4 text-right font-mono">
                          {item.students.byDepartment.reduce((acc, r) => acc + (r.female || 0), 0).toLocaleString()}
                        </td>
                        <td class="py-3 px-4 text-right font-mono text-[#0047BA] dark:text-blue-400 font-extrabold">
                          {item.students.total.toLocaleString()}
                        </td>
                        <td class="py-3 px-4 text-center text-xs text-slate-500">คน</td>
                      </tr>
                    </tfoot>
                  </table>
                </div>

              </div>
            </section>

            <!-- SECTION 2: ผู้บริหาร ครู และบุคลากร -->
            <section id="sec-personnel" class="mb-14 scroll-mt-28">
              <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-xs">
                
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-5 mb-6 border-b border-slate-100 dark:border-slate-800">
                  <div>
                    <span class="text-xs font-mono font-semibold text-[#0047BA] dark:text-blue-400 tracking-wider">02</span>
                    <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5">
                      จำนวนผู้บริหาร ครู และบุคลากรทางการศึกษา
                    </h2>
                  </div>
                  <div class="text-xs text-slate-500 dark:text-slate-400">
