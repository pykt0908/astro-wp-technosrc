---
// src/pages/calendar/print.astro - Official Printable Academic Calendar & PDF Export
import {
  getCollegeEvents,
  getCollegeAcademicYears,
  getCollegeEventCategories,
} from "../../lib/wordpress";

// Month names in Thai
const THAI_MONTHS_FULL = [
  "มกราคม",
  "กุมภาพันธ์",
  "มีนาคม",
  "เมษายน",
  "พฤษภาคม",
  "มิถุนายน",
  "กรกฎาคม",
  "สิงหาคม",
  "กันยายน",
  "ตุลาคม",
  "พฤศจิกายน",
  "ธันวาคม",
];

const THAI_MONTHS_SHORT = [
  "ม.ค.",
  "ก.พ.",
  "มี.ค.",
  "เม.ย.",
  "พ.ค.",
  "มิ.ย.",
  "ก.ค.",
  "ส.ค.",
  "ก.ย.",
  "ต.ค.",
  "พ.ย.",
  "ธ.ค.",
];

function formatThaiDateFull(startDateStr: string, endDateStr?: string): string {
  if (!startDateStr) return "-";
  const sParts = startDateStr.split("-");
  const sYear = parseInt(sParts[0], 10) + 543;
  const sMonth = parseInt(sParts[1], 10) - 1;
  const sDay = parseInt(sParts[2], 10);

  if (endDateStr && endDateStr !== startDateStr) {
    const eParts = endDateStr.split("-");
    const eYear = parseInt(eParts[0], 10) + 543;
    const eMonth = parseInt(eParts[1], 10) - 1;
    const eDay = parseInt(eParts[2], 10);

    if (sMonth === eMonth && sYear === eYear) {
      return `${sDay} - ${eDay} ${THAI_MONTHS_FULL[sMonth]} ${sYear}`;
    } else {
      return `${sDay} ${THAI_MONTHS_SHORT[sMonth]} ${sYear} - ${eDay} ${THAI_MONTHS_SHORT[eMonth]} ${eYear}`;
    }
  }

  return `${sDay} ${THAI_MONTHS_FULL[sMonth]} ${sYear}`;
}

// Helper to sort academic year / semester terms naturally (e.g. 2/2569 > 1/2569 > 2/2568 > 1/2568 > 2569)
function compareAcademicTerms(a: string, b: string): number {
  const parseTerm = (str: string) => {
    if (str.includes("/")) {
      const parts = str.split("/");
      return {
        sem: parseInt(parts[0], 10) || 0,
        yr: parseInt(parts[1], 10) || 0,
      };
    }
    return { sem: 0, yr: parseInt(str, 10) || 0 };
  };
  const termA = parseTerm(a);
  const termB = parseTerm(b);
  if (termB.yr !== termA.yr) return termB.yr - termA.yr;
  return termB.sem - termA.sem;
}

// Helper to format academic term display label
function formatAcademicTermDisplay(term: string): string {
  if (!term) return "";
  if (term.includes("/")) {
    return `ภาคเรียนที่ ${term}`;
  }
  return `ปีการศึกษา ${term}`;
}

const COLOR_NAME_TO_HEX: Record<string, string> = {
  blue: "#0047BA",
  emerald: "#059669",
  green: "#059669",
  amber: "#d97706",
  orange: "#d97706",
  yellow: "#d97706",
  rose: "#e11d48",
  red: "#e11d48",
  purple: "#7c3aed",
};

function resolveColorHex(color?: string): string {
  if (!color) return "#0047BA";
  if (color.startsWith("#")) return color;
  return COLOR_NAME_TO_HEX[color] || "#0047BA";
}

function hexToSoftBg(hex: string): string {
  const clean = hex.replace("#", "");
  if (clean.length === 6) {
    const r = parseInt(clean.substring(0, 2), 16);
    const g = parseInt(clean.substring(2, 4), 16);
    const b = parseInt(clean.substring(4, 6), 16);
    return `rgba(${r}, ${g}, ${b}, 0.08)`;
  }
  return "rgba(0, 71, 186, 0.08)";
}

// Helper to get category color class for table row
function getEventColorClass(color?: string): string {
  switch (color) {
    case "emerald":
    case "green":
      return "row-cat-emerald";
    case "amber":
    case "yellow":
    case "orange":
      return "row-cat-amber";
    case "rose":
    case "red":
      return "row-cat-rose";
    case "purple":
      return "row-cat-purple";
    case "blue":
    default:
      return "row-cat-blue";
  }
}

const [allEvents, rawAcademicYears, allCategories] = await Promise.all([
  getCollegeEvents(),
  getCollegeAcademicYears(),
  getCollegeEventCategories(),
]);

// Build legend categories from system categories and events
const categoryMap = new Map<string, { name: string; color: string }>();

allCategories.forEach((cat) => {
  if (cat.name) {
    categoryMap.set(cat.slug || cat.name, {
      name: cat.name,
      color: cat.color || "#0047BA",
    });
  }
});

allEvents.forEach((ev) => {
  if (ev.categories && ev.categories.length > 0) {
    ev.categories.forEach((c) => {
      if (!categoryMap.has(c.slug || c.name)) {
        categoryMap.set(c.slug || c.name, {
          name: c.name,
          color: c.color || ev.color || "#0047BA",
        });
      }
    });
  }
});

const legendCategories = Array.from(categoryMap.values());

// Determine selected academic year from query param
const url = new URL(Astro.request.url);
const paramYear = url.searchParams.get("year");
const autoPrint =
  url.searchParams.get("auto") === "1" ||
  url.searchParams.get("auto") === "true";

// Available academic years
const availableAcademicYears = Array.from(
  new Set([
    ...rawAcademicYears,
    ...allEvents
      .map((e) => e.academicYear)
      .filter((y): y is string => Boolean(y)),
    "1/2569",
    "2/2569",
  ]),
).sort(compareAcademicTerms);

const todayDate = new Date();
const currentMonthNum = todayDate.getMonth() + 1;
const currentThaiYear = todayDate.getFullYear() + 543;
const autoDetectedTerm =
  currentMonthNum >= 5 && currentMonthNum <= 10
    ? `1/${currentThaiYear}`
    : `2/${currentThaiYear}`;

const defaultYear = availableAcademicYears.includes(autoDetectedTerm)
  ? autoDetectedTerm
  : availableAcademicYears[0] || "1/2569";

const selectedYear =
  paramYear && availableAcademicYears.includes(paramYear)
    ? paramYear
    : defaultYear;

// Filter events for the selected academic year and sort chronologically
const yearEvents = allEvents
  .filter((ev) => ev.academicYear === selectedYear)
  .sort((a, b) => (a.startDate || "").localeCompare(b.startDate || ""));
