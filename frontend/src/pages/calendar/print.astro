            stroke-linejoin="round"
            stroke-width="2"
            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
          ></path>
        </svg>
        <span>ปฏิทินการศึกษาทางการ • วิทยาลัยเทคโนโลยีศรีราชา</span>
      </div>

      <div class="web-control-actions">
        <!-- Academic Year Switcher -->
        <div class="year-select-wrap">
          <label for="web-year-switcher">ภาคเรียน / ปีการศึกษา:</label>
          <select id="web-year-switcher" class="year-select">
            {
              availableAcademicYears.map((yr) => (
                <option value={yr} selected={yr === selectedYear}>
                  {formatAcademicTermDisplay(yr)}
                </option>
              ))
            }
          </select>
        </div>

        <!-- Print / Save as PDF Button -->
        <button
          type="button"
          id="btn-print-trigger"
          class="btn-action btn-print"
        >
          <svg
            width="16"
            height="16"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"
            ></path>
          </svg>
          <span>พิมพ์ / บันทึกเป็น PDF</span>
        </button>

        <!-- Back to Homepage -->
        <a href="/#college-calendar-section" class="btn-action btn-back">
          <svg
            width="16"
            height="16"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>กลับหน้าหลัก</span>
        </a>
      </div>
    </header>

    <!-- Printable Document Sheet (Simulates Official College A4 Document) -->
    <main class="document-page-wrap">
      <!-- Letterhead -->
      <header class="doc-header">
        <div
          class="doc-logo-wrap"
          title="ตราสัญลักษณ์ วิทยาลัยเทคโนโลยีศรีราชา (Sriracha Technological College)"
        >
          <img
            src="/logo/LOGO_SERIRACHA_COLOR_FULL.png"
            alt="วิทยาลัยเทคโนโลยีศรีราชา"
            class="doc-logo-img"
            loading="eager"
          />
        </div>
        <div class="doc-header-text">
          <h1 class="doc-college-title">วิทยาลัยเทคโนโลยีศรีราชา</h1>
          <div class="doc-college-en">Sriracha Technological College</div>
          <div class="doc-calendar-title">
            ปฏิทินการศึกษาและกำหนดการกิจกรรม ประจำ{
              formatAcademicTermDisplay(selectedYear)
            }
          </div>
        </div>
      </header>

      <!-- Content Table -->
      {
        yearEvents.length > 0 ? (
          <>
            <table class="calendar-table">
              <thead class=" ">
                <tr>
                  <th class="col-no ">ที่</th>
                  <th class="col-date ">วันที่</th>
                  <th class="col-time ">เวลา</th>
                  <th class="col-title ">กิจกรรม</th>
                  <th class="col-note ">หมายเหตุ</th>
                </tr>
              </thead>
              <tbody>
                {yearEvents.map((ev, index) => {
                  const dateText = formatThaiDateFull(ev.startDate, ev.endDate);
                  const rawColor =
                    ev.color ||
                    (ev.categories && ev.categories[0]?.color) ||
                    "blue";
                  const rowHex = resolveColorHex(rawColor);
                  const rowBg = hexToSoftBg(rowHex);
                  const rowColorClass = getEventColorClass(rawColor);
                  return (
                    <tr
                      class={`has-category-color ${rowColorClass}`}
                      style={`--row-accent: ${rowHex}; --row-bg: ${rowBg};`}
                    >
                      <td class="col-no">{index + 1}</td>
                      <td class="col-date" style={`color: ${rowHex};`}>
                        {dateText}
                      </td>
                      <td class="col-time">{ev.time || "ตามกำหนดการ"}</td>
                      <td class="col-title">
                        {ev.title}
                        {ev.excerpt && (
                          <span class="event-excerpt">{ev.excerpt}</span>
                        )}
                      </td>
                      <td class="col-note">{ev.note || "-"}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>

            {legendCategories.length > 0 && (
              <div class="calendar-legend-bar">
                <span class="legend-title">หมายเหตุ:</span>
                <div class="legend-items">
                  {legendCategories.map((cat) => {
                    const hex = resolveColorHex(cat.color);
                    return (
                      <div class="legend-item">
                        <span
                          class="legend-dot"
                          style={`background-color: ${hex}; border-color: ${hex};`}
                        />
                        <span class="legend-name">{cat.name}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </>
        ) : (
          <div class="empty-notice">
            <p>
              ยังไม่มีข้อมูลกิจกรรมและกำหนดการสำหรับ
              {formatAcademicTermDisplay(selectedYear)}
            </p>
            <p style="font-size: 12px; margin-top: 6px; color: #94a3b8;">
              สามารถเพิ่มกิจกรรมใหม่ได้ผ่านระบบจัดการข้อมูล WordPress Admin
            </p>
          </div>
        )
      }
    </main>

    <script define:vars={{ autoPrint }}>
      // Trigger print dialog when clicking the print button
      const printBtn = document.getElementById("btn-print-trigger");
      if (printBtn) {
        printBtn.addEventListener("click", () => {
          window.print();
        });
      }

      // Switch academic year
      const yearSwitcher = document.getElementById("web-year-switcher");
      if (yearSwitcher) {
        yearSwitcher.addEventListener("change", (e) => {
          const val = e.target.value;
          const url = new URL(window.location.href);
          url.searchParams.set("year", val);
          url.searchParams.delete("auto");
          window.location.href = url.toString();
        });
      }

      // Auto-print support if requested via ?auto=1
      if (autoPrint) {
        window.addEventListener("load", () => {
          setTimeout(() => {
            window.print();
          }, 350);
        });
      }
    </script>
  </body>
</html>
