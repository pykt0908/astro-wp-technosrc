# -------------------------------------------------------------
# Frontend (Astro) Configuration
# -------------------------------------------------------------
PUBLIC_SITE_URL=http://localhost:4321
WP_API_BASE_URL=http://localhost:8080/wp-json/wp/v2

# -------------------------------------------------------------
# WordPress Local Development (Docker Compose)
# -------------------------------------------------------------
WP_LOCAL_PORT=8080
PMA_LOCAL_PORT=8081
DB_PORT=3306

# Database Credentials
DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=wp_password_secure
DB_ROOT_PASSWORD=root_password_secure

# -------------------------------------------------------------
# Webhook Relay & Build Trigger (WordPress -> GitHub Actions)
# -------------------------------------------------------------
# In WordPress Admin > Project Core Settings:
# Configure WEBHOOK_URL and WEBHOOK_SECRET (HMAC SHA-256)
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_DISPATCH_TOKEN=
WEBHOOK_SECRET=your_random_hmac_secret_here
